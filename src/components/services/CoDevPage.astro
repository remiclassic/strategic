---
import { codevCopy, type CodevLang } from '../../data/codev';
import { bench } from '../../data/services-team';
const { lang = 'en' } = Astro.props as { lang?: CodevLang };
const t = codevCopy[lang];
const people = bench.filter(member => member.name);
const br = (pair: string[]) => pair.join('<br>');
---
<section class="cd-hero">
  <div class="container">
    <div class="cd-top"><p class="eyebrow"><span class="live-dot"></span> {t.eyebrow}</p><a class="cd-lang" href={t.switchHref} hreflang={lang === 'en' ? 'fr' : 'en'} lang={lang === 'en' ? 'fr' : 'en'}>{t.switchLabel}</a></div>
    <h1>{t.h1[0]}<br><em>{t.h1[1]}</em></h1>
    <div class="cd-hero-row">
      <p class="lede">{t.lede}</p>
      <div class="hero-actions"><a class="button primary" href={t.contactHref}>{t.ctaPrimary} <span>↗</span></a><a class="button ghost" href="#stories">{t.ctaSecondary} <span>↓</span></a></div>
    </div>
    <dl class="cd-facts">{t.facts.map(([n, label]) => <div><dt>{n}</dt><dd>{label}</dd></div>)}</dl>
  </div>
  <figure class="cd-reel container"><video muted loop playsinline autoplay preload="metadata" poster="/media/services/reel-poster.jpg" aria-hidden="true"><source src="/media/services/reel.mp4" type="video/mp4"/></video></figure>
</section>

<section class="section container" id="ways"><div class="section-heading"><div><p class="eyebrow">{t.waysEyebrow}</p><h2 set:html={br(t.waysTitle)}/></div><p>{t.waysIntro}</p></div>
  <div class="cd-ways">{t.ways.map((way, i) => <article class="sv-reveal"><header><span>0{i + 1}</span><em>{way.tag}</em></header><h3>{way.title}</h3><p>{way.body}</p><ul>{way.points.map(point => <li>{point}</li>)}</ul></article>)}</div>
</section>

<section class="section container" id="responsibility"><div class="section-heading"><div><p class="eyebrow">{t.takeEyebrow}</p><h2 set:html={br(t.takeTitle)}/></div></div>
  <div class="cd-take">{t.take.map(([title, body]) => <article class="sv-reveal"><h3>{title}</h3><p>{body}</p></article>)}</div>
</section>

<section class="section container" id="stories"><div class="section-heading"><div><p class="eyebrow">{t.storiesEyebrow}</p><h2 set:html={br(t.storiesTitle)}/></div><p>{t.storiesIntro}</p></div>
  <div class="cd-stories">{t.stories.map(story => <article class:list={['cd-story', 'sv-reveal', !story.images.length && 'no-media']}>
    {story.images.length > 0 && <div class="cd-story-media"><img src={story.images[0]} alt={`${story.title}: ${story.studio}`} loading="lazy"/><div>{story.images.slice(1).map(src => <img src={src} alt="" loading="lazy"/>)}</div></div>}
    <div class="cd-story-copy">
      <p class="cd-story-meta"><strong>{story.studio}</strong><span>{story.years}</span><span>{story.engine}</span></p>
      <h3>{story.title}</h3>
      <p>{story.body}</p>
      <p class="cd-owned-label">{t.owned}</p>
      <ul class="cd-owned">{story.owned.map(item => <li>{item}</li>)}</ul>
      {story.quote && <blockquote lang="en"><p>“{story.quote.text}”</p><footer>{story.quote.name} · {story.quote.role}</footer></blockquote>}
    </div>
  </article>)}</div>
  <p class="cd-also">{t.alsoCodev}</p>
</section>

<section class="section container" id="plug-in"><div class="section-heading"><div><p class="eyebrow">{t.plugEyebrow}</p><h2 set:html={br(t.plugTitle)}/></div></div>
  <ol class="cd-plug">{t.plug.map(([title, body], i) => <li class="sv-reveal"><span>0{i + 1}</span><h3>{title}</h3><p>{body}</p></li>)}</ol>
</section>

<section class="section container" id="credentials"><div class="section-heading"><div><p class="eyebrow">{t.proofEyebrow}</p><h2 set:html={br(t.proofTitle)}/></div></div>
  <div class="cd-proof">{t.proof.map(([title, body, href, cta]) => <a class="sv-reveal" href={href} {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}><h3>{title}</h3><p>{body}</p><span>{cta}</span></a>)}</div>
</section>

<section class="section container" id="team"><div class="section-heading"><div><p class="eyebrow">{t.teamEyebrow}</p><h2 set:html={br(t.teamTitle)}/></div><p>{t.teamIntro}</p></div>
  <ul class="cd-team">{people.map(person => <li><img src={person.photo} alt="" width="72" height="72" loading="lazy"/><div><strong>{person.name}</strong><span>{person.role}</span></div></li>)}</ul>
</section>

<section class="cd-contact" id="contact"><div class="container">
  <div><p class="eyebrow">{t.contactEyebrow}</p><h2 set:html={br(t.contactTitle)}/><p>{t.contactIntro}</p><a class="button primary" href={t.contactHref}>{t.contactCta} <span>↗</span></a></div>
  <ul>{t.contacts.map(person => <li><img src={person.photo} alt="" width="80" height="80" loading="lazy"/><div><strong>{person.name}</strong><span>{person.role}</span><small>{person.note}</small></div></li>)}</ul>
</div></section>
<p class="container cd-foot">{t.footnote}</p>

<script>
  const io = new IntersectionObserver(entries => entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.add('is-in'); io.unobserve(entry.target); } }), { threshold: 0.12 });
  document.querySelectorAll('.cd-ways article, .cd-take article, .cd-story, .cd-plug li, .cd-proof a').forEach(el => io.observe(el));
  const reel = document.querySelector<HTMLVideoElement>('.cd-reel video');
  if (reel && matchMedia('(prefers-reduced-motion: reduce)').matches) { reel.pause(); reel.removeAttribute('autoplay'); }
</script>

<style is:global>
  .cd-hero{padding:56px 0 0;position:relative;overflow:hidden}
  .cd-top{display:flex;justify-content:space-between;align-items:center;gap:20px}
  .cd-lang{font:500 11px/1 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink);border:1px solid var(--line);border-radius:30px;padding:9px 14px;text-decoration:none}
  .cd-lang:hover{border-color:var(--accent);color:var(--accent)}
  .cd-hero h1{font:600 clamp(48px,8vw,118px)/.92 Manrope,sans-serif;letter-spacing:-.065em;color:var(--ink);margin:26px 0 30px}
  .cd-hero h1 em{font-style:normal;color:var(--accent)}
  .cd-hero-row{display:grid;grid-template-columns:minmax(0,1.2fr) auto;gap:40px;align-items:end}
  .cd-hero .lede{font-size:clamp(16px,1.4vw,19px);line-height:1.6;color:var(--ink);opacity:.86;max-width:60ch;margin:0}
  .cd-hero .hero-actions{display:flex;gap:10px;flex-wrap:wrap}
  .cd-facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:48px 0 0;border-top:1px solid var(--line)}
  .cd-facts div{padding:22px 20px 22px 0;display:grid;gap:6px}
  .cd-facts div+div{padding-left:20px;border-left:1px solid var(--line)}
  .cd-facts dt{font:600 clamp(28px,3vw,42px)/1 Manrope,sans-serif;letter-spacing:-.05em;color:var(--accent)}
  .cd-facts dd{margin:0;font-size:13.5px;color:var(--muted)}
  .cd-reel{margin-top:10px;margin-bottom:0}
  .cd-reel video{display:block;width:100%;aspect-ratio:21/9;object-fit:cover;border-radius:16px;border:1px solid var(--line)}
  .cd-ways{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .cd-ways article{border:1px solid var(--line);border-radius:16px;background:var(--surface);padding:28px;display:grid;gap:14px;align-content:start}
  .cd-ways header{display:flex;justify-content:space-between;align-items:center}
  .cd-ways header span{font:500 11px/1 var(--mono);color:var(--muted)}
  .cd-ways header em{font:500 10.5px/1 var(--mono);font-style:normal;letter-spacing:.1em;text-transform:uppercase;color:#0c1408;background:var(--accent);padding:6px 9px;border-radius:20px}
  .cd-ways h3{font:600 24px/1.15 Manrope,sans-serif;letter-spacing:-.035em;color:var(--ink);margin:0}
  .cd-ways p{color:var(--muted);line-height:1.6;margin:0}
  .cd-ways ul{list-style:none;padding:0;margin:4px 0 0;display:grid;gap:8px;border-top:1px solid var(--line);padding-top:16px}
  .cd-ways li{font-size:14px;color:var(--ink);padding-left:20px;position:relative}
  .cd-ways li::before{content:'✳';position:absolute;left:0;color:var(--accent);font-size:11px;top:2px}
  .cd-take{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line)}
  .cd-take article{padding:28px 28px 30px 0;border-bottom:1px solid var(--line)}
  .cd-take article:not(:nth-child(3n+1)){padding-left:28px;border-left:1px solid var(--line)}
  .cd-take h3{font:600 19px/1.25 Manrope,sans-serif;color:var(--ink);margin:0 0 10px;letter-spacing:-.02em}
  .cd-take p{color:var(--muted);line-height:1.6;margin:0;font-size:14.5px}
  .cd-stories{display:grid;gap:22px}
  .cd-story{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:34px;border:1px solid var(--line);border-radius:18px;background:var(--surface);padding:24px;align-items:center}
  .cd-story.no-media{grid-template-columns:1fr;padding:34px}
  .cd-story-media{display:grid;gap:10px}
  .cd-story-media img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:10px;border:1px solid var(--line);display:block}
  .cd-story-media div{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .cd-story-meta{display:flex;flex-wrap:wrap;gap:8px 14px;font:500 11px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:0 0 14px}
  .cd-story-meta strong{color:var(--accent);font-weight:500}
  .cd-story h3{font:600 clamp(26px,2.6vw,36px)/1.05 Manrope,sans-serif;letter-spacing:-.045em;color:var(--ink);margin:0 0 14px}
  .cd-story-copy>p{color:var(--ink);opacity:.86;line-height:1.65;margin:0}
  .cd-owned-label{font:500 10.5px/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);opacity:1!important;margin:20px 0 10px!important}
  .cd-owned{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:6px}
  .cd-owned li{font-size:13px;color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:7px 10px}
  .cd-story blockquote{margin:22px 0 0;padding:18px 0 0;border-top:1px solid var(--line)}
  .cd-story blockquote p{font:500 16px/1.55 Manrope,sans-serif;color:var(--ink);margin:0}
  .cd-story blockquote footer{font:400 12px/1.4 var(--mono);color:var(--muted);margin-top:10px}
  .cd-also{margin:22px 0 0;color:var(--muted);max-width:80ch;line-height:1.65}
  .cd-plug{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;counter-reset:none}
  .cd-plug li{border-top:2px solid var(--accent);padding-top:18px}
  .cd-plug span{font:500 11px/1 var(--mono);color:var(--muted)}
  .cd-plug h3{font:600 19px/1.25 Manrope,sans-serif;color:var(--ink);margin:10px 0}
  .cd-plug p{color:var(--muted);line-height:1.6;margin:0;font-size:14.5px}
  .cd-proof{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .cd-proof a{border:1px solid var(--line);border-radius:16px;padding:26px;background:var(--surface);text-decoration:none;display:grid;gap:10px;align-content:start;transition:border-color .2s,transform .2s}
  .cd-proof a:hover{border-color:var(--accent);transform:translateY(-3px)}
  .cd-proof h3{font:600 22px/1.1 Manrope,sans-serif;color:var(--ink);margin:0;letter-spacing:-.03em}
  .cd-proof p{color:var(--muted);line-height:1.6;margin:0}
  .cd-proof span{color:var(--accent);font-weight:600;font-size:14px;margin-top:6px}
  .cd-team{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
  .cd-team li{display:flex;gap:16px;align-items:center;border:1px solid var(--line);border-radius:14px;padding:16px;background:var(--surface)}
  .cd-team img{width:56px;height:56px;border-radius:50%;object-fit:cover;flex:none;box-shadow:0 0 0 2px color-mix(in srgb,var(--accent) 55%,transparent)}
  .cd-team div{display:grid;gap:3px;min-width:0}
  .cd-team strong{font:600 15px/1.25 Manrope,sans-serif;color:var(--ink)}
  .cd-team span{font-size:13px;color:var(--muted)}
  .cd-contact{margin-top:90px;background:var(--surface);border-block:1px solid var(--line);padding:70px 0}
  .cd-contact .container{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:50px;align-items:center}
  .cd-contact h2{font:600 clamp(32px,4vw,56px)/1 Manrope,sans-serif;letter-spacing:-.055em;color:var(--ink);margin:12px 0 18px}
  .cd-contact p:not(.eyebrow){color:var(--muted);line-height:1.65;max-width:52ch;margin:0 0 26px}
  .cd-contact ul{list-style:none;padding:0;margin:0;display:grid;gap:14px}
  .cd-contact li{display:flex;gap:18px;align-items:center;border:1px solid var(--line);border-radius:16px;padding:18px;background:var(--paper)}
  .cd-contact img{width:72px;height:72px;border-radius:50%;object-fit:cover;flex:none}
  .cd-contact li div{display:grid;gap:4px}
  .cd-contact strong{font:600 17px/1.2 Manrope,sans-serif;color:var(--ink)}
  .cd-contact span{font-size:14px;color:var(--accent)}
  .cd-contact small{font-size:13px;color:var(--muted)}
  .cd-foot{font:400 11px/1.6 var(--mono);color:var(--muted);margin-top:22px;margin-bottom:40px}
  .cd-ways article,.cd-take article,.cd-story,.cd-plug li,.cd-proof a{opacity:1}
  @media(max-width:980px){.cd-hero-row{grid-template-columns:1fr}.cd-ways,.cd-proof{grid-template-columns:1fr}.cd-take{grid-template-columns:1fr 1fr}.cd-take article{padding:22px 18px 24px 0!important;border-left:0!important}.cd-take article:nth-child(even){padding-left:18px!important;border-left:1px solid var(--line)!important}.cd-story{grid-template-columns:1fr}.cd-plug{grid-template-columns:1fr 1fr}.cd-team{grid-template-columns:1fr 1fr}.cd-contact .container{grid-template-columns:1fr}}
  @media(max-width:600px){.cd-facts{grid-template-columns:1fr 1fr}.cd-facts div:nth-child(3){padding-left:0;border-left:0}.cd-facts div{border-top:1px solid var(--line)}.cd-take,.cd-plug,.cd-team{grid-template-columns:1fr}.cd-take article{padding-left:0!important;border-left:0!important}.cd-reel video{aspect-ratio:16/10}}
</style>
