---
const packs = [
  { slug: 'modern-essentials', name: 'Modern Essentials', theme: 'modern', label: 'First planned release', screen: 'PAUSE / SETTINGS', action: 'Resume game', description: 'Explore 24 mockups covering menus, gameplay, inventory, maps, settings, and the details between.', scope: 'Planned: reusable controls, interaction states, menu layouts, and a documented keyboard / controller navigation flow.' },
  { slug: 'fantasy-adventurer', name: 'Fantasy Adventurer', theme: 'fantasy', label: 'Collection concept', screen: 'INVENTORY / EQUIPMENT', action: 'Equip item', description: 'A cohesive direction for inventories, equipment, quest logs, and player HUDs.', scope: 'Proposed expansion: item slots, tooltips, rarity treatments, quest states, and matching health and resource bars.' },
  { slug: 'orbital-command', name: 'Orbital Command', theme: 'orbital', label: 'Collection concept', screen: 'MISSION / SHIP STATUS', action: 'Track mission', description: 'Explore 29 mockups covering missions, ship systems, crew, navigation, tactical HUDs, and supporting controls.', scope: 'Proposed expansion: mission cards, telemetry panels, objective markers, and matching alerts and status indicators.' },
  { slug: 'duskbound-raiders', name: 'Duskbound Raiders', theme: 'dusk', label: 'Mobile collection concept', screen: 'MOBILE ACTION RPG', action: 'Enter the dungeon', description: '24 previews of chunky low-poly dark fantasy: touch combat, heroes, loot, bosses, and camp progression.', scope: 'Portrait mobile layouts, bold 3D controls, gear upgrades, and touch interaction states.' },
  { slug: 'neon-breach', name: 'Neon Breach', theme: 'neon', label: 'Tactical shooter collection concept', screen: 'TACTICAL SCI-FI / SHOOTER HUDS', action: 'Deploy squad', description: '24 chunky low-poly sci-fi previews: cyberpunk combat HUDs, operatives, loadouts, squad deployment, and tactical feedback.', scope: 'First-person, third-person, and mobile HUDs with matching menus, components, and input prompts.' },
  { slug: 'havenworks', name: 'Havenworks', theme: 'haven', label: 'Strategy & simulation collection concept', screen: 'BUILD / MANAGE / GROW', action: 'Plan your settlement', description: '24 chunky low-poly previews for strategy and simulation: building, production, logistics, citizens, budgets, and research.', scope: 'Settlement HUDs, management dashboards, map overlays, component states, and camera controls.' },
  { slug: 'ashfall-outpost', name: 'Ashfall Outpost', theme: 'ash', label: 'Survival wasteland collection concept', screen: 'SCAVENGE / CRAFT / SURVIVE', action: 'Explore the outpost', description: '24 chunky low-poly wasteland previews: rusted panels, weighted inventories, survival vitals, crafting queues, and shelter systems.', scope: 'Radial and bar survival gauges, durability, recipe trees, material checklists, and matching interface states.' },
  { slug: 'clover-and-clay', name: 'Clover & Clay', theme: 'cozy', label: 'Cozy farm & town collection concept', screen: 'GROW / CONNECT / MAKE A HOME', action: 'Explore the village', description: '24 warm, rounded low-poly previews for cozy farming and town games: friendly dialogue, seasonal calendars, shops, crops, animals, and home decorating.', scope: 'Wood and clay panels, emotion badges, buy and sell flows, seasonal widgets, and matching controls.' },
  { slug: 'fieldline', name: 'Fieldline', theme: 'military', label: 'Modern military collection concept', screen: 'LOADOUT / MAP / SQUAD', action: 'Explore Fieldline', description: '24 grounded military interface previews: restrained combat HUDs, weapon attachments, armor plates, tactical maps, and squad status.', scope: 'Olive, tan, and charcoal layouts with heading tapes, loadout presets, extraction flows, and matching controls.' },
  { slug: 'brass-and-tide', name: 'Brass & Tide', theme: 'pirate', label: 'Pirate & high seas collection concept', screen: 'SAIL / CHART / CREW', action: 'Explore the high seas', description: '24 nautical low-poly previews: ship HUDs, treasure charts, bounty logs, shipyard upgrades, crew management, and port trading.', scope: 'Parchment, brass, rope, and wood interfaces with sailing instruments, map states, and matching controls.' },
];
---
<section class="section container ui-packs" id="game-ui-packs" aria-labelledby="ui-packs-title">
  <div class="section-heading"><div><p class="eyebrow">GAME UI PACKS / COMING NEXT</p><h2 id="ui-packs-title">Give your game<br/>a language of its own.</h2></div><p>Original interface packs from Strategic Sloth.<br/>Thoughtful screens. Consistent components.<br/>The small details that make play feel right.</p></div>
  <p class="collection-note">A new collection in planning. These are visual direction studies; packs are not available to purchase yet.</p>
  <div class="pack-grid">
    {packs.map(pack => <article class={`pack-card ${pack.theme}`}>
      <a class="fantasy-cover" href={`/game-ui/${pack.slug}/`} aria-label={`Explore ${pack.name}`}><img src={`/images/game-ui/${pack.slug}/01-collection.webp`} alt={`${pack.name} collection overview with matching game screens and controls`} width="1536" height="1024" loading="lazy"/><span>COLLECTION MOCKUPS · EXPLORE PACK ↗</span></a>
      <div class="pack-copy"><span class="pack-status">{pack.label}</span><h3><a href={`/game-ui/${pack.slug}/`}>{pack.name}</a></h3><p>{pack.description}</p><a class="text-link" style="margin-top:20px" href={`/game-ui/${pack.slug}/`}>Explore pack details <span aria-hidden="true">→</span></a></div>
    </article>)}
  </div>
  <div class="pack-bridge"><div><p class="eyebrow">MEET THE TOOL BEHIND THE WORKFLOW</p><h3>Have a direction already? Meet SliceForge.</h3><p>Arrange editable screens, refine component states, and export assets and layout data for your game’s implementation.</p></div><a class="button" href="https://www.sliceforge.io/?utm_source=strategicsloth&utm_medium=referral&utm_campaign=game_ui_packs" target="_blank" rel="noopener">Explore SliceForge <span aria-hidden="true">↗</span></a></div>
  <a class="text-link pack-contact" href="/contact/">Tell us what your game needs <span aria-hidden="true">→</span></a>
</section>
<style>
.fantasy-cover{display:flex;flex-direction:column;justify-content:center;position:relative;background:#183324;aspect-ratio:3/2;overflow:hidden}.fantasy-cover img{width:100%;height:100%;object-fit:contain}.fantasy-cover>span{position:absolute;bottom:12px;left:12px;background:#11251de8;color:#f7edd9;padding:6px 9px;font:9px monospace;letter-spacing:.5px}
  .ui-packs{scroll-margin-top:100px}.collection-note{color:#60655f;font-size:14px;margin:-8px 0 28px;max-width:760px}.pack-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.pack-card{border:1px solid #dcded6;border-radius:18px;overflow:hidden;background:#fffefa;--accent:#bcf18e;--panel:#27372f;--ink:#eaf2e7}.fantasy{--accent:#eed18e;--panel:#33332b;--ink:#f6ead0}.orbital{--accent:#9cdff0;--panel:#20333f;--ink:#dcf5ff}.pack-study{padding:22px;background:var(--panel);color:var(--ink);min-height:270px;display:flex;flex-direction:column;gap:22px;background-image:linear-gradient(135deg,#ffffff0b,transparent)}.study-meta{display:flex;justify-content:space-between;font:9px monospace;letter-spacing:1px;gap:8px}.study-panel{border:1px solid #ffffff30;padding:18px;border-radius:8px;background:#ffffff08;transform:rotate(-2deg);max-width:270px;width:100%;margin:auto}.fantasy .study-panel{border-radius:18px 3px;border-color:#eed18e70;transform:rotate(2deg)}.orbital .study-panel{border-radius:2px;transform:rotate(-1deg)}.study-caption{font-size:16px;font-weight:700}.study-bars{display:grid;gap:6px;margin:16px 0}.study-bars i{height:4px;width:76%;background:var(--accent)}.study-bars i+ i{width:48%;opacity:.4}.study-slots{display:flex;gap:8px;margin-bottom:15px}.study-slots i{display:grid;place-items:center;border:1px solid #ffffff35;width:32px;height:32px;font-style:normal;color:var(--accent)}.study-action{display:flex;justify-content:space-between;padding:8px 10px;background:var(--accent);color:#20302c;font-size:11px;font-weight:700}.study-foot{font:9px monospace;letter-spacing:1.5px;opacity:.75}.pack-copy{padding:24px}.pack-status{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#60655f}.pack-copy h3{font-size:23px;line-height:1.25;margin:10px 0}.pack-copy p{font-size:14px;line-height:1.7;color:#60655f;margin:0}.pack-copy details{margin-top:20px;border-top:1px solid #e2e3dc;padding-top:15px}.pack-copy summary{cursor:pointer;font-size:13px;font-weight:600}.pack-copy details p{margin-top:12px}.pack-bridge{display:flex;align-items:center;justify-content:space-between;gap:32px;padding:30px;margin-top:24px;background:#e8eddf;border-radius:16px}.pack-bridge h3{font-size:23px;line-height:1.3;margin:8px 0}.pack-bridge p:last-child{max-width:610px;font-size:14px;line-height:1.7;color:#50594d}.pack-bridge .button{flex-shrink:0}.pack-contact{margin-top:24px}.pack-copy summary:focus-visible{outline:2px solid #386145;outline-offset:5px}@media(max-width:1100px){.pack-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:900px){.pack-grid{gap:14px}.pack-copy{padding:18px}.pack-study{padding:16px}.pack-bridge{align-items:flex-start;flex-direction:column}}@media(max-width:650px){.pack-grid{grid-template-columns:1fr}.pack-study{min-height:270px}.pack-bridge{padding:24px}.pack-bridge .button{white-space:normal}}
</style>
