---
import { serviceSchema, breadcrumbSchema } from '../../utils/seo';
import StudioLayout from '../../layouts/StudioLayout.astro';
import ServiceLine from '../../components/b/ServiceLine.astro';
import '../../styles/boutique.css';
const faq: [string, string][] = [
  ['Which platforms do you build for?', 'Web first, plus desktop apps and mobile. One platform is included in the MVP price; more are scoped.'],
  ['Do we own the code?', 'Yes. Source code, documentation and a walkthrough are part of every handover.'],
];
---
<StudioLayout title="App UI/UX Design and Development | Strategic Sloth" schema={[serviceSchema("App development", "/services/apps/", "Web, desktop and mobile app design and development: editors, dashboards, writing tools and 3D product apps."), breadcrumbSchema([["Home", "/"], ["Services", "/services/"], ["App development", "/services/apps/"]])]} description="Web, desktop and mobile apps with dense, task-heavy interfaces, designed and built by a senior product designer. Fixed-price MVP packages.">
<ServiceLine id="apps" headline="App UI/UX design and development<br><em>Apps people use every day.</em>" intro="Product design, front end and back end from one senior team. We build editors, dashboards, writing tools and 3D product apps, including our own." faq={faq} />
</StudioLayout>
