---
import Layout from '../layouts/Layout.astro';
import '../styles/creator-tools.css';
import IdeaPDFBuilder from '../components/IdeaPDFBuilder.astro';
import ToolsGrid from '../components/ToolsGrid.astro';
import NarriaFlowPromo from '../components/NarriaFlowPromo.astro';
import StarterOffer from '../components/StarterOffer.astro';
import AngleGeneratorModal from '../components/AngleGeneratorModal.astro';
import OutlineBuilderModal from '../components/OutlineBuilderModal.astro';
import CoverDirectionModal from '../components/CoverDirectionModal.astro';
import OfferStackModal from '../components/OfferStackModal.astro';
import SalesPageModal from '../components/SalesPageModal.astro';
---
<Layout title="Free creator tools — Strategic Sloth" description="Plan a digital product with six free tools for ideas, outlines, covers, offers, and sales copy. Pair each draft with a practical creator guide.">
<div class="creator-tools-page"><section class="page-intro container"><p class="eyebrow">LEARN / FREE CREATOR TOOLS</p><h1>From a useful idea<br/>to a clearer product.</h1><p class="lede">Find your angle, outline your PDF, and explain why it matters.<br/>Six free planning tools to put the lessons into practice.</p><div class="hero-actions"><a class="button" href="#idea-builder">Start with an idea ↓</a><a class="text-link" href="#tool-library">Explore all six tools →</a></div><p class="tools-intro-note">Free to use · No account required · Drafts generated in your browser</p></section>
<div class="creator-workbench"><IdeaPDFBuilder/><ToolsGrid/></div>
<section class="container tools-reading-note"><p class="eyebrow">THE TOOLS AND THE BOOKS WORK TOGETHER</p><h2>A draft gives you a start.<br/>A guide helps you work through it.</h2><p>These tools use preset frameworks to produce starting points, not validated demand or guaranteed sales. Review the details, adapt the language, and test the idea with real people. The related books explain the decisions behind the draft.</p><a class="text-link" href="/samples/sell-without-an-audience/">Read a free chapter on finding buyers →</a></section>
<NarriaFlowPromo/>
<AngleGeneratorModal/><OutlineBuilderModal/><CoverDirectionModal/><OfferStackModal/><SalesPageModal/>
</div><StarterOffer location="creator-tools-entry"/>
</Layout>
