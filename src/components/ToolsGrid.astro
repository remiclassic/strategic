---
import { books } from '../data/catalog-data';

const tools = [
  {
    id: "idea-builder",
    emoji: "💡",
    title: "PDF Idea Builder",
    description: "Answer four questions to draft a product idea, audience, and outline.",
    status: "live",
    statusLabel: "Live",
    cta: "Open Tool",
    ctaHref: "#idea-builder",
    toolAction: null,
    bg: "#E3F9ED",
  },
  {
    id: "angle-generator",
    emoji: "🎯",
    title: "Product Angle Generator",
    description: "Find a stronger hook, promise, or positioning for your PDF to explain its purpose clearly.",
    status: "live",
    statusLabel: "Live",
    cta: "Try It",
    ctaHref: null,
    toolAction: "angle",
    bg: "#FFF3CD",
  },
  {
    id: "outline-builder",
    emoji: "📐",
    title: "PDF Outline Builder",
    description: "Turn your idea into a clean chapter or section outline, ready to fill in and build.",
    status: "live",
    statusLabel: "Live",
    cta: "Build an Outline",
    ctaHref: null,
    toolAction: "outline",
    bg: "#F0EEFF",
  },
  {
    id: "cover-generator",
    emoji: "🎨",
    title: "Cover Direction Generator",
    description: "Get clear visual direction for your PDF cover: colors, style, layout, and mood, without hiring a designer.",
    status: "live",
    statusLabel: "Live",
    cta: "Generate Direction",
    ctaHref: null,
    toolAction: "cover",
    bg: "#E3F4FF",
  },
  {
    id: "offer-builder",
    emoji: "📦",
    title: "Offer Stack Builder",
    description: "Package your PDF with the right bonuses and position it as a stronger, more valuable offer.",
    status: "live",
    statusLabel: "Live",
    cta: "Build My Offer",
    ctaHref: null,
    toolAction: "offer",
    bg: "#FFF0F0",
  },
  {
    id: "sales-page-helper",
    emoji: "✍️",
    title: "Sales Page Helper",
    description: "Turn your product into simple, persuasive sales page copy. No marketing degree needed.",
    status: "live",
    statusLabel: "Live",
    cta: "Write Sales Copy",
    ctaHref: null,
    toolAction: "sales",
    bg: "#FFFBF2",
  },
];

const statusColors: Record<string, string> = {
  live:        "bg-[#2ECC71] text-white border-[#2ECC71]",
  demo:        "bg-[#4D9FFF] text-white border-[#4D9FFF]",
  coming_soon: "bg-[#FFD600] text-black border-[#FFD600]",
};

const bookIds=['first-100','offer-sells-itself','idea-to-pdf','idea-to-pdf','offer-sells-itself','landing-pages'];
---
<section class="section container creator-tool-library" id="tool-library"><div class="section-heading"><div><p class="eyebrow">02 / BUILD YOUR PRODUCT, STEP BY STEP</p><h2>A tool for each decision.</h2></div><p>Start with the free draft.<br/>Choose a guide when you want the full method.</p></div><div class="creator-tool-grid">{tools.map((tool,index)=>{const book=books.find(b=>b.id===bookIds[index])!;return <article class="creator-tool-card"><div class="creator-tool-meta"><span>0{index+1}</span><span>FREE TOOL</span></div><h3>{tool.title}</h3><p>{tool.description}</p>{tool.ctaHref ? <a class="button" href={tool.ctaHref}>{tool.cta} <span>↗</span></a> : <button class="button tool-trigger" type="button" data-tool={tool.toolAction}>{tool.cta} <span>↗</span></button>}<div class="tool-reading"><span>PAIR WITH THE GUIDE</span><a href={`/books/#${book.id}`}>{book.title} · ${book.price} →</a></div></article>})}</div></section>
<script>
document.addEventListener('DOMContentLoaded',()=>{
 const openers:Record<string,string>={angle:'openAngleGeneratorModal',outline:'openOutlineBuilderModal',cover:'openCoverDirectionModal',offer:'openOfferStackModal',sales:'openSalesPageModal'};
 document.querySelectorAll<HTMLButtonElement>('.tool-trigger').forEach(button=>button.addEventListener('click',()=>{const fn=(window as any)[openers[button.dataset.tool!]];if(typeof fn==='function')fn();}));
});
</script>
