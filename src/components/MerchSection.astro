---
// Curated SliceForge collection; product details and checkout live on Fourthwall.
const products = [
  { slug: 'skull-bloom-heavyweight-tee', name: 'Skull Bloom Heavyweight Tee', images: ['skull-bloom-back', 'skull-bloom-detail'], views: ['Full back print', 'Skull & serpent detail'] },
  { slug: 'sloth-sanctuary-desk-mat', name: 'Sloth Sanctuary Desk Mat', images: ['sloth-sanctuary-editorial', 'sloth-sanctuary-detail'], views: ['On your desk', 'Into the jungle'] },
  { slug: 'makers-guild-pin-set', name: 'Maker’s Guild Pins', images: ['makers-guild-editorial', 'makers-guild-detail'], views: ['The full set', 'Forge sprite detail'] },
];
function shopLink(path = '', placement = 'shop-cta') {
  const url = new URL(path, 'https://sliceforge-shop.fourthwall.com/');
  url.search = new URLSearchParams({ utm_source: 'strategicsloth.com', utm_medium: 'website', utm_campaign: 'merch', utm_content: placement }).toString();
  return url.toString();
}
---
<section id="merch" class="container merch-section" aria-labelledby="merch-title">
  <div class="merch-copy">
    <p class="eyebrow">04 / A LITTLE STUDIO, OFFLINE</p>
    <h2 id="merch-title">Art worth taking<br />off the canvas.</h2>
    <p class="merch-description">Bold back prints. Little creatures.<br />A world of detail for your everyday.</p>
    <a class="text-link merch-cta" href={shopLink()} target="_blank" rel="noopener noreferrer">Explore the merch <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
    <p class="merch-note">From our SliceForge collection.<br />Shop and check out on Fourthwall.</p>
  </div>
  <div class="merch-gallery">
    <div class="merch-products">
      {products.map(product => <a class="merch-card" href={shopLink(`/products/${product.slug}`, product.slug)} target="_blank" rel="noopener noreferrer">
        <div class="merch-image">
          {product.images.map((file, index) => <img src={`/merch/${file}.webp`} alt={`${product.name}: ${product.views[index]}`} width="1024" height="1024" loading="lazy" decoding="async" data-slide={index} data-active={index === 0 ? 'true' : 'false'} aria-hidden={index !== 0 ? 'true' : undefined} />)}
          {product.views.map((label, index) => <span class="merch-label" data-label={index} hidden={index !== 0} aria-hidden="true">{label}</span>)}
        </div>
        <span class="merch-name">{product.name}<span aria-hidden="true">↗</span></span>
        <span class="sr-only"> — view on Fourthwall (opens in a new tab)</span>
      </a>)}
    </div>
    <div class="merch-controls" hidden aria-label="Merch image controls">
      <div class="merch-views"><button type="button" data-view="0" aria-pressed="true">Product views</button><button type="button" data-view="1" aria-pressed="false">Artwork details</button></div>
      <button type="button" class="merch-pause" aria-label="Pause merch slideshow">Pause Ⅱ</button>
    </div>
  </div>
</section>

<style>
  .merch-section{display:grid;grid-template-columns:290px minmax(0,1fr);gap:48px;align-items:center;padding-block:56px 64px;border-top:1px solid var(--line);scroll-margin-top:110px}
  .merch-copy .eyebrow{font-size:10px;margin-bottom:17px;color:var(--muted)}
  .merch-copy h2{font-size:34px;line-height:1.15;letter-spacing:-.04em}
  .merch-description{font-size:14px;line-height:1.75;margin-top:17px}
  .merch-cta{margin-top:17px;color:#3d613d;border-bottom:1px solid #69836750;font-size:13px;gap:20px}
  .merch-note{font-size:11px;margin-top:12px;line-height:1.7}
  .merch-gallery{min-width:0}.merch-products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .merch-card{position:relative;min-width:0;display:block}.merch-image{position:relative;aspect-ratio:1;overflow:hidden;border-radius:10px;background:#e9e8e2}
  .merch-image img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 1.2s ease}
  .merch-image img[data-active="true"]{opacity:1}
  .merch-label{position:absolute;bottom:10px;left:10px;padding:4px 7px;border-radius:3px;background:#172218e6;color:white;font-size:10px}
  .merch-name{display:flex;justify-content:space-between;gap:8px;margin-top:12px;font-size:12px;line-height:1.5;color:var(--muted)}
  .merch-card:hover .merch-name{color:var(--ink)}
  .merch-controls{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:16px}
  .merch-controls button{min-height:44px;padding:6px 0;background:none;border:0;color:var(--muted);font:inherit;font-size:11px;cursor:pointer}
  .merch-views{display:flex;gap:20px}.merch-views button{border-bottom:1px solid transparent}.merch-views button[aria-pressed="true"]{color:#354e36;border-color:#698367}
  @media(max-width:1100px){.merch-section{grid-template-columns:240px minmax(0,1fr);gap:28px}.merch-copy h2{font-size:30px}}
  @media(max-width:900px){.merch-section{grid-template-columns:1fr;gap:28px}.merch-copy h2{font-size:34px}}
  @media(max-width:600px){.merch-section{padding-block:36px 44px}.merch-products{display:flex;overflow-x:auto;gap:14px;scroll-snap-type:x mandatory;padding:6px 6px 16px;margin:-6px}.merch-card{flex:0 0 80%;scroll-snap-align:start}.merch-controls{margin-top:12px}}
  @media(prefers-reduced-motion:reduce){.merch-image img{transition:none}}
</style>

<script>
  const section = document.querySelector<HTMLElement>('#merch');
  if (section) {
    const gallery = section.querySelector<HTMLElement>('.merch-gallery')!;
    const controls = section.querySelector<HTMLElement>('.merch-controls')!;
    const pause = section.querySelector<HTMLButtonElement>('.merch-pause')!;
    const buttons = section.querySelectorAll<HTMLButtonElement>('[data-view]');
    const images = Array.from(section.querySelectorAll<HTMLImageElement>('[data-slide]'));
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    let view = 0, paused = false, visible = false, hovering = false;
    let timer: ReturnType<typeof setInterval> | undefined;
    function showView(next: number) {
      view = next;
      images.forEach(img => {
        const active = Number(img.dataset.slide) === view;
        img.dataset.active = String(active);
        img.setAttribute('aria-hidden', String(!active));
      });
      section!.querySelectorAll<HTMLElement>('[data-label]').forEach(label => label.hidden = Number(label.dataset.label) !== view);
      buttons.forEach(button => button.setAttribute('aria-pressed', String(Number(button.dataset.view) === view)));
    }
    function sync() {
      clearInterval(timer);
      pause.hidden = preference.matches;
      pause.textContent = paused ? 'Play ▷' : 'Pause Ⅱ';
      pause.setAttribute('aria-label', paused ? 'Play merch slideshow' : 'Pause merch slideshow');
      if (paused || preference.matches || !visible || document.hidden || hovering || gallery.contains(document.activeElement) || !images.every(img => img.complete && img.naturalWidth > 0)) return;
      timer = setInterval(() => showView((view + 1) % 2), 6000);
    }
    buttons.forEach(button => button.addEventListener('click', () => { paused = true; showView(Number(button.dataset.view)); sync(); }));
    pause.addEventListener('click', () => { paused = !paused; sync(); });
    gallery.addEventListener('mouseenter', () => { hovering = true; sync(); });
    gallery.addEventListener('mouseleave', () => { hovering = false; sync(); });
    gallery.addEventListener('focusin', sync);
    gallery.addEventListener('focusout', () => queueMicrotask(sync));
    preference.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    images.forEach(img => img.addEventListener('load', sync));
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }, {threshold: .15}).observe(section);
    controls.hidden = false;
    sync();
  }
</script>
