---
import StudioLayout from '../layouts/StudioLayout.astro';
import CaseCard from '../components/b/CaseCard.astro';
import CtaBand from '../components/b/CtaBand.astro';
import { cases, lines } from '../data/studio';
import '../styles/boutique.css';
---
<StudioLayout title="Game UI & App Portfolio: Case Studies — Strategic Sloth" description="Game UI, apps and games with real footage: MechWarrior 5, Dauntless, Tropic Tumble, SliceForge, Norman Ascension and more. Every project states whether it is client work or our own.">
<section class="b-intro container">
  <p class="eyebrow">WORK</p>
  <h1>Real projects. <em>Real footage.</em></h1>
  <p class="lede">Shipped titles from Remi’s career, and games and products the studio designed, built and released. Each card says which: client work, our game or our product.</p>
</section>
<section class="container" style="padding-bottom:110px">
  <div class="b-filters" role="group" aria-label="Filter work by service">
    <button type="button" data-filter="all" aria-pressed="true">All work · {cases.length}</button>
    {lines.map(l => <button type="button" data-filter={l.id} aria-pressed="false">{l.name} · {cases.filter(c => c.line === l.id).length}</button>)}
  </div>
  <div class="b-cases" data-grid>{cases.map(c => <CaseCard c={c} />)}</div>
  <p class="b-note">Client work is from Remi Couture’s career at or for those studios. It is shown as founder experience and does not imply they are Strategic Sloth clients. Artwork and trademarks belong to their owners. For the full twenty-year record, see the <a class="text-link" href="/services/game-ui/#credits">credits <span>→</span></a></p>
</section>
<CtaBand />
</StudioLayout>
<script>
const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
const cards = document.querySelectorAll<HTMLElement>('[data-grid] .b-case');
buttons.forEach(b => b.addEventListener('click', () => {
  const f = b.dataset.filter;
  buttons.forEach(x => x.setAttribute('aria-pressed', String(x === b)));
  cards.forEach(c => { c.hidden = f !== 'all' && c.dataset.line !== f; });
}));
</script>
