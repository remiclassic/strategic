---
import { legalDocuments, legalUpdated, legalMailingAddress } from '../data/legal';
---
{legalDocuments.map(doc => <dialog id={`modal-${doc.id}`} class="legal-dialog" aria-labelledby={`${doc.id}-title`}><div class="legal-dialog-heading"><div><p class="eyebrow">STRATEGIC SLOTH LLC / LEGAL</p><h2 id={`${doc.id}-title`}>{doc.title}</h2><p class="legal-updated">Updated {legalUpdated}</p></div><button type="button" data-close-legal aria-label={`Close ${doc.title.toLowerCase()}`}>✕</button></div><div class="legal-dialog-body"><p class="legal-summary">{doc.summary}</p>{doc.sections.map(section=><section><h3>{section.title}</h3><Fragment set:html={section.body}/></section>)}<address class="legal-company"><strong>Strategic Sloth LLC</strong><br/>{legalMailingAddress}<br/><a href="mailto:privacy@strategicsloth.com">privacy@strategicsloth.com</a></address></div><div class="legal-dialog-footer"><a href={`/legal/${doc.id}/`}>Open full page ↗</a><button type="button" data-close-legal>Done</button></div></dialog>)}
<script>
let previousOverflow = '';
document.querySelectorAll<HTMLAnchorElement>('[data-legal]').forEach(link => link.addEventListener('click', event => {
  const dialog = document.getElementById(`modal-${link.dataset.legal}`) as HTMLDialogElement | null;
  if (!dialog?.showModal) return;
  event.preventDefault(); previousOverflow=document.body.style.overflow;
  dialog.showModal(); document.body.style.overflow='hidden';
  const body=dialog.querySelector('.legal-dialog-body'); if(body) body.scrollTop=0;
}));
document.querySelectorAll<HTMLDialogElement>('.legal-dialog').forEach(dialog => {
  dialog.querySelectorAll('[data-close-legal]').forEach(button => button.addEventListener('click',()=>dialog.close()));
  dialog.addEventListener('close',()=>{document.body.style.overflow=previousOverflow;});
  dialog.addEventListener('click',event=>{const r=dialog.getBoundingClientRect();if(event.target===dialog&&(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom))dialog.close();});
});
</script>
