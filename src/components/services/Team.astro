---
import { bench, delivers } from '../../data/services-team';
const groups = ['Engineering', 'Art & design', 'Delivery'] as const;
// Role art for cards with no person attached yet: it stands in for the role, not for a face.
const roleIcons: Record<string, string> = {
  code: 'M9 8l-4 4 4 4M15 8l4 4-4 4',
  cube: 'M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12L4 7.5',
  gamepad: 'M7 8h10a4 4 0 0 1 4 4v2a3 3 0 0 1-5.6 1.5L15 15H9l-.4.5A3 3 0 0 1 3 14v-2a4 4 0 0 1 4-4zM8 10.5v3M6.5 12h3M15.5 11.5h.01M17.5 13h.01',
  server: 'M4 5h16v5H4zM4 14h16v5H4zM7.5 7.5h.01M7.5 16.5h.01M11 7.5h5M11 16.5h5',
  globe: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18',
  layout: 'M4 5h16v14H4zM4 9h16M8 13h5M8 16h8M6.5 7h.01',
  curve: 'M5 18C11 18 9 6 19 6M5 18h.01M19 6h.01M5 6v12h14',
  shader: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 3v18M12 8h7.5M12 12h9M12 16h7.5',
  calendar: 'M5 6h14v13H5zM5 10h14M9 4v4M15 4v4M9 14.5l2 2 4-4',
  check: 'M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6zM9 12l2 2 4-4',
  contract: 'M7 3h8l4 4v14H7zM15 3v4h4M10 12h6M10 16c1.5-2 2.5 2 4 0s1.5-1 2 0',
};
---
<section class="section container" id="team"><div class="section-heading"><div><p class="eyebrow">The team</p><h2>One lead.<br>A bench that scales.</h2></div><p>Remi leads every project. When the scope needs more hands, experienced specialists join under the same lead, so you still have one point of contact.</p></div>
  <div class="tm-groups">{groups.map(group => <div class="tm-group sv-reveal"><h3>{group}</h3><ul>{bench.filter(member => member.group === group).map(member => <li>
    <span class:list={['tm-avatar', { 'tm-role': !member.name }]} aria-hidden="true">{member.name ? member.name.split(' ').map(part => part[0]).slice(0, 2).join('') : <svg viewBox="0 0 24 24"><path d={roleIcons[member.icon]} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>}</span>
    <div><strong>{member.role}</strong>{member.name ? <span class="tm-name">{member.name}{member.background && ` · ${member.background}`}</span> : null}<span class="tm-skills">{member.skills.join(' · ')}</span></div>
  </li>)}</ul></div>)}</div>
  <div class="tm-delivers sv-reveal">{delivers.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}</div>
  <p class="sv-work-foot">Team size follows the scope. A UI pass may be Remi alone; a full product brings in engineering, art and production. <a class="pf-link" href="/contact/?engagement=partner#enquiry">Ask about team shape for your project →</a></p>
</section>

<style is:global>
  .tm-warning{border:1px dashed #f3b58b;border-radius:10px;padding:14px 18px;margin-bottom:26px;font:400 12px/1.7 var(--mono);color:#f3b58b}
  .tm-warning code{color:var(--ink)}
  .tm-groups{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:20px}
  .tm-group{border:1px solid var(--line);border-radius:16px;background:var(--surface);padding:26px 26px 12px}
  .tm-group h3{font:500 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:10px}
  .tm-group ul{list-style:none;margin:0;padding:0}
  .tm-group li{display:flex;gap:16px;align-items:center;padding:16px 0;border-top:1px solid var(--line)}
  .tm-avatar{flex:none;width:46px;height:46px;border-radius:50%;display:grid;place-items:center;border:1px dashed #566352;color:var(--muted);font:600 15px/1 Manrope,sans-serif;background:var(--surface-2)}
  .tm-role{border-style:solid;border-color:color-mix(in srgb,var(--accent) 35%,transparent);color:var(--accent);background:radial-gradient(circle at 50% 30%,color-mix(in srgb,var(--accent) 16%,transparent),transparent 70%),var(--surface-2)}
  .tm-role svg{width:24px;height:24px}
  .tm-group li div{display:grid;gap:3px;min-width:0}
  .tm-group strong{font:600 16px/1.3 Manrope,sans-serif;letter-spacing:-.02em;color:var(--ink)}
  .tm-name{font-size:13px;color:var(--ink)}
  .tm-todo{font:400 11px/1.4 var(--mono);color:#f3b58b}
  .tm-skills{font:400 11px/1.5 var(--mono);color:var(--muted)}
  .tm-delivers{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0 28px;margin-top:50px}
  .tm-delivers article{border-top:1px solid var(--accent);padding:22px 0 6px}
  .tm-delivers h3{font-size:21px;letter-spacing:-.04em;margin-bottom:10px}
  .tm-delivers p{font-size:14px;line-height:1.65}
  @media(max-width:950px){.tm-groups{grid-template-columns:1fr}.tm-delivers{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.tm-delivers{grid-template-columns:1fr}}
</style>
