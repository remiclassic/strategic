---
import StudioLayout from '../layouts/StudioLayout.astro';
import RemiProfile from '../components/RemiProfile.astro';

const title = 'Rémi Couture | Game UX/UI Designer, Club Penguin Artist, Founder of Strategic Sloth';
const description =
  'Rémi (Guillaume) Couture, also spelled Remi or Remy Couture: Montreal game UX/UI designer. Club Penguin illustrator and animator at Disney (2006 to 2009), MechWarrior 5, Dauntless, AppLovin UX Director, creator of Sloth Jam.';

const alternates = [
  { lang: 'fr', href: '/fr/remi-couture/' },
  { lang: 'en', href: '/remi-couture/' },
];

const schema = [
  {
    '@type': 'ProfilePage',
    '@id': new URL('/remi-couture/#page', Astro.site).href,
    url: new URL('/remi-couture/', Astro.site).href,
    name: 'About Rémi Couture',
    mainEntity: { '@id': new URL('/remi-couture/#person', Astro.site).href },
    inLanguage: 'en',
    dateModified: new Date().toISOString().slice(0, 10),
  },
];
---
<StudioLayout title={title} description={description} lang="en" alternates={alternates} image="/studio-images/remi-founder-photo.jpg" schema={schema}>
  <RemiProfile lang="en" />
</StudioLayout>
