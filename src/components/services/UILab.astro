  .bar-hp::after{background:linear-gradient(180deg,rgba(255,255,255,.34),rgba(255,255,255,0) 48%,rgba(0,0,0,.3)),repeating-linear-gradient(90deg,transparent 0 calc(10% - 1px),rgba(0,0,0,.5) calc(10% - 1px) 10%)}
  .bar .ghost{background:var(--ui-text);opacity:.75;transition:transform var(--t-enter) linear}
  .bar.is-damage .ghost{transition:transform var(--t-drain) var(--ease-enter) var(--t-hold)}
