---
import StudioLayout from "../layouts/StudioLayout.astro";
import CtaBand from '../components/b/CtaBand.astro';
import { bench } from '../data/services-team';
import { credits, quotes } from '../data/services-credits';
import { stats, RESPONSE_TIME } from '../data/studio';
import '../styles/boutique.css';
const people = bench.filter(m => m.name);
const roles = bench.filter(m => !m.name);
---
<StudioLayout title="About the Studio: Senior Game UI/UX Team, Montreal — Strategic Sloth" description="Meet Strategic Sloth: a founder-led studio for game UI, apps and games. Remi Couture leads every project, with trusted engineers, artists and producers.">
<section class="b-intro container">
  <p class="eyebrow">THE STUDIO</p>
  <h1>Small on purpose. <em>Senior by default.</em></h1>
  <p class="lede">Strategic Sloth LLC is a founder-led studio. You work with the person who designs the interface, not an account manager, and the team grows around the project when it needs to.</p>
  <div class="b-facts" style="margin-top:40px">{stats.map(([n, l]) => <div><span>{l}</span><strong>{n}</strong></div>)}</div>
</section>

<section class="b-section container" style="padding-top:40px">
  <div class="b-founder">
    <img src="/studio-images/remi-founder-sloth.png" alt="Guillaume “Remi” Couture, founder of Strategic Sloth, illustrated in his studio with a sloth on his shoulder" width="1122" height="1402"/>
    <div>
      <p class="eyebrow">FOUNDER · LEADS EVERY PROJECT</p>
      <h2>Guillaume “Remi” Couture</h2>
      <p>Twenty years designing game interfaces, from Club Penguin at Disney to MechWarrior 5 at Piranha Games, Dauntless at Phoenix Labs and three years on Squad at Offworld. As UX Director at AppLovin he set the standards for nine mobile studios at once.</p>
      <p>He started Strategic Sloth to do the whole job: design the flow, make it look right, animate it and build it where it runs. The studio also makes its own games and tools, which keeps the practice honest about what shipping takes.</p>
      <div class="b-hero-actions"><a class="button" href="/contact/">Work with Remi <span>↗</span></a><a class="text-link" href="https://www.linkedin.com/in/remicouture/" target="_blank" rel="noopener">LinkedIn <span>↗</span></a><a class="text-link" href="https://remiclassic.github.io/remiresume/portfolio.html" target="_blank" rel="noopener">Portfolio <span>↗</span></a></div>
    </div>
  </div>
</section>

<section class="b-sage b-section" id="collaborators"><div class="container">
  <div class="b-head"><div><p class="eyebrow">THE TEAM</p><h2>People we build with.</h2></div><p>Trusted specialists who join under Remi when the scope needs them. One lead, one point of contact, no vendor chain.</p></div>
  <div class="b-team">{people.map(m => <div class="b-person"><img src={m.photo} alt={`Portrait of ${m.name}`} loading="lazy"/><div><strong>{m.name}</strong><span>{m.role}</span><p>{m.background}</p></div></div>)}</div>
  <p class="eyebrow" style="margin:50px 0 16px">SPECIALISTS ON CALL</p>
  <div class="b-tags" style="margin:0">{roles.map(r => <span style="background:#fbfaf5">{r.role}</span>)}</div>
</div></section>

<section class="b-section container">
  <div class="b-head"><div><p class="eyebrow">HOW WE WORK</p><h2>Four promises.</h2></div><p>The things clients tell us they could not get from a bigger vendor.</p></div>
  <ol class="b-steps" style="padding:0;margin:0">
    <li><h3>A fixed price first</h3><p>Published packages and a written scope with a fixed total before work begins.</p></li>
    <li><h3>One senior lead</h3><p>Design and implementation answer to the same person, so nothing is lost between them.</p></li>
    <li><h3>In your tools</h3><p>Your repository, your sprints, your engine. Work arrives as commits and builds, not just pictures.</p></li>
    <li><h3>A clean handover</h3><p>Source, files, documentation and a walkthrough. Remi replies {RESPONSE_TIME} throughout.</p></li>
  </ol>
</section>

<section class="b-night b-section"><div class="container">
  <div class="b-head"><div><p class="eyebrow">TWENTY YEARS OF CREDITS</p><h2>Shipped with <em>the teams.</em></h2></div><p>Remi’s career before and alongside the studio. Founder experience; not a list of Strategic Sloth clients.</p></div>
  <ul class="b-list" style="grid-template-columns:1fr">{credits.map(c => <li style="grid-template-columns:150px 1fr 1fr;display:grid;gap:20px;align-items:baseline"><span>{c.years}</span><strong>{c.studio}</strong><span>{c.role}</span></li>)}</ul>
  <div class="b-quotes" style="margin-top:60px">{[quotes[0], quotes[2], quotes[3]].map(q => <figure><blockquote>“{q.text}”</blockquote><figcaption><strong>{q.name}</strong>{q.relation} · {q.date}</figcaption></figure>)}</div>
</div></section>
<CtaBand />
</StudioLayout>
