---
// A working game UI rendered in the page: HUD, pause menu, inventory and motion tokens.
// Everything here is DOM + CSS driven by the script below. The backdrop is the only video.
// Icon art, drawn on a 48 grid: strokes carry the line, low-opacity fills carry the shading,
// and everything is currentColor so each skin and rarity tints it.
const icons: Record<string, string> = {
  sword: `<path d="M42 6l-2 9L23 32l-7-7L33 8z" fill="currentColor" fill-opacity=".3"/><path d="M42 6L19.5 28.5" stroke-width="1.2"/><path d="M11 21l16 16" stroke-width="3.4"/><path d="M17.5 30.5l-6.5 6.5" stroke-width="3.4"/><circle cx="8.5" cy="39.5" r="3" fill="currentColor" stroke="none"/>`,
  shield: `<path d="M24 4l16 5v12c0 11-7 18-16 23C15 39 8 32 8 21V9z" fill="currentColor" fill-opacity=".2"/><path d="M24 4l16 5v12c0 11-7 18-16 23z" fill="currentColor" stroke="none" fill-opacity=".28"/><path d="M24 10v27M13 20h22" stroke-width="2.6"/><circle cx="24" cy="20" r="2.6" fill="currentColor" stroke="none"/>`,
  potion: `<path d="M12.4 30h23.2L38 34a6 6 0 0 1-5.4 9H15.4a6 6 0 0 1-5.4-9z" fill="currentColor" stroke="none" fill-opacity=".5"/><path d="M20.5 7v9L10 34a6 6 0 0 0 5.4 9h17.2A6 6 0 0 0 38 34L27.5 16V7" fill="currentColor" fill-opacity=".14"/><path d="M18 5h12" stroke-width="3.4"/><path d="M12.4 30h23.2" stroke-width="1.2"/><circle cx="20" cy="36.5" r="1.6" fill="currentColor" stroke="none"/><circle cx="27.5" cy="34" r="1.1" fill="currentColor" stroke="none"/><path d="M31 22l2.5 4.5" stroke-width="1.4"/>`,
  ring: `<path d="M24 18a12 12 0 1 0 0 24 12 12 0 0 0 0-24zm0 4.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15z" fill="currentColor" fill-opacity=".3" fill-rule="evenodd"/><path d="M24 3l6.5 6.5L24 19l-6.5-9.5z" fill="currentColor" fill-opacity=".55"/><path d="M17.5 9.5h13M24 3v16" stroke-width="1.2"/>`,
  bow: `<path d="M13 4c24 8 24 32 0 40" stroke-width="3"/><path d="M13 4v40" stroke-width="1.2"/><path d="M5 24h30" stroke-width="2"/><path d="M34 18l9 6-9 6z" fill="currentColor" stroke="none"/><path d="M5 24l4-4M5 24l4 4M9 24l4-4M9 24l4 4" stroke-width="1.4"/><path d="M29.5 20.5v7" stroke-width="3.4"/>`,
  scroll: `<path d="M14 6h22a4 4 0 0 1 4 4v24H18V10a4 4 0 0 0-4-4z" fill="currentColor" fill-opacity=".2"/><path d="M14 6a4 4 0 0 0-4 4v4h8"/><path d="M12 34h32v2a6 6 0 0 1-6 6H18a6 6 0 0 1-6-6z" fill="currentColor" fill-opacity=".42"/><path d="M23 14h12M23 20h12M23 26h6" stroke-width="1.5"/><circle cx="34" cy="27" r="2.6" fill="currentColor" stroke="none"/>`,
  gem: `<path d="M14 6h20l10 12-20 26L4 18z" fill="currentColor" fill-opacity=".22"/><path d="M24 6l7 12-7 26-7-26z" fill="currentColor" stroke="none" fill-opacity=".3"/><path d="M4 18h40M14 6l3 12 7 26 7-26 3-12M17 18l7-12 7 12" stroke-width="1.3"/>`,
  key: `<path d="M15 5a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 6a4 4 0 1 1 0 8 4 4 0 0 1 0-8z" fill="currentColor" fill-opacity=".3" fill-rule="evenodd"/><path d="M22 22l21 21M34 34l5-5M39.5 39.5l4-4" stroke-width="3"/>`,
  helm: `<path d="M10 42V20a14 14 0 0 1 28 0v22z" fill="currentColor" fill-opacity=".22"/><path d="M24 6a14 14 0 0 1 14 14v22H24z" fill="currentColor" stroke="none" fill-opacity=".26"/><path d="M24 6v36" stroke-width="2.6"/><path d="M13 23h22" stroke-width="3"/><path d="M7 42h34" stroke-width="2.6"/><circle cx="17" cy="31" r="1.2" fill="currentColor" stroke="none"/><circle cx="17" cy="36" r="1.2" fill="currentColor" stroke="none"/><circle cx="31" cy="31" r="1.2" fill="currentColor" stroke="none"/><circle cx="31" cy="36" r="1.2" fill="currentColor" stroke="none"/>`,
  flag: `<path d="M11 8h29l-7 9 7 9H11z" fill="currentColor" fill-opacity=".3"/><path d="M11 6v38" stroke-width="3"/><circle cx="11" cy="5" r="2.6" fill="currentColor" stroke="none"/><path d="M22 12l5 5-5 5-5-5z" fill="currentColor" stroke="none"/>`,
};
const abilities = [
  { id: 'strike', name: 'Strike', icon: 'sword', key: '1' },
  { id: 'guard', name: 'Guard', icon: 'shield', key: '2' },
  { id: 'rally', name: 'Rally', icon: 'flag', key: '3' },
  { id: 'volley', name: 'Volley', icon: 'bow', key: '4' },
];
const views = [['hud', 'HUD'], ['menu', 'Menu'], ['inventory', 'Inventory'], ['motion', 'Motion']];
const skins = [['ember', 'Ember'], ['signal', 'Signal'], ['paper', 'Paper']];
const curves = [
  { id: 'enter', name: 'Enter', ms: 180, bez: [0.2, 0.7, 0.2, 1], use: 'Panels, toasts, tooltips' },
  { id: 'exit', name: 'Exit', ms: 120, bez: [0.4, 0, 1, 1], use: 'Anything leaving the screen' },
  { id: 'emphasis', name: 'Emphasis', ms: 320, bez: [0.34, 1.56, 0.64, 1], use: 'Rewards, equip, level up' },
  { id: 'drain', name: 'Ghost drain', ms: 600, delay: 450, bez: [0.2, 0.7, 0.2, 1], use: 'Health lost, shown late on purpose' },
];
const curvePath = ([a, b, c, d]: number[]) => `M0 100 C${a * 100} ${100 - b * 100} ${c * 100} ${100 - d * 100} 100 0`;
---
<div class="lab" data-lab data-skin="ember" data-view="hud" data-input="mouse">
  <svg width="0" height="0" hidden aria-hidden="true"><defs>{Object.entries(icons).map(([id, d]) => <symbol id={`lab-i-${id}`} viewBox="0 0 48 48"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={d}/></symbol>)}</defs></svg>
  <div class="lab-bar">
    <div class="lab-tabs" role="group" aria-label="Demo screen">{views.map(([id, label]) => <button type="button" data-view-btn={id} aria-pressed={id === 'hud' ? 'true' : 'false'}>{label}</button>)}</div>
    <div class="lab-skins" role="group" aria-label="Visual skin"><span>Skin</span>{skins.map(([id, label]) => <button type="button" data-skin-btn={id} aria-pressed={id === 'ember' ? 'true' : 'false'}><i class={`sw sw-${id}`}></i>{label}</button>)}</div>
  </div>

  <div class="lab-stage" tabindex="0" role="application" aria-label="Interactive game interface demo. Arrow keys move focus, Enter selects, Escape goes back, 1 to 4 use abilities.">
    <video class="lab-backdrop" muted loop playsinline preload="none" poster="/media/norman-ascension/hero-poster.jpg" aria-hidden="true" tabindex="-1"><source src="/media/norman-ascension/hero-loop.mp4" type="video/mp4"/></video>
    <div class="lab-scrim" aria-hidden="true"></div>
    <div class="lab-ui">
      <!-- HUD -->
      <div class="lab-view hud" data-panel="hud">
        <div class="hud-compass" aria-hidden="true"><div class="hud-compass-strip">{['N', '·', 'NE', '·', 'E', '·', 'SE', '·', 'S', '·', 'SW', '·', 'W', '·', 'NW', '·', 'N', '·', 'NE', '·', 'E'].map(t => <span>{t}</span>)}</div><i></i></div>
        <div class="hud-target ui-panel"><div class="hud-target-top"><strong data-enemy-name>Saxon Huscarl</strong><span data-enemy-lvl>Lv 11</span></div><div class="bar bar-enemy" data-bar="enemy" style="--hp:1"><i class="ghost"></i><i class="fill"></i></div></div>
        <div class="hud-objective ui-panel"><span class="ui-kicker">Objective</span><strong data-obj-title>Hold the abbey road</strong><ul data-obj-list><li>Break the shield wall</li><li>Defeat three huscarls</li><li>Raise the banner</li></ul></div>
        <div class="hud-floats" data-floats aria-hidden="true"></div>
        <div class="hud-toasts" data-toasts aria-live="polite"></div>
        <div class="hud-player ui-panel">
          <div class="hud-portrait"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 49c0-10 8-15 21-15s21 5 21 15z" fill="currentColor" fill-opacity=".34"/><path d="M13 22c0 12 4 17 11 17s11-5 11-17z" fill="currentColor" fill-opacity=".2"/><path d="M17 23h14v5c0 5-3 8-7 8s-7-3-7-8z" fill="#000" fill-opacity=".45" stroke="none"/><path d="M12 22c0-10 5-17 12-18 7 1 12 8 12 18z" fill="currentColor" fill-opacity=".5"/><path d="M24 4c7 1 12 8 12 18H24z" fill="#000" fill-opacity=".22" stroke="none"/><path d="M10.5 22h27" stroke-width="2.8"/><path d="M24 5v17" stroke-width="1.2"/><path d="M24 22v10" stroke-width="3.2"/><path d="M18.5 26.5h2.5M27 26.5h2.5" stroke-width="1.8"/><path d="M15 36l4 3M33 36l-4 3M20 41h8" stroke-width="1" stroke-opacity=".6"/></svg><b data-level>12</b></div>
          <div class="hud-vitals"><div class="hud-name"><strong>Aldric of Caen</strong><span><b data-hp-text>120</b> / 120</span></div>
            <div class="bar bar-hp" data-bar="hp" style="--hp:1"><i class="ghost"></i><i class="fill"></i></div>
            <div class="bar bar-st" data-bar="st" style="--hp:1"><i class="fill"></i></div>
            <div class="hud-buffs" data-buffs></div>
          </div>
        </div>
        <div class="hud-abilities">{abilities.map(a => <button type="button" class="ability" data-ability={a.id} data-nav aria-label={`${a.name}, key ${a.key}`}><svg aria-hidden="true"><use href={`#lab-i-${a.icon}`}/></svg><i class="cd"></i><span class="keycap">{a.key}</span><em>{a.name}</em></button>)}</div>
        <div class="hud-vignette" aria-hidden="true"></div>
      </div>

      <!-- Pause menu -->
      <div class="lab-view menu" data-panel="menu" hidden>
        <div class="menu-col" data-scope="main">
          <span class="ui-kicker">Norman coast · Day 14</span><h3>Paused</h3>
          <div class="menu-list">
            <button type="button" data-nav data-action="resume">Resume</button>
            <button type="button" data-nav data-action="inventory">Inventory</button>
            <button type="button" data-nav data-action="settings">Settings</button>
            <button type="button" data-nav data-action="quit">Quit to title</button>
          </div>
        </div>
        <div class="menu-sub ui-panel" data-scope="settings" hidden>
          <span class="ui-kicker">Settings</span>
          <label class="set-row"><span>Master volume</span><input type="range" min="0" max="10" value="7" data-nav data-setting="volume"/><output>7</output></label>
          <label class="set-row"><span>HUD scale</span><input type="range" min="80" max="120" step="10" value="100" data-nav data-setting="scale"/><output>100%</output></label>
          <div class="set-row"><span>Subtitles</span><button type="button" class="switch" role="switch" aria-checked="true" data-nav data-setting="subtitles"><i></i></button><output>On</output></div>
          <div class="set-row"><span>Reduce motion</span><button type="button" class="switch" role="switch" aria-checked="false" data-nav data-setting="calm"><i></i></button><output>Off</output></div>
          <button type="button" class="menu-back" data-nav data-action="back">Back</button>
        </div>
        <div class="menu-confirm ui-panel" data-scope="confirm" data-cols="2" role="alertdialog" aria-label="Quit to title?" hidden>
          <strong>Quit to title?</strong><p>Progress since the last rest will be lost.</p>
          <div><button type="button" data-nav data-action="back">Cancel</button><button type="button" data-nav data-action="resume">Quit</button></div>
        </div>
      </div>

      <!-- Inventory -->
      <div class="lab-view inventory" data-panel="inventory" hidden>
        <div class="inv-main ui-panel">
          <div class="inv-head"><div><span class="ui-kicker">Saddlebag</span><h3>Inventory</h3></div><div class="inv-sort" role="group" aria-label="Sort"><button type="button" data-sort="rarity" aria-pressed="true">Rarity</button><button type="button" data-sort="type" aria-pressed="false">Type</button><button type="button" data-sort="value" aria-pressed="false">Value</button></div></div>
          <div class="inv-grid" data-scope="inventory" data-cols="6" data-grid></div>
        </div>
        <aside class="inv-detail ui-panel" data-detail aria-live="polite"></aside>
      </div>

      <!-- Motion tokens -->
      <div class="lab-view motion" data-panel="motion" hidden>
        <div class="motion-head"><div><span class="ui-kicker">Motion tokens</span><h3>Four curves run this interface.</h3></div><button type="button" class="motion-replay" data-replay data-nav>Replay</button></div>
        <div class="motion-grid" data-scope="motion">{curves.map(c => <article class="motion-card ui-panel" data-curve={c.id} data-ms={c.ms} data-delay={c.delay ?? 0} data-bez={c.bez.join(',')}>
          <svg viewBox="-4 -34 108 140" preserveAspectRatio="xMidYMax meet" aria-hidden="true"><path class="axis" d="M0 100H100M0 100V0"/><path class="curve" d={curvePath(c.bez)} pathLength="1"/></svg>
          <div class="motion-track"><i></i></div>
          <strong>{c.name}</strong><code>{c.ms} ms{c.delay ? ` · ${c.delay} ms hold` : ''}</code><code>cubic-bezier({c.bez.join(', ')})</code><p>{c.use}</p>
        </article>)}</div>
      </div>
    </div>
    <div class="lab-prompts" aria-hidden="true">
      <span class="p-kb"><kbd>↑</kbd><kbd>↓</kbd> Navigate <kbd>Enter</kbd> Select <kbd>Esc</kbd> Back <kbd>1</kbd>–<kbd>4</kbd> Abilities</span>
      <span class="p-pad"><kbd class="round">✛</kbd> Navigate <kbd class="round a">A</kbd> Select <kbd class="round b">B</kbd> Back</span>
      <span class="p-mouse">Click anything · or focus the stage and use the keyboard or a gamepad</span>
    </div>
  </div>

  <div class="lab-console">
    <p class="lab-live"><span class="live-dot"></span> Live interface · rendered by your browser, not a video · <span data-input-label>mouse</span> input</p>
    <div class="lab-actions" data-for="hud"><button type="button" data-do="hit">Take a hit</button><button type="button" data-do="heal">Heal</button><button type="button" data-do="loot">Drop loot</button><button type="button" data-do="objective">Advance objective</button></div>
    <label class="lab-rail"><input type="checkbox" data-rail/> Show focus order</label>
  </div>
</div>

<script>
  const lab = document.querySelector<HTMLElement>('[data-lab]');
  if (lab) init(lab);

  function init(lab: HTMLElement) {
    const $ = <T extends HTMLElement = HTMLElement>(s: string, root: ParentNode = lab) => root.querySelector<T>(s)!;
    const $$ = <T extends HTMLElement = HTMLElement>(s: string, root: ParentNode = lab) => [...root.querySelectorAll<T>(s)];
    const stage = $('.lab-stage'), ui = $('.lab-ui'), video = $<HTMLVideoElement>('.lab-backdrop');
    const systemCalm = matchMedia('(prefers-reduced-motion: reduce)');
    let calm = systemCalm.matches;
    const applyCalm = () => lab.toggleAttribute('data-calm', calm);
    applyCalm();
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const pick = <T,>(list: T[]) => list[Math.floor(Math.random() * list.length)];

    /* ---------- views, skins, input device ---------- */
    let view = 'hud', lastTouch = 0;
    const touched = () => { lastTouch = performance.now(); };
    function setView(next: string, focus = true) {
      view = next;
      lab.dataset.view = next;
      $$('[data-panel]').forEach(p => { p.hidden = p.dataset.panel !== next; });
      $$('[data-view-btn]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === next)));
      $$('.lab-actions').forEach(a => { a.hidden = a.dataset.for !== next; });
      if (next === 'menu') openScope('main', false);
      if (next === 'motion') replayCurves();
      if (focus) focusFirst();
    }
    $$('[data-view-btn]').forEach(b => b.addEventListener('click', () => { touched(); setView(b.dataset.viewBtn!, false); }));
    $$('[data-skin-btn]').forEach(b => b.addEventListener('click', () => {
      lab.dataset.skin = b.dataset.skinBtn;
      $$('[data-skin-btn]').forEach(o => o.setAttribute('aria-pressed', String(o === b)));
    }));
    function setInput(kind: string) {
      if (lab.dataset.input === kind) return;
      lab.dataset.input = kind;
      $('[data-input-label]').textContent = kind === 'pad' ? 'gamepad' : kind === 'kb' ? 'keyboard' : 'mouse';
    }
    stage.addEventListener('pointerdown', () => { setInput('mouse'); touched(); });
    $<HTMLInputElement>('[data-rail]').addEventListener('change', e => lab.toggleAttribute('data-show-rail', (e.target as HTMLInputElement).checked));

    /* ---------- focus navigation ---------- */
    const memory = new Map<string, HTMLElement>(); // last focused element per scope
    const scopeStack: string[] = [];
    const activeScope = (): HTMLElement => {
      if (view === 'menu') return $(`[data-scope="${scopeStack[scopeStack.length - 1] || 'main'}"]`);
      return $(`[data-panel="${view}"]`);
    };
    const navItems = () => $$('[data-nav]', activeScope()).filter(el => !el.closest('[hidden]'));
    function focusFirst() {
      const scope = activeScope(), items = navItems();
      const remembered = memory.get(scope.dataset.scope || view);
      (remembered && items.includes(remembered) ? remembered : items[0])?.focus({ preventScroll: true });
    }
    function move(dx: number, dy: number) {
      const items = navItems();
      if (!items.length) return;
      const scope = activeScope();
      const grid = scope.matches('[data-cols]') ? scope : scope.querySelector<HTMLElement>('[data-cols]');
      const current = items.indexOf(document.activeElement as HTMLElement);
      if (current < 0) return focusFirst();
      const inGrid = grid?.contains(items[current]);
      const cols = inGrid ? Number(grid!.dataset.cols) : view === 'hud' || view === 'motion' ? items.length : 1;
      let next = current + dx + dy * cols;
      if (cols === 1 && dx) return; // left and right belong to the control itself
      if (next < 0 || next >= items.length) next = (next + items.length) % items.length;
      items[next].focus({ preventScroll: true });
    }
    function openScope(name: string, remember = true) {
      const from = scopeStack[scopeStack.length - 1];
      if (remember && from && document.activeElement instanceof HTMLElement) memory.set(from, document.activeElement);
      if (name === 'main') scopeStack.length = 0;
      scopeStack.push(name);
      $$('[data-scope="settings"],[data-scope="confirm"]').forEach(s => { s.hidden = s.dataset.scope !== name; });
      $('[data-scope="main"]').toggleAttribute('data-dimmed', name !== 'main');
      focusFirst();
    }
    function back() {
      if (view === 'menu' && scopeStack.length > 1) {
        scopeStack.pop();
        $$('[data-scope="settings"],[data-scope="confirm"]').forEach(s => { s.hidden = true; });
        $('[data-scope="main"]').removeAttribute('data-dimmed');
        focusFirst(); // focus memory: lands on the item that opened the sub-screen
      } else if (view === 'hud') setView('menu');
      else setView('hud');
    }
    stage.addEventListener('focusin', e => {
      const el = e.target as HTMLElement;
      if (el.matches('[data-nav]')) memory.set(activeScope().dataset.scope || view, el);
    });
    stage.addEventListener('click', e => {
      const source = (e.target as HTMLElement).closest<HTMLElement>('[data-action]');
      const action = source?.dataset.action;
      // Safari does not focus a clicked button, so remember the opener explicitly
      if (source?.matches('[data-nav]') && (action === 'settings' || action === 'quit')) source.focus({ preventScroll: true });
      if (action === 'resume') setView('hud');
      else if (action === 'inventory') setView('inventory');
      else if (action === 'settings') openScope('settings');
      else if (action === 'quit') openScope('confirm');
      else if (action === 'back') back();
    });
    stage.addEventListener('keydown', e => {
      const k = e.key.toLowerCase();
      const range = (e.target as HTMLElement).matches('input[type=range]');
      const dirs: Record<string, [number, number]> = { arrowup: [0, -1], w: [0, -1], arrowdown: [0, 1], s: [0, 1], arrowleft: [-1, 0], a: [-1, 0], arrowright: [1, 0], d: [1, 0] };
      if (dirs[k]) {
        setInput('kb'); touched();
        if (range && dirs[k][0]) return; // let the slider take left and right
        e.preventDefault();
        if (e.target === stage) focusFirst(); else move(...dirs[k]);
      } else if (k === 'escape' || k === 'backspace') { e.preventDefault(); setInput('kb'); touched(); back(); }
      else if (view === 'hud' && '1234'.includes(k) && k) { setInput('kb'); touched(); useAbility(abilityIds[Number(k) - 1]); }
      else if (k === 'enter' && e.target === stage) { e.preventDefault(); focusFirst(); }
    });

    /* gamepad: polled only while the stage is on screen */
    let visible = false, padHeld = '';
    function pollPad() {
      if (!visible) return;
      const pad = navigator.getGamepads?.().find(Boolean);
      if (pad) {
        const b = (i: number) => pad.buttons[i]?.pressed;
        const x = pad.axes[0] || 0, y = pad.axes[1] || 0;
        const now = b(12) || y < -0.6 ? 'up' : b(13) || y > 0.6 ? 'down' : b(14) || x < -0.6 ? 'left' : b(15) || x > 0.6 ? 'right' : b(0) ? 'a' : b(1) ? 'b' : b(9) ? 'start' : '';
        if (now && now !== padHeld) {
          setInput('pad'); touched();
          if (!stage.contains(document.activeElement)) focusFirst();
          else if (now === 'a') (document.activeElement as HTMLElement).click();
          else if (now === 'b') back();
          else if (now === 'start') setView(view === 'menu' ? 'hud' : 'menu');
          else {
            const el = document.activeElement as HTMLInputElement;
            if (el.matches('input[type=range]') && (now === 'left' || now === 'right')) { now === 'left' ? el.stepDown() : el.stepUp(); el.dispatchEvent(new Event('input', { bubbles: true })); }
            else move(now === 'left' ? -1 : now === 'right' ? 1 : 0, now === 'up' ? -1 : now === 'down' ? 1 : 0);
          }
        }
        padHeld = now;
      }
      requestAnimationFrame(pollPad);
    }

    /* ---------- settings ---------- */
    stage.addEventListener('input', e => {
      const el = e.target as HTMLInputElement, out = el.parentElement!.querySelector('output')!;
      if (el.dataset.setting === 'volume') out.textContent = el.value;
      if (el.dataset.setting === 'scale') { out.textContent = `${el.value}%`; ui.style.setProperty('--hud-scale', String(Number(el.value) / 100)); }
    });
    $$('.switch').forEach(sw => sw.addEventListener('click', () => {
      const on = sw.getAttribute('aria-checked') !== 'true';
      sw.setAttribute('aria-checked', String(on));
      sw.parentElement!.querySelector('output')!.textContent = on ? 'On' : 'Off';
      if (sw.dataset.setting === 'calm') { calm = on || systemCalm.matches; applyCalm(); }
    }));

    /* ---------- HUD ---------- */
    const MAX_HP = 120;
    const state = { hp: MAX_HP, st: 1, enemy: 1, kills: 0, step: 0, guard: 0 };
    const cooldown: Record<string, number> = { strike: 1400, guard: 5000, rally: 7000, volley: 9000 };
    const abilityIds = Object.keys(cooldown);
    const ready: Record<string, boolean> = { strike: true, guard: true, rally: true, volley: true };
    const enemies = ['Saxon Huscarl', 'Shield Bearer', 'Fyrd Spearman', 'Thegn of Wessex'];

    // Same technique as the code sample on this page: one custom property, CSS does the motion.
    function setBar(name: string, pct: number) {
      const bar = $(`[data-bar="${name}"]`);
      pct = Math.min(1, Math.max(0, pct));
      const previous = Number(bar.style.getPropertyValue('--hp') || 1);
      const damage = pct < previous;
      bar.classList.toggle('is-damage', damage);
      bar.style.setProperty('--hp', String(pct));
      if (damage && !calm) bar.animate({ filter: ['brightness(1.8)', 'none'] }, { duration: 120 });
    }
    function float(text: string, kind: string, x = rand(38, 62), y = rand(30, 46)) {
      const el = document.createElement('span');
      el.className = `float float-${kind}`;
      el.textContent = text;
      el.style.left = `${x}%`; el.style.top = `${y}%`;
      $('[data-floats]').append(el);
      el.addEventListener('animationend', () => el.remove());
      if (calm) setTimeout(() => el.remove(), 700);
    }
    function toast(icon: string, title: string, note: string, rarity = 0) {
      const feed = $('[data-toasts]');
      const el = document.createElement('div');
      el.className = 'toast ui-panel'; el.dataset.rarity = String(rarity);
      el.innerHTML = `<svg aria-hidden="true"><use href="#lab-i-${icon}"/></svg><div><strong></strong><span></span></div>`;
      el.querySelector('strong')!.textContent = title; el.querySelector('span')!.textContent = note;
      feed.prepend(el);
      while (feed.children.length > 3) feed.lastElementChild!.remove();
      setTimeout(() => { el.classList.add('is-out'); setTimeout(() => el.remove(), 260); }, 3600);
    }
    function setHp(value: number) {
      state.hp = Math.min(MAX_HP, Math.max(0, value));
      $('[data-hp-text]').textContent = String(Math.round(state.hp));
      setBar('hp', state.hp / MAX_HP);
      $('.hud-player').classList.toggle('is-low', state.hp / MAX_HP < 0.3);
    }
    function hit(amount = Math.round(rand(9, 22))) {
      if (state.guard > performance.now()) { float('Blocked', 'block', rand(22, 34), rand(62, 70)); return; }
      setHp(state.hp - amount);
      float(`−${amount}`, 'hurt', rand(20, 32), rand(60, 70));
      const v = $('.hud-vignette'); v.classList.remove('is-on'); void v.offsetWidth; v.classList.add('is-on');
      if (state.hp <= 0) setTimeout(() => { setHp(MAX_HP); toast('flag', 'You rally at the abbey', 'Health restored'); }, 900);
    }
    function heal(amount = 30) { setHp(state.hp + amount); float(`+${amount}`, 'heal', rand(20, 32), rand(60, 70)); }
    function loot() {
      const drop = pick(items.filter(i => i.rarity < 3));
      toast(drop.icon, drop.name, `${rarityName[drop.rarity]} ${drop.type}`, drop.rarity);
    }
    function objective() {
      const rows = $$('[data-obj-list] li');
      if (state.step >= rows.length) return;
      rows[state.step++].classList.add('is-done');
      if (state.step < rows.length) return;
      toast('flag', 'Objective complete', 'The abbey road is held', 2);
      setTimeout(() => { rows.forEach(li => li.classList.remove('is-done')); state.step = 0; }, 3200);
    }
    function strikeEnemy(amount: number, crit = false) {
      state.enemy = Math.max(0, state.enemy - amount / 100);
      setBar('enemy', state.enemy);
      float(crit ? `${amount}!` : String(amount), crit ? 'crit' : 'deal');
      if (state.enemy > 0) return;
      state.kills++;
      loot();
      if (state.kills % 2 === 0) objective();
      setTimeout(() => {
        state.enemy = 1;
        $('[data-enemy-name]').textContent = enemies[state.kills % enemies.length];
        $('[data-enemy-lvl]').textContent = `Lv ${10 + (state.kills % 5)}`;
        const bar = $('[data-bar="enemy"]'); bar.classList.remove('is-damage'); bar.style.setProperty('--hp', '1');
      }, 900);
    }
    function useAbility(id: string) {
      if (!ready[id]) { const b = $(`[data-ability="${id}"]`); b.classList.remove('is-denied'); void b.offsetWidth; b.classList.add('is-denied'); return false; }
      ready[id] = false;
      const btn = $(`[data-ability="${id}"]`);
      btn.classList.add('is-cooling'); btn.classList.remove('is-ready');
      btn.style.setProperty('--cd-ms', `${cooldown[id]}ms`);
      setTimeout(() => { ready[id] = true; btn.classList.remove('is-cooling'); btn.classList.add('is-ready'); }, cooldown[id]);
      state.st = Math.max(0, state.st - 0.22); setBar('st', state.st);
      if (id === 'strike') strikeEnemy(Math.round(rand(14, 24)));
      if (id === 'volley') [0, 140, 280].forEach((d, i) => setTimeout(() => strikeEnemy(Math.round(rand(16, 26)), i === 2), d));
      if (id === 'rally') heal(35);
      if (id === 'guard') {
        state.guard = performance.now() + 3000;
        const buff = document.createElement('span'); buff.className = 'buff'; buff.innerHTML = '<svg aria-hidden="true"><use href="#lab-i-shield"/></svg>Guard';
        $('[data-buffs]').replaceChildren(buff); setTimeout(() => buff.remove(), 3000);
      }
      return true;
    }
    $$('[data-ability]').forEach(b => b.addEventListener('click', () => { touched(); useAbility(b.dataset.ability!); }));
    const actions: Record<string, () => void> = { hit: () => hit(), heal: () => heal(), loot, objective };
    $$('[data-do]').forEach(b => b.addEventListener('click', () => { touched(); if (view !== 'hud') setView('hud', false); actions[b.dataset.do!](); }));
    setInterval(() => { if (state.st < 1) { state.st = Math.min(1, state.st + 0.04); setBar('st', state.st); } }, 400);

    // Attract mode: plays the HUD until someone takes over, and only while it is on screen.
    setInterval(() => {
      if (!visible || calm || view !== 'hud' || document.hidden || performance.now() - lastTouch < 7000) return;
      const roll = Math.random();
      if (state.hp < 45 && ready.rally) useAbility('rally');
      else if (roll < 0.3) hit();
      else if (roll < 0.42 && ready.guard) useAbility('guard');
      else if (roll < 0.6 && ready.volley) useAbility('volley');
      else if (ready.strike) useAbility('strike');
    }, 1300);

    /* ---------- inventory ---------- */
    const rarityName = ['Common', 'Fine', 'Rare', 'Heirloom'];
    const items = [
      { id: 'a', name: 'Falchion of Caen', type: 'weapon', icon: 'sword', rarity: 2, power: 46, weight: 30, value: 180 },
      { id: 'b', name: 'Arming Sword', type: 'weapon', icon: 'sword', rarity: 0, power: 28, weight: 34, value: 40 },
      { id: 'c', name: 'Yew Longbow', type: 'weapon', icon: 'bow', rarity: 1, power: 37, weight: 18, value: 95 },
      { id: 'd', name: 'Kite Shield', type: 'armour', icon: 'shield', rarity: 1, power: 33, weight: 52, value: 80 },
      { id: 'e', name: 'Ducal Great Helm', type: 'armour', icon: 'helm', rarity: 3, power: 58, weight: 44, value: 420 },
      { id: 'f', name: 'Nasal Helm', type: 'armour', icon: 'helm', rarity: 0, power: 22, weight: 30, value: 35 },
      { id: 'g', name: 'Abbey Tonic', type: 'supply', icon: 'potion', rarity: 0, power: 12, weight: 4, value: 12 },
      { id: 'h', name: 'Signet of the House', type: 'trinket', icon: 'ring', rarity: 3, power: 40, weight: 1, value: 600 },
      { id: 'i', name: 'Charter of Passage', type: 'trinket', icon: 'scroll', rarity: 2, power: 18, weight: 1, value: 150 },
      { id: 'j', name: 'River Garnet', type: 'trinket', icon: 'gem', rarity: 1, power: 9, weight: 1, value: 110 },
      { id: 'k', name: 'Gatehouse Key', type: 'supply', icon: 'key', rarity: 1, power: 5, weight: 2, value: 20 },
      { id: 'l', name: 'War Banner', type: 'supply', icon: 'flag', rarity: 2, power: 25, weight: 12, value: 130 },
    ];
    type Item = (typeof items)[number];
    const equipped: Record<string, string> = { weapon: 'b', armour: 'f' };
    const grid = $('[data-grid]'), detail = $('[data-detail]');
    const sorters: Record<string, (a: Item, b: Item) => number> = {
      rarity: (a, b) => b.rarity - a.rarity || b.value - a.value,
      type: (a, b) => a.type.localeCompare(b.type) || b.rarity - a.rarity,
      value: (a, b) => b.value - a.value,
    };
    const slots = new Map<string, HTMLElement>();
    items.forEach(item => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'slot'; b.dataset.nav = ''; b.dataset.item = item.id; b.dataset.rarity = String(item.rarity);
      b.setAttribute('aria-label', `${item.name}, ${rarityName[item.rarity]} ${item.type}`);
      b.innerHTML = `<svg aria-hidden="true"><use href="#lab-i-${item.icon}"/></svg><i class="eq">E</i>`;
      b.addEventListener('focus', () => showItem(item));
      b.addEventListener('pointerenter', () => showItem(item));
      b.addEventListener('click', () => equip(item));
      slots.set(item.id, b);
    });
    const empties = Array.from({ length: 6 }, () => Object.assign(document.createElement('span'), { className: 'slot slot-empty' }));
    function sortBy(key: string, animate = true) {
      const first = new Map([...slots].map(([id, el]) => [id, el.getBoundingClientRect()]));
      grid.replaceChildren(...[...items].sort(sorters[key]).map(i => slots.get(i.id)!), ...empties);
      $$('[data-sort]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.sort === key)));
      markEquipped();
      if (!animate || calm) return;
      slots.forEach((el, id) => { // FLIP: measure, reorder, play the difference
        const a = first.get(id)!, b = el.getBoundingClientRect();
        if (a.left !== b.left || a.top !== b.top) el.animate({ transform: [`translate(${a.left - b.left}px, ${a.top - b.top}px)`, 'none'] }, { duration: 320, easing: 'cubic-bezier(.2,.7,.2,1)' });
      });
    }
    function markEquipped() { slots.forEach((el, id) => el.toggleAttribute('data-equipped', Object.values(equipped).includes(id))); }
    function showItem(item: Item) {
      if (detail.dataset.item === item.id) return;
      detail.dataset.item = item.id; detail.dataset.rarity = String(item.rarity);
      const worn = items.find(i => i.id === equipped[item.type]);
      const isWorn = worn?.id === item.id;
      const stat = (label: string, value: number, base: number | undefined, max: number, lowerBetter = false) => {
        const diff = base === undefined || isWorn ? 0 : value - base;
        const good = lowerBetter ? diff < 0 : diff > 0;
        return `<div class="stat"><span>${label}</span><div class="stat-bar"><i style="--v:${value / max}"></i></div><b>${value}</b><em class="${diff ? (good ? 'up' : 'down') : ''}">${diff ? (diff > 0 ? '+' : '−') + Math.abs(diff) : ''}</em></div>`;
      };
      detail.innerHTML = `<span class="ui-kicker">${rarityName[item.rarity]} ${item.type}</span><h4></h4>
        <div class="detail-icon"><svg aria-hidden="true"><use href="#lab-i-${item.icon}"/></svg></div>
        ${stat('Power', item.power, worn?.power, 60)}${stat('Weight', item.weight, worn?.weight, 60, true)}${stat('Value', item.value, worn?.value, 600)}
        <p class="detail-hint">${item.type === 'weapon' || item.type === 'armour' ? (isWorn ? 'Equipped' : `Compared with ${worn ? worn.name : 'nothing'}`) : 'Carried, not worn'}</p>`;
      detail.querySelector('h4')!.textContent = item.name;
    }
    function equip(item: Item) {
      if (item.type !== 'weapon' && item.type !== 'armour') return;
      equipped[item.type] = item.id;
      markEquipped(); detail.dataset.item = ''; showItem(item);
      if (!calm) slots.get(item.id)!.animate({ transform: ['scale(1)', 'scale(1.16)', 'scale(1)'] }, { duration: 320, easing: 'cubic-bezier(.34,1.56,.64,1)' });
    }
    $$('[data-sort]').forEach(b => b.addEventListener('click', () => sortBy(b.dataset.sort!)));
    sortBy('rarity', false); showItem(items[0]);

    /* ---------- motion tokens ---------- */
    function replayCurves() {
      $$('[data-curve]').forEach(card => {
        const ms = Number(card.dataset.ms), delay = Number(card.dataset.delay), easing = `cubic-bezier(${card.dataset.bez})`;
        // slowed four times so the shape of each curve is readable
        const timing: KeyframeAnimationOptions = { duration: ms * 4, delay: 200 + delay * 2, easing, fill: 'both' };
        card.querySelector('.motion-track i')!.animate({ left: ['0%', '100%'] }, timing);
        card.querySelector('.curve')!.animate({ strokeDashoffset: [1, 0] }, { ...timing, easing: 'linear' });
      });
    }
    $('[data-replay]').addEventListener('click', replayCurves);

    /* ---------- lifecycle ---------- */
    new IntersectionObserver(([entry]) => {
      const was = visible; visible = entry.isIntersecting;
      if (visible && !was) requestAnimationFrame(pollPad);
      if (visible && !calm && !(navigator as any).connection?.saveData) video.play().catch(() => {}); else video.pause();
    }, { threshold: 0.25 }).observe(stage);
    setView('hud', false);
  }
</script>

<style is:global>
