---
import { studios, brands, stats, credits, quotes, titles, eras, RESUME_URL, ARTSTATION_URL, RECOMMENDATIONS_URL } from '../../data/services-credits';
const lead = quotes.find(q => q.lead)!;
const rest = quotes.filter(q => !q.lead);
const thisYear = new Date().getFullYear();
const ago = (end: number) => (thisYear - end < 1 ? 'Current' : thisYear - end === 1 ? 'Last year' : `${thisYear - end} years ago`);

const { part } = Astro.props; // 'top' | 'credits' | 'quotes'
---
{part === 'top' && <Fragment>
<section class="cr-numbers" aria-label="By the numbers"><div class="container"><p class="cr-numbers-label">By the numbers <span>Each figure says where it comes from</span></p><div class="cr-numbers-grid">{stats.map(stat => <div><strong><b data-count={stat.n}>{stat.n.toLocaleString('en-US')}</b>{stat.suffix}</strong><span>{stat.label}</span><small>{stat.source}</small></div>)}</div></div></section>

<section class="cr-wall" aria-labelledby="cr-wall-title">
  <p class="container cr-wall-label" id="cr-wall-title"><b>Studios</b> Remi has worked inside, and <b>the names</b> his work has shipped for</p>
  <div class="cr-row" aria-hidden="true"><div>{[0, 1].map(() => <span>{studios.map(name => <i>{name}</i>)}</span>)}</div></div>
  <div class="cr-row reverse" aria-hidden="true"><div>{[0, 1].map(() => <span>{brands.map(name => <i>{name}</i>)}</span>)}</div></div>
  <p class="sr-only">Studios: {studios.join(', ')}. Clients and properties: {brands.join(', ')}.</p>
  <p class="container cr-wall-note">Career credits of Guillaume “Remi” Couture from studio roles and agency client work, as listed on his <a href={RESUME_URL} target="_blank" rel="noopener">résumé</a>. Names belong to their owners and do not imply endorsement.</p>
</section>
</Fragment>}

{part === 'credits' && <section class="section container" id="credits"><div class="section-heading"><div><p class="eyebrow">Shipped work</p><h2>Twenty years of<br>credits, in order.</h2></div><p>This is not a studio that started last year. The record below runs from today back to 2006: PC, console, mobile, VR, kids’ apps and the web. Open any title to see the screens.</p></div>
  <div class="cr-eras">{eras.map((era, e) => <div class="cr-era sv-reveal"><div class="cr-era-label"><strong>{era.years}</strong><span>{era.key}</span><em>{ago(era.end)}</em><small>{era.line}</small></div><div class="cr-era-body">{era.text && <p class="cr-era-text">{era.text}</p>}<div class="cr-titles is-in">{titles.map((item, i) => item.era === e && <button type="button" data-credit={i} aria-label={`${item.title}, ${item.studio}: open gallery`}><img src={item.src} alt="" loading="lazy" width="400" height="400"/><span><strong>{item.title}</strong><em>{item.role}</em></span><i aria-hidden="true">{item.images.length > 1 ? `${item.images.length} images` : 'View'}</i></button>)}</div></div></div>)}</div>
  <p class="cr-titles-note">Key art and UI from titles Remi worked on, oldest at the bottom. Some of it is {thisYear - 2009} years old and looks it; it is here because every one of these shipped a lesson that still applies. Artwork and trademarks belong to their respective owners.</p>
  <script type="application/json" id="cr-data" set:html={JSON.stringify(titles)}></script>
  <dialog class="cr-view" data-credit-view aria-label="Credit gallery">
    <div class="cr-view-bg" aria-hidden="true"></div>
    <div class="cr-view-body">
      <aside class="cr-view-info"><p class="cr-view-count" data-cv-count></p><h3 data-cv-title></h3><p class="cr-view-studio" data-cv-studio></p><p class="cr-view-role" data-cv-role></p><p class="cr-view-note" data-cv-note></p><div class="cr-view-thumbs" data-cv-thumbs></div></aside>
      <figure class="cr-view-stage"><img data-cv-image alt=""/><button type="button" class="cr-view-arrow prev" data-cv-prev aria-label="Previous image">←</button><button type="button" class="cr-view-arrow next" data-cv-next aria-label="Next image">→</button></figure>
    </div>
    <div class="cr-view-bar"><button type="button" data-cv-prev-title>← Previous title</button><span>← → images · ↑ ↓ titles · Esc to close</span><button type="button" data-cv-next-title>Next title →</button><button type="button" class="cr-view-close" data-cv-close>Close ✕</button></div>
  </dialog>
  <ol class="cr-list sv-reveal">{credits.map(row => <li><span class="yr">{row.years}</span><div class="what"><strong>{row.work}</strong><span>{row.studio}</span></div><div class="role"><strong>{row.role}</strong><span>{row.note}</span></div><span class="tag">{row.tag}</span></li>)}</ol>
  <p class="sv-work-foot">Full history on the <a class="cr-link" href={RESUME_URL} target="_blank" rel="noopener">résumé ↗</a> · All 57 pieces on <a class="cr-link" href={ARTSTATION_URL} target="_blank" rel="noopener">ArtStation ↗</a></p>
</section>}

{part === 'quotes' && <section class="section container" id="recommendations"><div class="section-heading"><div><p class="eyebrow">In their words</p><h2>From the people<br>who managed the work.</h2></div><p>Eleven of the recommendations on Remi’s LinkedIn, from art directors, producers, engineers and a client, 2015 to 2022.</p></div>
  <figure class="cr-lead sv-reveal"><blockquote>“{lead.text}”</blockquote><figcaption><a href={lead.url} target="_blank" rel="noopener">{lead.name} ↗</a><span>{lead.relation} · {lead.date}</span></figcaption></figure>
  <div class="cr-quotes">{rest.map(q => <figure class="sv-reveal"><blockquote>“{q.text}”</blockquote><figcaption><a href={q.url} target="_blank" rel="noopener">{q.name} ↗</a><span>{q.relation} · {q.date}</span></figcaption></figure>)}</div>
  <p class="sv-work-foot"><a class="cr-link" href={RECOMMENDATIONS_URL} target="_blank" rel="noopener">Read the full recommendations on LinkedIn ↗</a></p>
</section>}

<script>
  // Count the figures up once, when the band scrolls into view.
  const band = document.querySelector('.cr-numbers');
  if (band && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const counters = [...band.querySelectorAll<HTMLElement>('[data-count]')];
    counters.forEach(el => { el.textContent = '0'; });
    new IntersectionObserver((entries, io) => {
      if (!entries[0].isIntersecting) return;
      io.disconnect();
      counters.forEach((el, i) => {
        const target = Number(el.dataset.count), start = performance.now() + i * 90, span = 1100;
        const tick = (now: number) => {
          const t = Math.min(1, Math.max(0, (now - start) / span)), eased = 1 - Math.pow(1 - t, 3);
          el.textContent = Math.round(target * eased).toLocaleString('en-US');
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.35 }).observe(band);
  }
</script>

<script>
  type Title = { title: string; studio: string; role: string; note: string; images: string[] };
  const dataEl = document.getElementById('cr-data');
  const view = document.querySelector<HTMLDialogElement>('[data-credit-view]');
  if (dataEl && view) {
    const list: Title[] = JSON.parse(dataEl.textContent || '[]');
    const q = <T extends HTMLElement>(sel: string) => view.querySelector<T>(sel)!;
    const image = q<HTMLImageElement>('[data-cv-image]'), thumbs = q('[data-cv-thumbs]'), bg = q('.cr-view-bg');
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let at = 0, shot = 0, fx = 0;
    const wipes = ['polygon(0 0,0 0,-30% 100%,-30% 100%)', 'circle(0% at 50% 50%)', 'inset(0 50% 0 50%)', 'inset(100% 0 0 0)'];
    const ends = ['polygon(0 0,130% 0,100% 100%,-30% 100%)', 'circle(85% at 50% 50%)', 'inset(0 0 0 0)', 'inset(0 0 0 0)'];
    function showImage(n: number) {
      const item = list[at]; shot = (n + item.images.length) % item.images.length;
      image.src = item.images[shot]; image.alt = `${item.title}, image ${shot + 1} of ${item.images.length}`;
      bg.style.backgroundImage = `url("${item.images[shot]}")`;
      if (!calm) { fx = (fx + 1) % wipes.length; image.animate([{ clipPath: wipes[fx], transform: 'scale(1.08)', filter: 'brightness(1.5)' }, { clipPath: ends[fx], transform: 'scale(1)', filter: 'none' }], { duration: 620, easing: 'cubic-bezier(.75,0,.15,1)' }); }
      [...thumbs.children].forEach((el, i) => el.setAttribute('aria-pressed', String(i === shot)));
      view.querySelectorAll<HTMLElement>('.cr-view-arrow').forEach(el => { el.hidden = item.images.length < 2; });
    }
    function showTitle(n: number) {
      at = (n + list.length) % list.length; const item = list[at];
      q('[data-cv-count]').textContent = `${String(at + 1).padStart(2, '0')} / ${list.length}`;
      q('[data-cv-title]').textContent = item.title;
      const end = Number('20' + (item.studio.match(/(\d\d)$/)?.[1] || '26'));
      const years = new Date().getFullYear() - end;
      q('[data-cv-studio]').textContent = `${item.studio} · ${years < 2 ? 'last year' : years + ' years ago'}`;
      q('[data-cv-role]').textContent = item.role; q('[data-cv-note]').textContent = item.note;
      thumbs.replaceChildren(...item.images.map((src, i) => { const b = document.createElement('button'); b.type = 'button'; b.setAttribute('aria-label', `Image ${i + 1}`); b.innerHTML = '<img alt="" loading="lazy">'; (b.firstChild as HTMLImageElement).src = src; b.addEventListener('click', () => showImage(i)); return b; }));
      thumbs.hidden = item.images.length < 2;
      if (!calm) view.querySelector('.cr-view-info')!.animate([{ opacity: 0, transform: 'translateX(-18px)' }, { opacity: 1, transform: 'none' }], { duration: 420, easing: 'cubic-bezier(.2,.7,.2,1)' });
      showImage(0);
    }
    document.querySelectorAll<HTMLElement>('[data-credit]').forEach(tile => tile.addEventListener('click', () => { showTitle(Number(tile.dataset.credit)); view.showModal(); }));
    q('[data-cv-prev]').addEventListener('click', () => showImage(shot - 1)); q('[data-cv-next]').addEventListener('click', () => showImage(shot + 1));
    q('[data-cv-prev-title]').addEventListener('click', () => showTitle(at - 1)); q('[data-cv-next-title]').addEventListener('click', () => showTitle(at + 1));
    q('[data-cv-close]').addEventListener('click', () => view.close());
    view.addEventListener('click', event => { if (event.target === view) view.close(); });
    view.addEventListener('keydown', event => {
      const moves: Record<string, () => void> = { ArrowRight: () => showImage(shot + 1), ArrowLeft: () => showImage(shot - 1), ArrowDown: () => showTitle(at + 1), ArrowUp: () => showTitle(at - 1) };
      if (moves[event.key]) { event.preventDefault(); moves[event.key](); }
    });
    // tiles lean toward the pointer
    if (!calm && matchMedia('(hover:hover)').matches) document.querySelectorAll<HTMLElement>('[data-credit]').forEach(tile => {
      tile.addEventListener('pointermove', event => { const r = tile.getBoundingClientRect(); tile.style.setProperty('--rx', `${((event.clientY - r.top) / r.height - 0.5) * -16}deg`); tile.style.setProperty('--ry', `${((event.clientX - r.left) / r.width - 0.5) * 16}deg`); tile.style.setProperty('--gx', `${((event.clientX - r.left) / r.width) * 100}%`); tile.style.setProperty('--gy', `${((event.clientY - r.top) / r.height) * 100}%`); });
      tile.addEventListener('pointerleave', () => { tile.style.removeProperty('--rx'); tile.style.removeProperty('--ry'); });
    });
  }
</script>

<style is:global>
  .cr-numbers{border-block:1px solid var(--line);background:var(--surface);padding-block:34px 10px}
  .cr-numbers-label{display:flex;gap:16px;align-items:baseline;font:500 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:8px}
  .cr-numbers-label span{color:var(--muted);letter-spacing:.04em;text-transform:none}
  .cr-numbers-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
  .cr-numbers-grid>div{padding:26px 26px 28px 0;border-top:1px solid var(--line);display:grid;gap:8px;align-content:start}
  .cr-numbers-grid>div:nth-child(-n+4){border-top:0}
  .cr-numbers-grid>div:not(:nth-child(4n+1)){padding-left:26px;border-left:1px solid var(--line)}
  .cr-numbers-grid strong{font:600 clamp(30px,3.3vw,50px)/1 Manrope,sans-serif;letter-spacing:-.055em;color:var(--ink);font-variant-numeric:tabular-nums}
  .cr-numbers-grid strong b{font-weight:600;color:var(--accent)}
  .cr-numbers-grid span{font-size:14.5px;line-height:1.45;color:var(--ink)}
  .cr-numbers-grid small{font:400 11px/1.5 var(--mono);color:var(--muted)}
  @media(max-width:900px){.cr-numbers-grid{grid-template-columns:1fr 1fr}.cr-numbers-grid>div{padding:20px 16px 22px 0!important;border-left:0!important;border-top:1px solid var(--line)!important}.cr-numbers-grid>div:nth-child(-n+2){border-top:0!important}.cr-numbers-grid>div:nth-child(even){padding-left:16px!important;border-left:1px solid var(--line)!important}}
  .cr-wall{padding-block:46px 40px;border-bottom:1px solid var(--line);overflow:hidden}
  .cr-wall-label{font:500 11px/1.6 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:26px}
  .cr-wall-label b{color:var(--ink);font-weight:500}
  .cr-row{overflow:hidden;-webkit-mask:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
  .cr-row>div{display:flex;width:max-content;animation:sv-marquee 70s linear infinite}
  .cr-row.reverse>div{animation-direction:reverse;animation-duration:84s}
  .cr-row span{display:flex}
  .cr-row i{font:700 clamp(26px,3.3vw,48px)/1.25 Manrope,sans-serif;font-style:normal;letter-spacing:-.045em;white-space:nowrap;color:var(--ink);padding-inline:.55em;position:relative}
  .cr-row i::after{content:'';position:absolute;right:-.12em;top:50%;width:.16em;height:.16em;background:var(--accent);transform:rotate(45deg)}
  .cr-row.reverse i{color:transparent;-webkit-text-stroke:1px #7d8a76}
  .cr-wall:hover .cr-row>div{animation-play-state:paused}
  .cr-wall-note{font-size:12px;color:var(--muted);margin-top:26px;max-width:760px;line-height:1.7}
  .cr-wall-note a,.cr-link{color:var(--accent);font-weight:600}.cr-wall-note a:hover,.cr-link:hover{text-decoration:underline;text-underline-offset:4px}
  @media(prefers-reduced-motion:reduce){.cr-row>div{animation:none;flex-wrap:wrap;width:auto}.cr-row span+span{display:none}}

  .cr-titles{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:10px}
  .cr-titles{perspective:1100px}
  .cr-titles button{position:relative;display:block;width:100%;padding:0;aspect-ratio:1;border-radius:12px;overflow:hidden;border:1px solid var(--line);background:#080a08;cursor:pointer;transform-style:preserve-3d;will-change:transform}
  .cr-titles.is-in button{transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .18s ease-out,opacity .5s var(--stagger,0ms),border-color .2s}
  .cr-titles button:is(:hover,:focus-visible){border-color:var(--accent);z-index:2;box-shadow:0 22px 50px -18px rgba(0,0,0,.9),0 0 0 1px var(--accent)}
  .cr-titles button::after{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at var(--gx,50%) var(--gy,50%),rgba(255,255,255,.28),transparent 45%);opacity:0;transition:opacity .2s}
  .cr-titles button:hover::after{opacity:1}
  .cr-titles button>i{position:absolute;right:8px;top:8px;font:500 9.5px/1 var(--mono);font-style:normal;letter-spacing:.05em;text-transform:uppercase;padding:6px 8px;border-radius:20px;background:var(--accent);color:#0c1408;opacity:0;transform:translateY(-6px);transition:opacity .2s,transform .25s cubic-bezier(.34,1.56,.64,1)}
  .cr-titles button:is(:hover,:focus-visible)>i{opacity:1;transform:none}
  .cr-titles span{text-align:left}
  .cr-view{border:0;padding:0;margin:0;width:100vw;height:100dvh;max-width:none;max-height:none;background:#070907;color:#eef1e6;overflow:hidden}
  .cr-view[open]{display:grid;grid-template-rows:minmax(0,1fr) auto;animation:cr-open .35s cubic-bezier(.2,.7,.2,1)}
  @keyframes cr-open{from{opacity:0;transform:scale(1.03)}}
  .cr-view-bg{position:absolute;inset:-60px;background-size:cover;background-position:center;filter:blur(46px) saturate(1.3) brightness(.36);transition:background-image .5s;z-index:0}
  .cr-view-body{position:relative;z-index:1;display:grid;grid-template-columns:minmax(280px,380px) minmax(0,1fr);gap:40px;padding:48px 48px 24px;min-height:0}
  .cr-view-info{display:flex;flex-direction:column;justify-content:center;min-width:0}
  .cr-view-count{font:500 11px/1 'JetBrains Mono',monospace;letter-spacing:.14em;color:#c6f27a;margin:0 0 18px}
  .cr-view-info h3{font:600 clamp(30px,3.4vw,52px)/1.02 Manrope,sans-serif;letter-spacing:-.055em;color:#eef1e6;margin:0}
  .cr-view-studio{font:500 11px/1.5 'JetBrains Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:#c6f27a;margin:20px 0 0}
  .cr-view-role{font:600 16px/1.4 Manrope,sans-serif;color:#eef1e6;margin:6px 0 0}
  .cr-view-note{font-size:15px;line-height:1.7;color:#b6bead;margin:18px 0 0}
  .cr-view-thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:28px;max-height:34vh;overflow:auto;padding-right:4px}
  .cr-view-thumbs[hidden]{display:none}
  .cr-view-thumbs button{padding:0;border:1px solid rgba(238,241,230,.2);border-radius:7px;overflow:hidden;background:#000;opacity:.5;cursor:pointer;transition:opacity .2s,border-color .2s}
  .cr-view-thumbs button[aria-pressed=true]{opacity:1;border-color:#c6f27a}
  .cr-view-thumbs img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}
  .cr-view-stage{position:relative;margin:0;min-width:0;min-height:0;display:grid;place-items:center}
  .cr-view-stage img{max-width:100%;max-height:100%;object-fit:contain;border-radius:12px;box-shadow:0 40px 120px -30px #000;min-height:0}
  .cr-view-arrow{position:absolute;top:50%;width:46px;height:46px;margin-top:-23px;border-radius:50%;border:1px solid rgba(238,241,230,.3);background:rgba(8,10,8,.7);backdrop-filter:blur(8px);color:#eef1e6;font-size:18px;cursor:pointer}
  .cr-view-arrow.prev{left:10px}.cr-view-arrow.next{right:10px}.cr-view-arrow[hidden]{display:none}
  .cr-view-arrow:hover,.cr-view-bar button:hover{border-color:#c6f27a;color:#c6f27a}
  .cr-view-bar{position:relative;z-index:1;display:flex;align-items:center;gap:10px;padding:14px 48px 22px}
  .cr-view-bar span{flex:1;text-align:center;font:400 11px/1 'JetBrains Mono',monospace;color:#9ba494}
  .cr-view-bar button{border:1px solid rgba(238,241,230,.22);background:rgba(13,17,14,.7);color:#eef1e6;font:600 12px/1 'DM Sans',sans-serif;padding:11px 15px;border-radius:7px;cursor:pointer;white-space:nowrap}
  @media(max-width:860px){.cr-view{overflow:auto}.cr-view-body{grid-template-columns:1fr;gap:20px;padding:20px 18px 10px}.cr-view-stage{order:-1}.cr-view-stage img{max-height:46vh}.cr-view-bar{padding:10px 18px 18px;flex-wrap:wrap}.cr-view-bar span{display:none}.cr-view-info h3{font-size:28px}}
  .cr-titles img{width:100%;height:100%;object-fit:cover;transition:transform .5s cubic-bezier(.2,.7,.2,1),filter .3s}
  .cr-titles span{position:absolute;inset:auto 0 0;padding:26px 10px 10px;background:linear-gradient(transparent,rgba(5,7,5,.94));display:grid;gap:2px;opacity:0;transform:translateY(8px);transition:opacity .25s,transform .25s}
  .cr-titles strong{font:600 12px/1.25 Manrope,sans-serif;color:#eef1e6}
  .cr-titles em{font:400 9.5px/1.3 var(--mono);font-style:normal;color:var(--accent);letter-spacing:.04em;text-transform:uppercase}
  .cr-titles button:is(:hover,:focus-visible) img{transform:scale(1.07)}
  .cr-titles button:is(:hover,:focus-visible) span{opacity:1;transform:none}
  .cr-titles:hover a:not(:hover) img{filter:brightness(.55) saturate(.7)}
  .cr-titles-note{font-size:12px;color:var(--muted);margin:16px 0 44px}
  @media(max-width:1100px){.cr-titles{grid-template-columns:repeat(6,minmax(0,1fr))}}
  @media(max-width:700px){.cr-titles{grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}.cr-titles span{display:none}}
  @media(hover:none){.cr-titles span{opacity:1;transform:none}}
  .cr-eras{display:grid;gap:0;border-top:1px solid var(--line)}
  .cr-era{display:grid;grid-template-columns:190px minmax(0,1fr);gap:26px;padding:22px 0;border-bottom:1px solid var(--line);align-items:start}
  .cr-era-label{display:grid;gap:5px;position:sticky;top:110px}
  .cr-era-label strong{font:600 clamp(26px,2.5vw,36px)/1 Manrope,sans-serif;letter-spacing:-.05em;color:var(--ink)}
  .cr-era-label span{font:600 14px/1.3 Manrope,sans-serif;color:var(--ink)}
  .cr-era-label em{font:500 11px/1 var(--mono);font-style:normal;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);margin-top:4px}
  .cr-era-label small{font:400 11px/1.5 var(--mono);color:var(--muted)}
  .cr-era-body{display:grid;gap:14px;min-width:0}
  .cr-era-text{font-size:14.5px;line-height:1.65;max-width:720px;color:var(--muted)}
  .cr-era .cr-titles:empty{display:none}
  .cr-era .cr-titles{grid-template-columns:repeat(auto-fill,minmax(128px,1fr))}
  .cr-era .cr-titles button{opacity:1}
  @media(max-width:760px){.cr-era{grid-template-columns:1fr;gap:14px}.cr-era-label{position:static;grid-template-columns:auto auto 1fr;align-items:baseline;gap:10px}.cr-era-label small{display:none}.cr-era .cr-titles{grid-template-columns:repeat(4,minmax(0,1fr))}}
  .cr-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
  .cr-list li{display:grid;grid-template-columns:110px minmax(0,1.5fr) minmax(0,1.2fr) 210px;gap:10px 28px;align-items:baseline;padding:22px 14px;border-bottom:1px solid var(--line);transition:background .2s,padding .25s cubic-bezier(.2,.7,.2,1)}
  .cr-list li:hover{background:var(--surface);padding-left:24px}
  .cr-list .yr{font:500 12px/1.4 var(--mono);color:var(--accent);letter-spacing:.04em}
