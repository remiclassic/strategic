---
import StudioLayout from '../../layouts/StudioLayout.astro';
import CaseCard from '../../components/b/CaseCard.astro';
import CtaBand from '../../components/b/CtaBand.astro';
import { cases, line, pkg, type Case } from '../../data/studio';
import { workCases } from '../../data/work-case-studies';
import '../../styles/boutique.css';
export function getStaticPaths() { return cases.map(c => ({ params: { slug: c.slug }, props: { c } })); }
const { c } = Astro.props as { c: Case };
const l = line(c.line);
const extra = workCases.find(w => w.slug === c.slug);
const next = cases.filter(x => x.slug !== c.slug && x.line === c.line).slice(0, 2);
const more = next.length < 2 ? [...next, ...cases.filter(x => x.slug !== c.slug && !next.includes(x)).slice(0, 2 - next.length)] : next;
const start = pkg(l.packages[0]);
const provenance = c.kind === 'Client work'
  ? `From Remi Couture’s career at or for ${c.client}. Shown as founder experience; it does not imply ${c.client} is a Strategic Sloth client. Artwork and trademarks belong to their owners.`
  : c.kind === 'Concept' ? 'An independent concept study, not commissioned.' : 'Designed, built and published by Strategic Sloth LLC.';
---
<StudioLayout title={`${c.title} — Work | Strategic Sloth`} description={c.summary}>
<section class="b-intro night"><div class="container">
  <a class="text-link" style="color:#c9cfc3" href="/work/">← All work</a>
  <p class="eyebrow" style="margin-top:28px">{c.kind.toUpperCase()} · {l.name.toUpperCase()}</p>
  <h1>{c.title}</h1>
  <p class="lede">{c.summary}</p>
</div></section>
<section class="b-night" style="padding-bottom:70px"><div class="container">
  {c.video
    ? <video controls playsinline preload="metadata" poster={c.poster} class="b-case-hero"><source src={c.video} type="video/mp4"/></video>
    : <img src={c.poster} alt={c.gallery[0]?.[1] ?? c.title} class="b-case-hero"/>}
</div></section>

<section class="container" style="padding-top:50px">
  <div class="b-facts"><div><span>Client</span><strong>{c.client}</strong></div><div><span>Years</span><strong>{c.years}</strong></div><div><span>Role</span><strong>{c.role}</strong></div><div><span>Service</span><strong><a href={l.slug}>{l.name} →</a></strong></div></div>
</section>

<section class="b-section tight container">
  <div class="b-csb"><div><h3>The challenge</h3><p>{c.challenge}</p></div><div><h3>The approach</h3><p>{c.approach}</p></div><div><h3>The result</h3><p>{c.result}</p></div></div>
  <div class="b-tags">{c.tags.map(t => <span>{t}</span>)}</div>
  {c.links && <div class="b-hero-actions">{c.links.map(([t, h]) => <a class="text-link" href={h} target={h.startsWith('http') ? '_blank' : undefined} rel={h.startsWith('http') ? 'noopener' : undefined}>{t} <span>↗</span></a>)}</div>}
</section>

{extra && <section class="b-sage b-section tight"><div class="container">
  <div class="b-head"><div><p class="eyebrow">HOW IT CAME TOGETHER</p><h2>The process.</h2></div><p>{extra.decision}</p></div>
  <ol class="b-steps b-steps-3">{extra.process.map(([t, b]) => <li><h3>{t}</h3><p>{b}</p></li>)}</ol>
</div></section>}

{c.gallery.length > 0 && <section class="b-section tight container">
  <div class="b-head"><div><p class="eyebrow">SCREENS</p><h2>From the work.</h2></div><p>{c.kind === 'Client work' ? 'Screens from the project as delivered.' : 'Captures of the real build.'}</p></div>
  <div class:list={['b-gallery', c.portrait && 'portrait']}>{c.gallery.map(([src, alt]) => <figure><img src={src} alt={alt} loading="lazy"/><figcaption>{alt}</figcaption></figure>)}</div>
  <p class="b-note">{provenance}</p>
</section>}
{c.gallery.length === 0 && <section class="container"><p class="b-note" style="margin-bottom:50px">{provenance}</p></section>}

<section class="b-sage b-section tight"><div class="container">
  <div class="b-rate b-rate-card"><div><p class="eyebrow" style="margin-bottom:6px">WANT SOMETHING LIKE THIS?</p><strong>{start.from ? 'From ' : ''}{start.price}</strong> <span>{start.name}</span></div><p>{start.summary}</p><a class="button" href={`/contact/?engagement=${start.id}#enquiry`}>Start a project <span>↗</span></a></div>
  <p class="eyebrow" style="margin:70px 0 30px">MORE WORK</p>
  <div class="b-cases two">{more.map(m => <CaseCard c={m} />)}</div>
</div></section>
<CtaBand />
</StudioLayout>
