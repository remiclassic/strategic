---
import Faq from './b/Faq.astro';
import {
  autoCopy, autoPaths, switcherFor, regionLinkFor, regionOf, regionConfig, formatMoney, approxUsd, whatsappHref,
  type AutoLocale, type PlanId,
} from '../data/whatsapp-autoreply';

const { loc } = Astro.props as { loc: AutoLocale };
const t = autoCopy[loc];
const region = regionOf(loc);
const cfg = regionConfig(region);
const paths = autoPaths(loc);
const api = (import.meta.env.PUBLIC_AUTOREPLY_API ?? '').replace(/\/$/, '');
const checkoutAction = `${api}/api/autoreply/checkout`;
const waHref = whatsappHref(import.meta.env.WHATSAPP_NUMBER ?? process.env.WHATSAPP_NUMBER, t.whatsappText);
const waExternal = waHref.startsWith('https://');
const pilot = cfg.pilot;
const pilotOpen = pilot.spotsLeft > 0;
const spots = t.pilotSpots.replace('{left}', String(pilot.spotsLeft)).replace('{total}', String(pilot.spotsTotal));
const money = (n: number) => formatMoney(n, loc);
---
<section class="b-intro night ar-hero">
  <div class="container">
    <div class="ar-top">
      <p class="eyebrow"><span class="live-dot" style="background:var(--gold)"></span> {t.eyebrow}</p>
      <nav class="ar-langs" aria-label={region === 'ca' ? 'Langue / Language' : 'Idioma / Language'}>
        {switcherFor(loc).map(s => (
          <a href={autoPaths(s.loc).page} hreflang={s.loc === 'en-CA' ? 'en-CA' : s.loc} lang={s.loc === 'en-CA' ? 'en' : s.loc} aria-current={s.loc === loc ? 'page' : undefined}>{s.label}</a>
        ))}
      </nav>
    </div>
    <h1>{t.h1[0]} <em>{t.h1[1]}</em></h1>
    <p class="lede">{t.lede}</p>
    <ul class="ar-chips">{t.channels.map(c => <li>{c}</li>)}</ul>
    <div class="b-hero-actions">
      <a class="button gold" href="#plans" data-track="service_cta" data-track-location={`autoreply-${loc}-hero`}>{t.heroCta} <span aria-hidden="true">↓</span></a>
      <a class="button outline-light" href={waHref} rel={waExternal ? 'noopener' : undefined} target={waExternal ? '_blank' : undefined} data-track="whatsapp_click" data-track-location={`autoreply-${loc}-hero`}>{t.whatsappCta} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="b-facts ar-facts">{t.facts.map(([n, l]) => <div><span>{n}</span><strong>{l}</strong></div>)}</div>
  </div>
</section>

<section class="b-section container" id="how">
  <div class="b-head">
    <div>
      <p class="eyebrow">{t.stepsEyebrow}</p>
      <h2>{t.stepsTitle[0]}<br><em>{t.stepsTitle[1]}</em></h2>
    </div>
    <p>{t.stepsIntro}</p>
  </div>
  <ol class="b-steps ar-steps">
    {t.steps.map(([title, body, note]) => <li><h3>{title}</h3><p>{body}</p><small>{note}</small></li>)}
  </ol>
</section>

<section class="b-sage b-section" id="who">
  <div class="container">
    <div class="b-head">
      <div>
        <p class="eyebrow">{t.whoEyebrow}</p>
        <h2>{t.whoTitle[0]}<br><em>{t.whoTitle[1]}</em></h2>
      </div>
      <p>{t.whoIntro}</p>
    </div>
    <ul class="b-list b-list-3 ar-who">
      {t.who.map(([name, body]) => <li><strong>{name}</strong><span>{body}</span></li>)}
    </ul>
  </div>
</section>

<section class="b-section container" id="plans">
  <div class="b-head">
    <div>
      <p class="eyebrow">{t.pricingEyebrow}</p>
      <h2>{t.pricingTitle[0]}<br><em>{t.pricingTitle[1]}</em></h2>
    </div>
    <p>{t.pricingIntro}</p>
  </div>

  {pilotOpen && (
    <form class="ar-pilot" method="post" action={checkoutAction} data-checkout>
      <div>
        <p class="eyebrow">{t.pilotFlag}</p>
        <h3>{t.pilotTitle}</h3>
        <p>{t.pilotBody}</p>
      </div>
      <div class="ar-pilot-act">
        <p class="ar-spots" aria-live="polite"><span class="ar-spots-bar" aria-hidden="true">{Array.from({ length: pilot.spotsTotal }, (_, i) => <i class={i < pilot.spotsTotal - pilot.spotsLeft ? 'taken' : undefined}></i>)}</span>{spots}</p>
        <input type="hidden" name="locale" value={loc}/>
        <input type="hidden" name="plan" value={pilot.plan}/>
        <input type="hidden" name="pilot" value="1"/>
        <button class="button gold" type="submit" data-track="checkout_start" data-track-location={`autoreply-${loc}-pilot`}>{t.pilotCta} <span aria-hidden="true">→</span></button>
      </div>
    </form>
  )}

  <div class="b-packages ar-plans">
    {cfg.plans.map(plan => {
      const p = t.plans[plan.id as PlanId];
      return (
        <article class:list={['b-pkg', plan.featured && 'featured']} aria-labelledby={`plan-${plan.id}`}>
          {plan.featured && <span class="b-flag">{t.popular}</span>}
          <h3 id={`plan-${plan.id}`}>{p.name}</h3>
          <p>{p.blurb}</p>
          <div class="b-price"><strong>{money(plan.monthly)}</strong><span>{t.perMonth}</span></div>
          {region === 'mx' && <p class="ar-usd">{t.approxLabel} {approxUsd(plan.monthly)}{t.perMonth}</p>}
          <p class="ar-setup">+ {money(plan.setup)} {t.setupLabel}{region === 'mx' && <span> ({t.approxLabel} {approxUsd(plan.setup)})</span>}</p>
          {t.taxesNote && <p class="ar-tax">{t.taxesNote}</p>}
          <ul>{p.features.map(f => <li>{f}</li>)}</ul>
          <form method="post" action={checkoutAction} data-checkout class="ar-buy">
            <input type="hidden" name="locale" value={loc}/>
            <input type="hidden" name="plan" value={plan.id}/>
            <button class="button" type="submit" data-track="checkout_start" data-track-location={`autoreply-${loc}-${plan.id}`}>{t.buyCta} {p.name} <span aria-hidden="true">→</span></button>
            {cfg.oxxo && t.oxxoCta && (
              <button class="ar-oxxo" type="submit" name="method" value="oxxo" data-track="checkout_start" data-track-location={`autoreply-${loc}-${plan.id}-oxxo`}>{t.oxxoCta}</button>
            )}
          </form>
        </article>
      );
    })}
  </div>
  <p class="b-note">{t.checkoutNote} {cfg.oxxo && t.oxxoNote} <a href={paths.terms}>{t.legalTerms}</a> · <a href={paths.privacy}>{t.legalPrivacy}</a></p>
  <p class="ar-error" role="alert" hidden data-checkout-error>{t.checkoutError}</p>

  <div class="ar-extra">
    <section class="ar-box" aria-labelledby="ar-extra-title">
      <h3 id="ar-extra-title">{t.extraTitle}</h3>
      {t.extra.map(p => <p>{p}</p>)}
      <p class="ar-links">{t.extraLinks.map(([label, href]) => <a href={href} target="_blank" rel="noopener noreferrer">{label} <span aria-hidden="true">↗</span></a>)}</p>
    </section>
    <section class="ar-box ar-honest" aria-labelledby="ar-honest-title">
      <h3 id="ar-honest-title">{t.honestTitle}</h3>
      <ul>{t.honest.map(([h, b]) => <li><strong>{h}</strong><span>{b}</span></li>)}</ul>
    </section>
  </div>
</section>

<Faq items={t.faq} title={t.faqTitle} eyebrow={t.faqEyebrow} />

<section class="b-cta" id="contact">
  <div class="container">
    <div>
      <p class="eyebrow">{t.closeEyebrow}</p>
      <h2>{t.closeTitle[0]}<br><em>{t.closeTitle[1]}</em></h2>
    </div>
    <div>
      <p>{t.closeBody}</p>
      <div class="b-hero-actions" style="margin-top:0">
        <a class="button gold" href={waHref} rel={waExternal ? 'noopener' : undefined} target={waExternal ? '_blank' : undefined} data-track="whatsapp_click" data-track-location={`autoreply-${loc}-close`}>{t.whatsappCta} <span aria-hidden="true">↗</span></a>
        <a class="button outline-light" href="#plans">{t.closeCta}</a>
      </div>
      <p class="ar-region"><a href={regionLinkFor(loc).href}>{regionLinkFor(loc).label} <span aria-hidden="true">→</span></a></p>
    </div>
  </div>
</section>

<a class="ar-float" href={waHref} rel={waExternal ? 'noopener' : undefined} target={waExternal ? '_blank' : undefined} aria-label={t.whatsappCta} data-track="whatsapp_click" data-track-location={`autoreply-${loc}-float`}>
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
</a>

<script>
  // Progressive enhancement: post as fetch so we can show a friendly error instead of a raw API page.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-checkout]')) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
      const data = new FormData(form, submitter);
      const error = document.querySelector<HTMLElement>('[data-checkout-error]');
      form.querySelectorAll('button').forEach(b => (b.disabled = true));
      try {
        const res = await fetch(form.action, { method: 'POST', body: new URLSearchParams(data as any), headers: { Accept: 'application/json' } });
        const body = await res.json().catch(() => ({}));
        if (!res.ok || !body.url) throw new Error(body.error || 'checkout_failed');
        location.assign(body.url);
      } catch {
        if (error) { error.hidden = false; error.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
        form.querySelectorAll('button').forEach(b => (b.disabled = false));
      }
    });
  }
</script>

<style>
.ar-hero{padding-block:88px 70px}
.ar-hero h1{max-width:15ch}
.ar-top{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
.ar-top .eyebrow{margin:0;display:flex;align-items:center;gap:8px}
.ar-langs{display:flex;flex-wrap:wrap;gap:8px}
.ar-langs a{font-size:13px;font-weight:600;padding:8px 16px;min-height:40px;display:inline-flex;align-items:center;border:1px solid #ffffff40;border-radius:30px;color:#e3e6dc}
.ar-langs a:hover,.ar-langs a[aria-current=page]{background:var(--gold);border-color:var(--gold);color:#16130c}
.ar-chips{list-style:none;padding:0;margin:28px 0 0;display:flex;flex-wrap:wrap;gap:8px}
.ar-chips li{padding:6px 12px;border-radius:30px;background:#ffffff14;color:#e3e6dc;font-size:12px;font-weight:600}
.ar-facts{margin-top:48px;border-color:#ffffff26}
.ar-hero .b-facts span{color:#c9cfc3}
.ar-hero .b-facts strong{color:#fff}
.ar-hero .b-facts div+div{border-left-color:#ffffff26}
.ar-who li{padding:20px 0}
.ar-pilot{display:grid;grid-template-columns:1.4fr 1fr;gap:20px 40px;align-items:center;margin-bottom:34px;padding:28px;border-radius:var(--b-radius);background:var(--night);color:#f2f1ea}
.ar-pilot .eyebrow{color:var(--gold);margin-bottom:10px}
.ar-pilot h3{color:#fff;font-size:clamp(20px,2.2vw,28px);line-height:1.25;letter-spacing:-.03em}
.ar-pilot p{color:#c9cfc3;font-size:14px;margin-top:8px}
.ar-pilot-act{display:grid;gap:14px;justify-items:start}
.ar-spots{display:flex;align-items:center;gap:12px;font-weight:600;color:#fff!important;margin:0!important}
.ar-spots-bar{display:inline-flex;gap:4px}
.ar-spots-bar i{width:22px;height:8px;border-radius:4px;background:var(--gold)}
.ar-spots-bar i.taken{background:#ffffff33}
.ar-plans .b-price{margin-top:14px}
.ar-usd,.ar-tax{font-size:12px;color:var(--muted);margin:0}
.ar-setup{font-size:14px;font-weight:600;margin:10px 0 2px}
.ar-setup span{font-weight:400;color:var(--muted);font-size:12px}
.ar-buy{margin-top:auto;display:grid;gap:10px}
.ar-buy .button{width:100%;justify-content:space-between;min-height:48px}
.ar-plans .b-pkg.featured .ar-buy .button{background:var(--ink);color:#fff;border-color:var(--ink)}
.ar-oxxo{background:none;border:0;padding:8px 0;min-height:44px;font-size:13px;font-weight:600;text-decoration:underline;text-underline-offset:4px;color:var(--ink);cursor:pointer;text-align:left}
.ar-buy button:disabled{opacity:.6;cursor:progress}
.ar-error{margin-top:12px;padding:12px 16px;border-radius:10px;background:#fbe9e4;color:#7a2a17;font-size:14px}
.ar-extra{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:40px}
.ar-box{padding:26px 28px;border-radius:var(--b-radius);border:1px dashed #b9bfae;background:#fbfaf5}
.ar-box h3{font-size:20px;margin-bottom:12px}
.ar-box p{font-size:14px;line-height:1.75;margin-top:10px}
.ar-links{display:flex;flex-direction:column;gap:6px}
.ar-links a,.b-note a{text-decoration:underline;text-underline-offset:3px}
.ar-honest ul{list-style:none;padding:0;margin:0;display:grid;gap:14px}
.ar-honest li{display:grid;gap:2px;font-size:14px;line-height:1.6}
.ar-honest li span{color:var(--muted)}
.ar-region{margin-top:22px!important;font-size:14px}
.ar-region a{color:#fff;text-decoration:underline;text-underline-offset:4px}
.ar-float{position:fixed;right:16px;bottom:16px;z-index:60;width:56px;height:56px;border-radius:50%;display:grid;place-items:center;background:#1f8f4e;color:#fff;box-shadow:0 10px 30px #0004}
.ar-float:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
@media(max-width:800px){
  .ar-hero{padding-block:48px 40px}
  /* Always stack: whether the pills fit beside the eyebrow depends on the web font, which caused a layout shift. */
  .ar-top{flex-direction:column;align-items:flex-start;gap:14px}
  .ar-hero .b-facts div:nth-child(n+3){border-top-color:#ffffff26}
  .ar-pilot,.ar-extra{grid-template-columns:1fr}
  .ar-pilot{padding:22px}
  .ar-pilot-act,.ar-pilot-act .button{width:100%}
  .ar-pilot-act .button{justify-content:space-between}
}
</style>
