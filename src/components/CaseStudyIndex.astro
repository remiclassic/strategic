---
import { workCases } from '../data/work-case-studies';
---
<section class="section container" id="case-studies" aria-labelledby="case-index-title"><div class="section-heading"><div><p class="eyebrow">THREE PROJECTS / THREE DESIGN QUESTIONS</p><h2 id="case-index-title">The decisions<br>behind the experience.</h2></div><p>Inspect the structure, the working result, and the reasoning that connects them.</p></div><div class="case-index-grid">{workCases.map((item,i)=><a href={`/work/${item.slug}/`}><img src={`/media/work/${item.poster}`} alt={item.afterAlt} loading="lazy"/><div><p class="eyebrow">0{i+1} / {item.category}</p><h3>{item.name}</h3><p>{item.headline.replace('\n',' ')}</p><span class="text-link">Read the case study →</span></div></a>)}</div></section>
<style>.case-index-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.case-index-grid>a{color:inherit;text-decoration:none;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#fafaf5}.case-index-grid img{display:block;width:100%;aspect-ratio:16/10;object-fit:contain;background:#192322}.case-index-grid>a>div{padding:24px}.case-index-grid h3{font-size:25px;margin:14px 0}.case-index-grid .eyebrow{font-size:8px;line-height:1.7}.case-index-grid div>p:not(.eyebrow){font-size:14px;line-height:1.7;color:var(--muted)}.case-index-grid .text-link{font-size:12px;margin-top:20px}.case-index-grid a:hover h3{text-decoration:underline;text-underline-offset:5px}@media(max-width:850px){.case-index-grid{grid-template-columns:1fr}.case-index-grid img{max-height:350px}}</style>
