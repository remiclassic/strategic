---
import FounderPortrait from '../components/FounderPortrait.astro';
import StudioLayout from '../layouts/StudioLayout.astro';
import PackageCard from '../components/b/PackageCard.astro';
import CaseCard from '../components/b/CaseCard.astro';
import CtaBand from '../components/b/CtaBand.astro';
import Faq from '../components/b/Faq.astro';
import { lines, packages, pkg, cases, featured, stats, brands, DAY_RATE, pricingFaq, RESPONSE_TIME } from '../data/studio';
import { bench } from '../data/services-team';
import { quotes } from '../data/services-credits';
import '../styles/boutique.css';

const work = featured.map(s => cases.find(c => c.slug === s)!);
const lowest = (id: string) => packages.filter(p => p.lines.includes(id) && !p.unit).sort((a, b) => +a.price.replace(/\D/g, '') - +b.price.replace(/\D/g, ''))[0];
const people = bench.filter(m => m.name);
const picks = [quotes[0], quotes[1], quotes[4]];
---
<StudioLayout title="Strategic Sloth | Game UI/UX Studio by Rémi Couture, Montreal" description="Founder-led game UI, app and game studio led by Rémi Couture, 20 years in game UI from Club Penguin at Disney to MechWarrior 5 and Dauntless. Prices from $490.">
<section class="b-hero">
  <video muted loop playsinline preload="none" poster="/media/studio/hero-loop.jpg" aria-hidden="true" data-hero-video><source data-src="/media/studio/hero-loop.mp4" type="video/mp4"/></video>
  <div class="container">
    <p class="eyebrow"><span class="live-dot" style="background:var(--gold)"></span> FOUNDER-LED STUDIO · MONTREAL · WORKING WORLDWIDE</p>
    <h1>Games, apps and game UI, <em>designed and built.</em></h1>
    <p class="lede">Strategic Sloth is a boutique studio led by Remi Couture, twenty years in game UI. We design and build interfaces, apps and whole games, and we put our prices on the page.</p>
    <div class="b-hero-actions"><a class="button gold" href="/contact/" data-track="service_cta" data-track-location="hero">Start a project <span>↗</span></a><a class="button outline-light" href="/work/" data-track="project_view" data-track-location="hero">See the work <span>→</span></a><a class="text-link" href="/pricing/">Prices from $490 <span>→</span></a></div>
    <div class="b-hero-meta">{stats.map(([n, l]) => <div><strong>{n}</strong>{l}</div>)}</div>
  </div>
  <button class="b-hero-toggle" type="button" data-hero-toggle aria-pressed="false">Pause video</button>
</section>
<div class="b-brands"><div class="container"><small>Founder experience across</small>{brands.map(b => <span>{b}</span>)}</div></div>

<section class="b-section container" id="services">
  <div class="b-head"><div><p class="eyebrow">01 / WHAT WE DO</p><h2>Four things we do,<br><em>start to finish.</em></h2></div><p>Hire us for one part or the whole pipeline. Every line is led by the same senior person and priced up front.</p></div>
  <div class="b-lines">{lines.map((l, i) => { const p = lowest(l.id); return (
    <a class="b-line" href={l.slug} style={`--acc:${l.accent}`} data-track="service_cta" data-track-location={`home-line-${l.id}`}>
      <img src={l.media.poster} alt="" loading="lazy"/>
      <div class="b-line-top"><span>0{i + 1}</span><b></b></div>
      <div class="b-line-body"><h3>{l.name}</h3><p>{l.tagline}</p><div class="b-from"><span>From</span><strong>{p.price}</strong></div></div>
    </a>); })}</div>
</section>

<section class="b-night b-section" id="work"><div class="container">
  <div class="b-head"><div><p class="eyebrow">02 / SELECTED WORK</p><h2>Real projects.<br><em>Real footage.</em></h2></div><p>Shipped titles from Remi’s career, and games and products the studio designed, built and released. Every project says which is which.</p></div>
  <div class="b-cases two" style="margin-bottom:34px"><CaseCard c={work[0]} big/><CaseCard c={work[1]} big/></div>
  <div class="b-cases">{work.slice(2).slice(0, 3).map(c => <CaseCard c={c}/>)}</div>
  <div class="b-hero-actions" style="margin-top:44px"><a class="button outline-light" href="/work/">All projects <span>→</span></a></div>
</div></section>

<section class="b-section container" id="prices">
  <div class="b-head"><div><p class="eyebrow">03 / PRICES</p><h2>Fixed packages.<br><em>No guessing.</em></h2></div><p>Start small with a review or an audit, or go straight to a build. After a short call you get a written scope with a fixed price.</p></div>
  <div class="b-packages"><PackageCard p={pkg('audit')} featured={false}/><PackageCard p={pkg('slice')} featured/><PackageCard p={pkg('app-mvp')} featured={false}/></div>
  <div class="b-rate"><div><p class="eyebrow" style="margin-bottom:6px">{DAY_RATE.label.toUpperCase()}</p><strong>{DAY_RATE.price}</strong> <span>{DAY_RATE.unit}</span></div><p>{DAY_RATE.note} Games, websites, training and monthly partnerships are on the pricing page.</p><a class="button" href="/pricing/">See all {packages.length} packages <span>→</span></a></div>
</section>

<section class="b-sage b-section"><div class="container">
  <div class="b-head"><div><p class="eyebrow">04 / HOW IT WORKS</p><h2>From first message<br><em>to handover.</em></h2></div><p>Small steps, each ending with something you can review. You always know what is next and what it costs.</p></div>
  <ol class="b-steps" style="padding:0;margin:0">
    <li><h3>Talk</h3><p>Send a screen, a build or an idea. Remi replies {RESPONSE_TIME} and we book a short call.</p><small>A suggested first step</small></li>
    <li><h3>Scope</h3><p>We agree on deliverables, timing and a fixed price in writing before any work begins.</p><small>A written scope and price</small></li>
    <li><h3>Design & build</h3><p>Work happens in short loops with weekly demos, in your tools or ours.</p><small>Something to review every week</small></li>
    <li><h3>Ship & hand over</h3><p>Source, files, documentation and a walkthrough, so your team owns the result.</p><small>Everything you need to continue</small></li>
  </ol>
</div></section>

<section class="b-section container" id="team">
  <div class="b-founder">
    <FounderPortrait alt="Guillaume “Remi” Couture, founder of Strategic Sloth"/>
    <div>
      <p class="eyebrow">05 / WHO YOU WORK WITH</p>
      <h2>A senior lead on every project. A team when you need one.</h2>
      <p>Remi Couture has designed game interfaces for twenty years: MechWarrior 5 at Piranha Games, Dauntless at Phoenix Labs, three years on Squad at Offworld, and UX Director across nine mobile studios at AppLovin.</p>
      <p>He leads every project personally. Engineers, artists and producers he trusts join under the same lead when the scope grows, so you never manage a new vendor.</p>
      <div class="b-team" style="grid-template-columns:repeat(2,minmax(0,1fr));margin-top:26px">{people.slice(0, 4).map(m => <div class="b-person"><img src={m.photo} alt="" loading="lazy"/><div><strong>{m.name}</strong><span>{m.role}</span></div></div>)}</div>
      <a class="text-link" href="/studio/" style="margin-top:18px">Meet the whole team <span>→</span></a>
    </div>
  </div>
</section>

<section class="b-night b-section"><div class="container">
  <div class="b-head"><div><p class="eyebrow">06 / IN THEIR WORDS</p><h2>From the people<br><em>who managed the work.</em></h2></div><p>LinkedIn recommendations from Remi’s managers, teammates and clients.</p></div>
  <div class="b-quotes">{picks.map(q => <figure><blockquote>“{q.text}”</blockquote><figcaption><strong>{q.name}</strong>{q.relation} · {q.date}</figcaption></figure>)}</div>
</div></section>

<Faq items={pricingFaq.slice(0, 5)} />
<CtaBand />
</StudioLayout>
<script>
const v = document.querySelector<HTMLVideoElement>('[data-hero-video]'), b = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
if (v && b) {
  // Lazy-load: attach source only when needed (in view or on user action)
  const ensureSrc = () => {
    const s = v.querySelector('source') as HTMLSourceElement | null;
    if (s && s.dataset.src && !s.src) { s.src = s.dataset.src; v.load(); }
  };
  const set = (paused: boolean) => { if (!paused) ensureSrc(); paused ? v.pause() : v.play().catch(() => {}); b.textContent = paused ? 'Play video' : 'Pause video'; b.setAttribute('aria-pressed', String(paused)); };
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) set(true);
  b.addEventListener('click', () => set(!v.paused));
  // Load when the hero enters the viewport
  const io = new IntersectionObserver(entries => { if (entries.some(e => e.isIntersecting)) { ensureSrc(); io.disconnect(); } }, { rootMargin: '100px' });
  io.observe(v);
}
</script>
