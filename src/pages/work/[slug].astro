---
import StudioLayout from '../../layouts/StudioLayout.astro';
import FounderInvite from '../../components/FounderInvite.astro';
import { workCases } from '../../data/work-case-studies';
export function getStaticPaths(){return workCases.map(item=>({params:{slug:item.slug},props:{item}}));}
const { item } = Astro.props;
---
<StudioLayout title={`${item.name} — Work & process | Strategic Sloth`} description={item.summary}>
 <section class="page-intro container"><a class="text-link" href="/work/#case-studies">← Selected work</a><p class="eyebrow">{item.category}</p><h1>{item.headline.split('\n').map(line=><span class="headline-line">{line}</span>)}</h1><p class="lede">{item.summary}</p><div class="case-meta"><span>{item.status}</span><span>{item.scope}</span></div><div class="hero-actions"><a class="button" href="#case-demo">Watch the walkthrough ↓</a><a class="text-link" href="/contact/?engagement=prototype#enquiry">Discuss a similar challenge ↗</a></div></section>
 <section class="section container case-section"><div class="case-story"><div><p class="eyebrow">THE DESIGN QUESTION</p><h2>What needed<br>to become clearer?</h2></div><p>{item.problem}</p></div><div class="case-comparison"><figure><img src={item.before} alt={item.beforeAlt} loading="lazy"/><figcaption>{item.beforeCaption}</figcaption></figure><figure><img src={item.after} alt={item.afterAlt} loading="lazy"/><figcaption>{item.afterCaption}</figcaption></figure></div><div class="case-story"><div><p class="eyebrow">THE DECISION</p><h2>Connect the views<br>to the task.</h2></div><p>{item.decision}</p></div></section>
 <section class="section container case-section" id="case-demo"><div class="section-heading"><div><p class="eyebrow">THE WORKING RESULT</p><h2>Watch it.<br>Inspect the details.</h2></div><p>{item.result}</p></div><figure class="case-video"><video controls playsinline preload="none" poster={`/media/work/${item.poster}`} aria-label={`${item.name} demonstration`}><source src={`/media/work/${item.video}`} type="video/mp4"/>{item.track&&<track kind="captions" src={`/media/work/${item.track}`} srclang="en" label="Screen descriptions" default/>}Your browser cannot play this video. <a href={`/media/work/${item.video}`}>Open the video</a>.</video><figcaption>{item.videoCaption}</figcaption></figure><div class="case-observations"><h3>What to look for</h3><ol>{item.inspect.map(text=><li>{text}</li>)}</ol></div></section>
 <section class="section container"><div class="section-heading"><div><p class="eyebrow">THE APPROACH</p><h2>Make the next<br>decision easier.</h2></div><p>A closer look at how the product organizes the work.</p></div><div class="case-process">{item.process.map(([title,body],i)=><article><span class="eyebrow">0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div><a class="text-link" href="/work/#case-studies">Explore the other case studies →</a></section>
 <FounderInvite/>
</StudioLayout>
<style>.headline-line{display:block}.case-meta{display:flex;gap:15px 30px;flex-wrap:wrap;margin-top:25px;font-size:11px;color:var(--muted)}.case-section{border-bottom:1px solid var(--line);scroll-margin-top:100px}.case-story{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center}.case-story h2{font-size:38px;line-height:1.2}.case-story>p{font-size:17px;line-height:1.9;color:var(--muted)}.case-comparison{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin:45px 0}.case-comparison figure,.case-video{margin:0}.case-comparison img{width:100%;aspect-ratio:16/11;object-fit:contain;background:#e9ede3;border:1px solid var(--line);border-radius:12px}.case-comparison figcaption,.case-video figcaption{font-size:12px;padding-block:14px;line-height:1.7;color:var(--muted)}.case-context{font-size:11px;color:var(--muted);margin-top:25px}.case-video video{display:block;width:100%;max-height:700px;background:#192322;border-radius:14px}.case-observations{display:grid;grid-template-columns:1fr 2fr;gap:30px;padding-top:25px}.case-observations h3{font-size:24px}.case-observations ol{padding-left:22px;line-height:1.9;color:var(--muted);font-size:15px}.case-observations li{padding-bottom:10px}.case-process{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-bottom:35px}.case-process article{border-top:2px solid var(--ink);padding-top:22px}.case-process h3{font-size:25px;margin:20px 0 15px}.case-process p{font-size:15px;line-height:1.8;color:var(--muted)}@media(max-width:800px){.case-story,.case-comparison,.case-observations,.case-process{grid-template-columns:1fr;gap:25px}.case-story h2{font-size:32px}.case-story>p{font-size:15px}}</style>
