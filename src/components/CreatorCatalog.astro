---
import LowPolyEmoji from './LowPolyEmoji.astro';
import '../styles/learning-story.css';
import CheckoutLink from './CheckoutLink.astro';
import { books, bundles, categories } from '../data/catalog-data';
const bundleTotal = (bundle) => bundle.bookIds.reduce((sum,id) => sum + (books.find(book => book.id===id)?.price || 0),0);
const bundleFit = {starter:'Find an idea and take the first steps toward a sale.',builder:'Build the product, its offer, and a page that explains its value.', 'full-freedom':'Keep the full creator library at hand as you build, sell, and improve.'};
import { BUNDLE_BONUS_TITLE, BUNDLE_BONUS_DESCRIPTION } from '../data/bundle-bonus';
---
<section class="page-intro container"><p class="eyebrow">LEARN / CREATOR GUIDES</p><h1>Stop guessing.<br/>Build, launch, and sell with a plan.</h1><p class="lede">15 digital guides for independent creators.<br/>Explore a specific subject, or choose a collection.</p><div class="hero-actions"><a class="button" href="#catalog">Browse the books ↓</a><a class="text-link" href="#bundles">Compare bundles →</a></div><p class="sample-route">New to digital products? <a href="/start/#book-offer">Start with the $5 guide</a>. Want to see the writing first? <a href="/samples/sell-without-an-audience/">Read a real chapter on finding buyers</a>.</p></section>
<section class="section container" id="catalog"><div class="section-heading"><div><p class="eyebrow">THE BOOKSHELF</p><h2>Find the topic you need.</h2></div><p>Digital editions · One-time purchases<br/>Secure checkout · 30-day money-back guarantee.</p></div>
<div class="filters" role="group" aria-label="Filter books"><button type="button" data-book-filter="all" aria-pressed="true">All books</button>{categories.map(category => <button type="button" data-book-filter={category.id} aria-pressed="false">{category.id === 'make-money' ? 'Getting started' : category.label}</button>)}</div><p class="results-count" aria-live="polite" id="book-count">{books.length} books</p>
<div class="book-grid">{books.map(book => <article class="library-book" id={book.id} data-book-category={book.category}><div class="book-cover"><img src={book.coverImage} alt={`${book.title} cover`} width="1200" height="675" loading="lazy" decoding="async"/></div><div class="book-copy"><h3>{book.title}</h3><p>{book.detail}</p><ul>{book.whatsInside?.map(item => <li>{item}</li>)}</ul>{book.id === 'sell-no-audience' && <a class="sample-inline" href="/samples/sell-without-an-audience/" data-track="cta_click" data-track-location="catalog-sample">Read a real sample chapter →</a>}<CheckoutLink href={book.checkoutUrl} price={book.price} product={book.id} location={`catalog-book-${book.id}`}/>{book.blogSlug && <a class="text-link" href={`/blog/${book.blogSlug}/`}>Read the related free article →</a>}</div></article>)}</div></section>
<section class="container story-sample"><div><p class="eyebrow">OPEN A BOOK FIRST · <LowPolyEmoji name="book" size={30}/></p><h2>See the pages. Try an idea.</h2><p>Read actual excerpts before choosing a guide: explore a product topic or consider how to reach readers when you’re starting without an audience.</p></div><div class="story-sample-links"><a class="text-link" href="/samples/dont-do-anything/">Read: Finding Your Winning Topic →</a><a class="text-link" href="/samples/sell-without-an-audience/">Read: Sell Without an Audience →</a></div></section>
<section class="learning-shelf" id="bundles"><div class="section container"><div class="section-heading"><div><p class="eyebrow">THE COLLECTIONS</p><h2>Prefer a reading path?</h2></div><p>Each bundle lists its included titles.<br/>Pick the subjects you need.</p></div><div class="learning-grid">{bundles.map(bundle => <article class="learning-card bundle-card" id={`bundle-${bundle.id}`}><img class="creator-bundle-art" src={bundle.coverImage} alt={`${bundle.name} artwork`} width="1200" height="675" loading="lazy" decoding="async"/><span class="card-number">{bundle.bookIds.length} DIGITAL BOOKS</span><h3>{bundle.name}</h3><p>{bundleFit[bundle.id]}</p><p class="bundle-value"><strong>${bundle.price}</strong> <span>${bundleTotal(bundle)} if purchased individually</span><b>Save ${bundleTotal(bundle)-bundle.price}</b></p>{bundle.bookIds.length > 6 ? <details class="bundle-contents"><summary>View all {bundle.bookIds.length} included titles</summary><ul>{bundle.bookIds.map(id => <li>{books.find(book => book.id===id)?.title}</li>)}</ul></details> : <ul>{bundle.bookIds.map(id => <li>{books.find(book => book.id===id)?.title}</li>)}</ul>}<CheckoutLink href={bundle.checkoutUrl} price={bundle.price} product={bundle.id} label="Buy bundle" location={`catalog-bundle-${bundle.id}`}/></article>)}</div><div class="learning-note"><strong>Included with every bundle: {BUNDLE_BONUS_TITLE}</strong><p>{BUNDLE_BONUS_DESCRIPTION}</p></div></div></section>
<section class="container learning-endnote"><p>These are educational books, not a guarantee of sales or income. Prices shown in USD. Any applicable taxes are calculated at checkout.</p><a class="text-link" href="/reading-guide/">Looking for the Freedom Library? →</a></section>
<script>
const buttons = document.querySelectorAll<HTMLButtonElement>('[data-book-filter]');
const cards = document.querySelectorAll<HTMLElement>('[data-book-category]');
buttons.forEach(button => button.addEventListener('click', () => {
const filter = button.dataset.bookFilter;
buttons.forEach(item => item.setAttribute('aria-pressed', String(item===button)));
let count = 0; cards.forEach(card => { card.hidden = filter !== 'all' && card.dataset.bookCategory !== filter; if (!card.hidden) count++; });
document.querySelector('#book-count')!.textContent = `${count} books`;
}));
</script>
