---
interface Props { name: 'idea' | 'book' | 'sloth' | 'recipes' | 'checklist' | 'music'; size?: number; }
const { name, size = 32 } = Astro.props;
---
<img class="lowpoly-emoji" src={`/studio-images/emoji/${name}.webp`} width={size} height={size} alt="" aria-hidden="true" loading="lazy" decoding="async" style={`--emoji-size:${size}px`}/>
<style>.lowpoly-emoji{display:inline-block!important;width:var(--emoji-size)!important;height:var(--emoji-size)!important;max-width:none;object-fit:contain!important;vertical-align:middle;aspect-ratio:1;flex-shrink:0;border-radius:0!important;margin:0;}</style>
