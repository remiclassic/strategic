---
const { contact = false } = Astro.props;
const options = [
 {id:'review',title:'Interface review',lead:'Find the friction before you rebuild.',body:'Start with a key screen or flow. Review hierarchy, navigation, and feedback together.',outputs:['Annotated screen review','Prioritized design recommendations','A clear next scope'],subject:'Interface review',message:'Project or product:\nKey screen or flow:\nCurrent challenge:\nPlatform or engine:\nTarget timing:\nBudget range:\n'},
 {id:'prototype',title:'Prototype sprint',lead:'Give the team something to try.',body:'Focus on one important journey and turn it into a prototype that makes the decisions visible.',outputs:['One agreed user journey','A prototype for review','Behavior and handoff notes'],subject:'Prototype sprint',message:'Project or product:\nJourney to prototype:\nUsers and platform:\nWhat exists today:\nTarget timing:\nBudget range:\n'},
 {id:'partner',title:'Design & implementation',lead:'Keep the system connected as it grows.',body:'Collaborate across interface design, reusable components, and the path into your product or engine.',outputs:['An agreed interface scope','Reusable patterns and states','Implementation collaboration'],subject:'Design and implementation partnership',message:'Project or product:\nDesign and implementation needs:\nPlatform or engine:\nTeam and current stage:\nTarget timing:\nBudget range:\n'},
];
---
<section class:list={['section','container','engagement-options',contact&&'contact-options']} id="engagements" aria-labelledby="engagements-title"><div class="section-heading"><div><p class="eyebrow">WORK DIRECTLY WITH REMI</p><h2 id="engagements-title">Start with the part<br>that matters most.</h2></div><p>Choose a starting point. We’ll agree on deliverables, timing, and budget around your project.</p></div><div class="engagement-grid">{options.map((item,i)=><article><p class="eyebrow">0{i+1} / {item.title.toUpperCase()}</p><h3>{item.lead}</h3><p>{item.body}</p><ul>{item.outputs.map(text=><li>{text}</li>)}</ul><a class="text-link" href={contact?'#enquiry':`/contact/?engagement=${item.id}#enquiry`} data-engagement={contact?item.id:undefined} data-brief-subject={contact?item.subject:undefined} data-brief-message={contact?item.message:undefined}>Discuss {item.title.toLowerCase()} ↗</a></article>)}</div><p class="engagement-note">Each engagement begins with a written scope. Ask about the next project opening and share your target dates.</p></section>
<style>.engagement-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.engagement-grid article{border:1px solid var(--line);padding:30px;border-radius:12px;background:#fafaf5;display:flex;flex-direction:column}.engagement-grid h3{font-size:26px;line-height:1.25;margin:20px 0}.engagement-grid .eyebrow{font-size:9px;line-height:1.6}.engagement-grid article>p:not(.eyebrow){font-size:14px;line-height:1.8;color:var(--muted)}.engagement-grid ul{padding-left:18px;margin:22px 0 30px;font-size:13px;line-height:2;color:var(--muted)}.engagement-grid .text-link{margin-top:auto;font-size:12px}.engagement-note{font-size:12px;color:var(--muted);margin-top:25px;line-height:1.8}@media(max-width:850px){.engagement-grid{grid-template-columns:1fr}}</style>
