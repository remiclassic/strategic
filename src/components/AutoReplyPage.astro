---
// The 24/7 auto-reply product site. One component renders all four locale pages, with its own header and footer.
import StudioLayout from '../layouts/StudioLayout.astro';
import ProductHeader from './autoreply/ProductHeader.astro';
import ProductFooter from './autoreply/ProductFooter.astro';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../utils/seo';
import {
  autoAlternates, autoCopy, autoPaths, approxUsd, formatMoney, htmlLang, regionConfig, regionOf, whatsappHref,
  type AutoLocale, type PlanId,
} from '../data/whatsapp-autoreply';
import { siteCopy } from '../data/whatsapp-autoreply-site';
import '../styles/autoreply.css';

const { loc } = Astro.props as { loc: AutoLocale };
const t = autoCopy[loc];
const s = siteCopy[loc];
const region = regionOf(loc);
const cfg = regionConfig(region);
const paths = autoPaths(loc);
const api = (import.meta.env.PUBLIC_AUTOREPLY_API ?? '').replace(/\/$/, '');
const checkoutAction = `${api}/api/autoreply/checkout`;
const waHref = whatsappHref(import.meta.env.WHATSAPP_NUMBER ?? process.env.WHATSAPP_NUMBER, t.whatsappText);
const waExternal = waHref.startsWith('https://');
const pilot = cfg.pilot;
const spots = t.pilotSpots.replace('{left}', String(pilot.spotsLeft)).replace('{total}', String(pilot.spotsTotal));
const money = (n: number) => formatMoney(n, loc);
const videoKey = loc.toLowerCase();
const schema = [
  serviceSchema(t.serviceName, paths.page, t.description, 'Chatbot and messaging automation'),
  breadcrumbSchema([[t.crumbHome, '/'], [t.crumbSelf, paths.page]]),
];
// Timing for the hero chat: each line appears after the previous one, bot lines after a short "typing" beat.
let at = 0.4;
const lines = s.demo.lines.map(line => {
  const typing = line.from === 'bot' ? { d: at, dur: 1.1 } : null;
  if (typing) at += 1.1;
  const d = at;
  at += line.from === 'customer' ? 1.2 : 0.9;
  return { ...line, d, typing };
});
const missed = {
  es: ['Llamada perdida', '¡Hola! Perdón por no contestar. ¿En qué le ayudamos?'],
  en: ['Missed call', 'Hi! Sorry we missed your call. How can we help?'],
  fr: ['Appel manqué', 'Bonjour! Désolé d’avoir manqué votre appel. Comment pouvons-nous vous aider?'],
  'en-CA': ['Missed call', 'Hi! Sorry we missed your call. How can we help?'],
}[loc];
const langPair = region === 'ca' ? ['FR', 'EN'] : ['ES', 'EN'];
const check = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
---
<StudioLayout title={t.title} description={t.description} lang={htmlLang(loc)} alternates={autoAlternates} schema={schema} product>
  <ProductHeader slot="header" loc={loc} />

  <section class="p-hero">
    <div class="p-wrap">
      <div>
        <span class="p-pill"><b>{s.regionLabel}</b>{t.eyebrow}</span>
        <h1>{t.h1[0]} <em>{t.h1[1]}</em></h1>
        <p class="p-lede">{t.lede}</p>
        <div class="p-actions">
          <a class="p-btn primary" href="#plans" data-track="service_cta" data-track-location={`autoreply-${loc}-hero`}>{t.heroCta} <span aria-hidden="true">→</span></a>
          <button class="p-btn ghost" type="button" data-chat-open data-track="chat_open" data-track-location={`autoreply-${loc}-hero`}>{t.tryIt}</button>
        </div>
        <ul class="p-chips">{t.channels.map(c => <li>{c}</li>)}</ul>
        <div class="p-facts">{t.facts.map(([n, l]) => <div><span>{n}</span><strong>{l}</strong></div>)}</div>
      </div>

      <figure class="p-demo" aria-label={`${s.demo.example}: ${s.demo.channel}`}>
        <span class="p-example">{s.demo.example}</span>
        <div class="p-phone">
          <div class="p-screen">
            <div class="p-chat-head">
              <span class="p-avatar" aria-hidden="true">{s.demo.business.slice(0, 1)}</span>
              <div><b>{s.demo.business}</b><small>{s.demo.status}</small></div>
              <span class="p-channel">{s.demo.channel}</span>
            </div>
            <div class="p-thread">
              {lines.map(l => (
                <>
                  {l.typing && <span class="p-typing" style={`--d:${l.typing.d}s;--dur:${l.typing.dur}s`} aria-hidden="true"><i></i><i></i><i></i></span>}
                  <p class:list={['p-msg', l.from]} style={`--d:${l.d}s`}>{l.text}{l.time && <time>{l.time}</time>}</p>
                </>
              ))}
            </div>
          </div>
        </div>
        <ul class="p-callouts">{s.demo.callouts.map(c => <li><Fragment set:html={check} />{c}</li>)}</ul>
      </figure>
    </div>
  </section>

  <section class="p-section" id="how">
    <div class="p-wrap">
      <div class="p-head">
        <p class="p-eyebrow">{t.stepsEyebrow}</p>
        <h2>{t.stepsTitle[0]} {t.stepsTitle[1]}</h2>
        <p>{t.stepsIntro}</p>
      </div>
      <ol class="p-steps">
        {t.steps.map(([title, body, note], i) => <li><span class="p-num">0{i + 1}</span><h3>{title}</h3><p>{body}</p><small>{note}</small></li>)}
      </ol>
    </div>
  </section>

  <section class="p-section" id="video">
    <div class="p-wrap">
      <div class="p-head p-center">
        <p class="p-eyebrow">{s.videoEyebrow}</p>
        <h2>{s.videoTitle}</h2>
        <p>{s.videoBody}</p>
      </div>
      <div class="p-video-frame">
        <video controls playsinline preload="none" poster={`/media/autoreply/explainer-${videoKey}.webp`} aria-label={s.videoLabel} width="1280" height="720">
          <source src={`/media/autoreply/explainer-${videoKey}.mp4`} type="video/mp4" />
        </video>
      </div>
      <details class="p-transcript">
        <summary>{s.transcript}</summary>
        <ol>{s.video.captions.map(c => <li>{c}</li>)}</ol>
      </details>
    </div>
  </section>

  <section class="p-section" id="who">
    <div class="p-wrap">
      <div class="p-head">
        <p class="p-eyebrow">{t.whoEyebrow}</p>
        <h2>{t.whoTitle[0]} {t.whoTitle[1]}</h2>
        <p>{t.whoIntro}</p>
      </div>
      <ul class="p-who p-who-list">{t.who.map(([name, body]) => <li><strong>{name}</strong><span>{body}</span></li>)}</ul>
    </div>
  </section>

  <section class="p-section" id="features">
    <div class="p-wrap">
      <div class="p-head">
        <p class="p-eyebrow">{s.featuresEyebrow}</p>
        <h2>{s.featuresTitle}</h2>
      </div>
      <div class="p-bento">
        {s.features.map(f => (
          <article class="p-card">
            <div class="p-card-art" aria-hidden="true">
              {f.kind === 'instant' && <div class="a-bubbles"><span>{s.demo.lines[0].text}</span><span>{s.demo.lines[1].text.split('.')[0]}.</span></div>}
              {f.kind === 'language' && <div class="a-langs"><b class="on">{langPair[0]}</b><svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 8h14l-3-3M20 16H6l3 3"/></svg><b>{langPair[1]}</b></div>}
              {f.kind === 'sheet' && <table class="a-sheet"><thead><tr>{s.sheetHeaders.map(h => <th>{h}</th>)}</tr></thead><tbody>{s.sheetRows.map(r => <tr>{r.map(c => <td>{c}</td>)}</tr>)}</tbody></table>}
              {f.kind === 'handoff' && <div class="a-alert"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 22a2.5 2.5 0 0 0 2.4-2h-4.8a2.5 2.5 0 0 0 2.4 2Zm7-6V11a7 7 0 0 0-5.5-6.8V3.5a1.5 1.5 0 0 0-3 0v.7A7 7 0 0 0 5 11v5l-2 2v1h18v-1l-2-2Z"/></svg><div><b>{s.alertTitle}</b><span>{s.alertBody}</span></div></div>}
              {f.kind === 'booking' && <div class="a-booking"><svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 6h16v14H4zM4 10h16M8 3v5M16 3v5"/></svg><b>{s.bookingCard[0]}</b><span>{s.bookingCard[1]}</span><em>{s.bookingCard[2]}</em></div>}
              {f.kind === 'approve' && <ul class="a-approve">{s.approveItems.map(i => <li>{i}</li>)}</ul>}
              {f.kind === 'missed' && <div class="a-missed"><span class="call"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M20 15.5c-1.2 0-2.4-.2-3.6-.6a1 1 0 0 0-1 .2l-2.2 2.2a15 15 0 0 1-6.6-6.6l2.2-2.2a1 1 0 0 0 .2-1A11.4 11.4 0 0 1 8.5 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1 17 17 0 0 0 17 17 1 1 0 0 0 1-1v-3.5a1 1 0 0 0-1-1Z"/></svg>{missed[0]}</span><span class="sms">{missed[1]}</span></div>}
            </div>
            <div class="p-card-copy"><h3>{f.title}</h3><p>{f.body}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="p-section" id="plans">
    <div class="p-wrap">
      <div class="p-head">
        <p class="p-eyebrow">{t.pricingEyebrow}</p>
        <h2>{t.pricingTitle[0]} {t.pricingTitle[1]}</h2>
        <p>{t.pricingIntro}</p>
      </div>

      {pilot.spotsLeft > 0 && (
        <form class="p-pilot" method="post" action={checkoutAction} data-checkout>
          <div>
            <p class="p-eyebrow">{t.pilotFlag}</p>
            <h3>{t.pilotTitle}</h3>
            <p>{t.pilotBody}</p>
          </div>
          <div class="p-pilot-act">
            <p class="p-spots"><span aria-hidden="true">{Array.from({ length: pilot.spotsTotal }, (_, i) => <i class={i < pilot.spotsTotal - pilot.spotsLeft ? 'taken' : undefined}></i>)}</span>{spots}</p>
            <input type="hidden" name="locale" value={loc}/>
            <input type="hidden" name="plan" value={pilot.plan}/>
            <input type="hidden" name="pilot" value="1"/>
            <button class="p-btn" type="submit" data-track="checkout_start" data-track-location={`autoreply-${loc}-pilot`}>{t.pilotCta} <span aria-hidden="true">→</span></button>
          </div>
        </form>
      )}

      <div class="p-plans">
        {cfg.plans.map(plan => {
          const p = t.plans[plan.id as PlanId];
          return (
            <article class:list={['p-plan', plan.featured && 'featured']} aria-labelledby={`plan-${plan.id}`}>
              {plan.featured && <span class="p-flag">{t.popular}</span>}
              <h3 id={`plan-${plan.id}`}>{p.name}</h3>
              <p class="p-blurb">{p.blurb}</p>
              <div class="p-price"><strong>{money(plan.monthly)}</strong><span>{t.perMonth}</span></div>
              {region === 'mx' ? <p class="p-sub">{t.approxLabel} {approxUsd(plan.monthly)}{t.perMonth}</p> : t.taxesNote && <p class="p-sub">{t.taxesNote}</p>}
              <p class="p-setup">+ {money(plan.setup)} {t.setupLabel}{region === 'mx' && <span> · {t.approxLabel} {approxUsd(plan.setup)}</span>}</p>
              <ul class="p-features">{p.features.map(f => <li>{f}</li>)}</ul>
              <form method="post" action={checkoutAction} data-checkout class="p-buy">
                <input type="hidden" name="locale" value={loc}/>
                <input type="hidden" name="plan" value={plan.id}/>
                <button class="p-btn primary" type="submit" data-track="checkout_start" data-track-location={`autoreply-${loc}-${plan.id}`}>{t.buyCta} {p.name} <span aria-hidden="true">→</span></button>
                {cfg.oxxo && t.oxxoCta && (
                  <button class="p-oxxo" type="submit" name="method" value="oxxo" data-track="checkout_start" data-track-location={`autoreply-${loc}-${plan.id}-oxxo`}>{t.oxxoCta}</button>
                )}
              </form>
            </article>
          );
        })}
      </div>
      <p class="p-note">{t.checkoutNote} {cfg.oxxo && t.oxxoNote} <a href={paths.terms}>{t.legalTerms}</a> · <a href={paths.privacy}>{t.legalPrivacy}</a></p>
      <p class="p-error" role="alert" hidden data-checkout-error>{t.checkoutError}</p>

      <div class="p-extra">
        <section class="p-box" aria-labelledby="p-extra-title">
          <h3 id="p-extra-title">{t.extraTitle}</h3>
          {t.extra.map(p => <p>{p}</p>)}
          <p class="p-links">{t.extraLinks.map(([label, href]) => <a href={href} target="_blank" rel="noopener noreferrer">{label} <span aria-hidden="true">↗</span></a>)}</p>
        </section>
        <section class="p-box" aria-labelledby="p-honest-title">
          <h3 id="p-honest-title">{t.honestTitle}</h3>
          <ul class="p-honest">{t.honest.map(([h, b]) => <li><strong>{h}</strong><span>{b}</span></li>)}</ul>
        </section>
      </div>
    </div>
  </section>

  <section class="p-section" id="faq">
    <div class="p-wrap p-faq">
      <div class="p-head">
        <p class="p-eyebrow">{t.faqEyebrow}</p>
        <h2>{t.faqTitle}</h2>
      </div>
      <div>{t.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema(t.faq))}/>
  </section>

  <div class="p-wrap">
    <section class="p-cta" id="contact">
      <p class="p-eyebrow">{t.closeEyebrow}</p>
      <h2>{t.closeTitle[0]} {t.closeTitle[1]}</h2>
      <p>{t.closeBody}</p>
      <div class="p-actions">
        <a class="p-btn primary" href="#plans">{t.closeCta} <span aria-hidden="true">→</span></a>
        <button class="p-btn ghost" type="button" data-chat-open data-track="chat_open" data-track-location={`autoreply-${loc}-close`}>{t.tryIt}</button>
        <a class="p-btn ghost" href={waHref} rel={waExternal ? 'noopener' : undefined} target={waExternal ? '_blank' : undefined} data-track="whatsapp_click" data-track-location={`autoreply-${loc}-close`}>{t.whatsappCta} <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>

  <ProductFooter slot="footer" loc={loc} />
</StudioLayout>

<script>
  // Progressive enhancement: post as fetch so we can show a friendly error instead of a raw API page.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-checkout]')) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
      const data = new FormData(form, submitter);
      const error = document.querySelector<HTMLElement>('[data-checkout-error]');
      form.querySelectorAll('button').forEach(b => (b.disabled = true));
      try {
        const res = await fetch(form.action, { method: 'POST', body: new URLSearchParams(data as any), headers: { Accept: 'application/json' } });
        const body = await res.json().catch(() => ({}));
        if (!res.ok || !body.url) throw new Error(body.error || 'checkout_failed');
        location.assign(body.url);
      } catch {
        if (error) { error.hidden = false; error.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
        form.querySelectorAll('button').forEach(b => (b.disabled = false));
      }
    });
  }
  // Close the language menu when the visitor clicks elsewhere or presses Escape.
  const lang = document.querySelector<HTMLDetailsElement>('.p-lang');
  document.addEventListener('click', (e) => { if (lang?.open && !lang.contains(e.target as Node)) lang.open = false; });
  lang?.addEventListener('keydown', (e) => { if (e.key === 'Escape') { lang.open = false; lang.querySelector('summary')?.focus(); } });
</script>
