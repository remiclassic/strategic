---
import { offers } from '../data/services';
const { contact = false } = Astro.props;
// One list of ways to start, shared with the Services page; the contact form pre-fills from these.
const briefs = {
 review:{subject:'UI & UX audit',message:'Project or product:\nKey screens or flows:\nCurrent challenge:\nPlatform or engine:\nTarget timing:\nBudget range:\n'},
 prototype:{subject:'Vertical slice',message:'Project or product:\nJourney to design and build:\nUsers and platform:\nWhat exists today:\nTarget timing:\nBudget range:\n'},
 partner:{subject:'Embedded UI partner',message:'Project or product:\nDesign and implementation needs:\nPlatform or engine:\nTeam and current stage:\nTarget timing:\nBudget range:\n'},
};
const options = offers.map(o => ({ ...o, ...briefs[o.id] }));
---
<section class:list={['section','container','engagement-options',contact&&'contact-options']} id="engagements" aria-labelledby="engagements-title"><div class="section-heading"><div><p class="eyebrow">WAYS TO START</p><h2 id="engagements-title">Start small.<br>Scale when it works.</h2></div><p>Three ways to work together. Durations are typical; every engagement begins with a written scope and a price.</p></div><div class="engagement-grid">{options.map((item,i)=><article><p class="eyebrow">0{i+1} / {item.title.toUpperCase()}<span class="engagement-span">{item.span}</span></p><h3>{item.lead}</h3><p>{item.body}</p><ul>{item.outputs.map(text=><li>{text}</li>)}</ul><a class="text-link" data-track="service_cta" data-track-location="engagement-options" href={contact?'#enquiry':`/contact/?engagement=${item.id}#enquiry`} data-engagement={contact?item.id:undefined} data-brief-subject={contact?item.subject:undefined} data-brief-message={contact?item.message:undefined}>Discuss this ↗</a></article>)}</div><p class="engagement-note">Not sure which fits? Send a screenshot, a recording or a build with your dates, and we’ll suggest one.</p></section>
<style>.engagement-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.engagement-grid article{border:1px solid var(--line);padding:30px;border-radius:12px;background:#fafaf5;display:flex;flex-direction:column}.engagement-grid h3{font-size:26px;line-height:1.25;margin:20px 0}.engagement-grid .eyebrow{font-size:9px;line-height:1.6;display:flex;justify-content:space-between;gap:12px}.engagement-span{color:var(--muted);font-weight:600;letter-spacing:.06em}.engagement-grid article>p:not(.eyebrow){font-size:14px;line-height:1.8;color:var(--muted)}.engagement-grid ul{padding-left:18px;margin:22px 0 30px;font-size:13px;line-height:2;color:var(--muted)}.engagement-grid .text-link{margin-top:auto;font-size:12px}.engagement-note{font-size:12px;color:var(--muted);margin-top:25px;line-height:1.8}@media(max-width:850px){.engagement-grid{grid-template-columns:1fr}}</style>
