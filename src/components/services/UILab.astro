  .lab{--ease-enter:cubic-bezier(.2,.7,.2,1);--ease-exit:cubic-bezier(.4,0,1,1);--ease-emphasis:cubic-bezier(.34,1.56,.64,1);--t-enter:180ms;--t-exit:120ms;--t-emphasis:320ms;--t-drain:600ms;--t-hold:450ms}
