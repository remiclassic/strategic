---
import { serviceSchema, breadcrumbSchema } from '../../utils/seo';
import StudioLayout from '../../layouts/StudioLayout.astro';
import ServiceLine from '../../components/b/ServiceLine.astro';
import '../../styles/boutique.css';
const faq: [string, string][] = [
  ['Do you work on PC and console games too?', 'Yes, mostly through game UI and co-development. Our full-game packages focus on mobile and the browser, where we ship our own titles.'],
  ['Can you reskin a game we already have?', 'Yes. Runefjord went from a copy of Tropic Tumble to a signed Google Play test build in four days.'],
];
---
<StudioLayout title="Mobile Game Development and Prototyping | Strategic Sloth" schema={[serviceSchema("Game development", "/services/games/", "Mobile game prototypes and full games, from first playable to store launch."), breadcrumbSchema([["Home", "/"], ["Services", "/services/"], ["Game development", "/services/games/"]])]} description="Mobile games from first playable to the store, by the studio that shipped Tropic Tumble on Google Play. Prototypes, UI, economy and launch, with fixed-price scopes.">
<ServiceLine id="games" headline="Mobile game development and prototyping<br><em>From first playable to the store.</em>" intro="We design, build and publish our own games, and we bring the same practice to yours: core loop, economy, UI, art direction, code and release. <a class='text-link' href='/services/mobile-game-ui/'>About mobile game UI <span>→</span></a>" faq={faq} />
</StudioLayout>
