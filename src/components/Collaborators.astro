---
import { bench } from '../data/services-team';
const { compact = false } = Astro.props;
const people = bench.filter(person => person.name);
const roles = bench.filter(person => !person.name);
---
<section class:list={['section','container','collaborators',compact && 'compact-collaborators']} id={compact ? 'team' : 'collaborators'}>
 <div class="section-heading"><div><p class="eyebrow">TRUSTED COLLABORATORS</p><h2>People we build with.</h2></div><p>Remi leads the work. Trusted collaborators join according to the project, bringing the specialties your scope needs.</p></div>
 <div class="collaborator-grid">{people.map(person => <article><img src={person.photo} alt={person.name} width="96" height="96" loading="lazy"/><div><h3>{person.name}</h3><p class="collaborator-role">{person.role}</p>{!compact && <><p>{person.background}</p><span>{person.skills.join(' · ')}</span></>}</div></article>)}</div>
 {!compact && <div class="additional-specialties"><p class="eyebrow">ADDITIONAL SPECIALTIES / AS THE PROJECT REQUIRES</p><h3>Build the team around the brief.</h3><p>These are additional roles a project may need, separate from the named collaborators above. Team composition and availability are agreed during scoping.</p><ul>{roles.map(person => <li>{person.role}<span>{person.skills.join(' · ')}</span></li>)}</ul></div>}
 <div class="collaborator-links">{compact && <a class="text-link" href="/studio/#collaborators">Meet the collaborators & explore specialties →</a>}<a class="text-link" href="/contact/?engagement=partner#enquiry">Discuss the team for your project ↗</a></div>
</section>
<style>.collaborator-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.collaborator-grid article{display:flex;align-items:flex-start;gap:20px;border:1px solid var(--line);border-radius:12px;background:#fafaf5;padding:25px}.collaborator-grid img{width:64px;height:64px;flex:none;border-radius:50%;object-fit:cover}.collaborator-grid h3{font-size:21px;line-height:1.25;letter-spacing:-.03em}.collaborator-grid p{font-size:13px;margin-top:12px;line-height:1.7}.collaborator-grid .collaborator-role{font-size:12px;color:#526743;font-weight:600;margin-top:7px}.collaborator-grid span{display:block;font-size:11px;color:var(--muted);margin-top:14px}.additional-specialties{background:#e9edde;border:1px solid var(--line);border-radius:12px;padding:30px;margin-top:30px}.additional-specialties h3{font-size:26px;margin-bottom:16px}.additional-specialties>p:not(.eyebrow){font-size:14px;max-width:750px}.additional-specialties ul{padding:0;list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:24px 0 0}.additional-specialties li{border-top:1px solid #bdc8af;padding-top:15px;font-size:14px;font-weight:600}.additional-specialties li span{display:block;color:var(--muted);font-size:11px;font-weight:400;margin-top:8px}.collaborator-links{display:flex;flex-wrap:wrap;gap:12px 30px;margin-top:25px}.compact-collaborators .collaborator-grid article{padding:20px}.compact-collaborators .collaborator-grid img{width:48px;height:48px}@media(max-width:1000px){.collaborator-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.collaborator-grid,.additional-specialties ul{grid-template-columns:1fr}.collaborator-grid article{padding:22px}.additional-specialties{padding:24px}}</style>
