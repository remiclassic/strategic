---
const { product } = Astro.props;
const projects = [
  { id:'drivedeck', name:'DriveDeck', type:'DESKTOP WORKSPACE · AWAITING LAUNCH', title:'From plugging in to packing up.', description:'A portable workspace has a beginning and an end: connect the drive, organize the work, manage transfers, and disconnect safely.', process:'The design focus is continuity across that whole journey. Organization, transfer status, and safe eject belong in the same workspace.', href:'/drivedeck/', label:'Explore DriveDeck', kind:'workflow' },
  { id:'narriaflow', name:'NarriaFlow', type:'VISUAL WRITING · RECORDED DEVELOPMENT DEMO', title:'A story you can see taking shape.', description:'Watch connected scene cards, switch to an ordered outline, and inspect character details in a real recorded writing workspace.', process:'The canvas supports relationships; the outline supports sequence. Keeping both views within reach gives the author different ways to work with the same story.', href:'/narriaflow/', label:'Explore NarriaFlow', kind:'video', video:'narriaflow-demo.mp4', poster:'narriaflow-poster.webp', caption:'54-second silent edit from the saved demo. Browser tabs removed; original interaction speed. Development UI may differ from the release.', track:'narriaflow-demo.vtt' },
  { id:'focusrail', name:'Focusrail', type:'UNREAL ENGINE · ACTUAL RUNTIME SCREENSHOT', title:'Make navigation visible.', description:'The runtime overlay names the focused widget, its rail index, and the next and previous targets beside the running pause menu.', process:'Expose focus behavior directly in the interface being tested. Designers and developers can inspect the navigation path while checking the menu.', href:'https://www.fab.com/listings/47a56c00-ab32-4c20-8aba-04935b4a2578', label:'View Focusrail on Fab', kind:'image', image:'focusrail-runtime.webp', alt:'Focusrail running pause menu with Resume focused and a debug overlay showing its index, next and previous targets', caption:'Captured runtime demo — ResumeButton is focused. This is a screenshot, not an interactive demo.' },
  { id:'world-editor', name:'SliceForge World Editor', type:'WORLD AUTHORING · RECORDED DEVELOPMENT DEMO', title:'Paint the map. Inspect the world.', description:'A real development recording places the editable cell grid beside the generated 3D preview, with terrain tools and a prop shelf around the work.', process:'Keep the authoring decisions and their spatial result visible together. The painted grid remains the source while the preview lets you inspect the generated scene.', href:'/world-editor/', label:'Explore World Editor', kind:'video', video:'world-editor-demo.mp4', poster:'world-editor-poster.webp', caption:'33-second silent development recording. Original interaction speed. This shows the grid-authoring prototype, not a finished release.' },
  { id:'real-estate', name:'Real Estate 3D Home', type:'SPATIAL WEB APP · SYNTHETIC PROPERTY DEMO', title:'Turn a plan into a place.', description:'A connected 2D/3D property application brings floor-plan structure, furnished spaces, and walkthrough presentation together.', process:'Keep geometry review and presentation review connected but distinct. A convincing walkthrough should sit beside the plan that defines the building.', href:'/work/real-estate/', label:'Explore the real estate case study', kind:'video', video:'real-estate-demo.mp4', poster:'real-estate-poster.webp', caption:'90-second silent walkthrough of a synthetic demonstration home. Local application work; not a real property listing.' },
].filter(item => !product || item.id === product);
---
<section class:list={['section','container','product-evidence',product && 'single-evidence']} aria-labelledby={`evidence-title-${product || 'all'}`}>
  <div class="section-heading"><div><p class="eyebrow">THE TOOLS / INSIDE THE WORK</p><h2 id={`evidence-title-${product || 'all'}`}>{product ? 'A closer look at the work.' : 'See the tools in use.'}</h2></div><p>Recorded interfaces, a runtime capture, and the design decisions behind the workflow.</p></div>
  <div class="evidence-grid">{projects.map(item => <article class="evidence-card" id={`evidence-${item.id}`}>
    <div class="evidence-top"><p class="eyebrow">{item.type}</p><h3>{item.name}</h3><p class="evidence-title">{item.title}</p></div>
    {item.kind === 'video' && <figure><video controls playsinline preload="none" poster={`/media/work/${item.poster}`} aria-label={`${item.name} recorded development demo`}><source src={`/media/work/${item.video}`} type="video/mp4"/>{item.track && <track kind="captions" src={`/media/work/${item.track}`} srclang="en" label="Screen descriptions" default/>}Your browser cannot play this video. <a href={`/media/work/${item.video}`}>Open the recording</a>.</video><figcaption>{item.caption}</figcaption></figure>}
    {item.kind === 'image' && <figure><img src={`/media/work/${item.image}`} alt={item.alt} loading="lazy" width="1192" height="663"/><figcaption>{item.caption}</figcaption></figure>}
    {item.kind === 'workflow' && <figure><div class="drive-workflow"><span class="eyebrow">DRIVEDECK / WORKFLOW ILLUSTRATION</span><ol><li><span>01</span><strong>Connect</strong><small>Claim your external drive</small></li><li><span>02</span><strong>Organize</strong><small>Folders, pins, and projects</small></li><li><span>03</span><strong>Transfer</strong><small>Queue and check progress</small></li><li><span>04</span><strong>Safely eject</strong><small>Finish the session</small></li></ol></div><figcaption>Workflow illustration. Product screenshots will give this sequence its next level of detail.</figcaption></figure>}
    <div class="evidence-copy"><p>{item.description}</p><details><summary>Behind the design <span aria-hidden="true">＋</span></summary><p>{item.process}</p></details><a class="text-link" href={item.href} {...(item.href.startsWith('https:') ? {target:'_blank',rel:'noopener'} : {})}>{item.label} <span aria-hidden="true">↗</span></a></div>
  </article>)}</div>
</section>
<style>
 .evidence-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}.evidence-card{border:1px solid var(--line);border-radius:14px;overflow:hidden;background:#fafaf5;scroll-margin-top:100px;min-width:0}.evidence-top{padding:28px 28px 20px}.evidence-top .eyebrow{font-size:9px;line-height:1.6}.evidence-top h3{font-size:30px;letter-spacing:-.04em;margin:12px 0}.evidence-title{font-size:16px;color:var(--muted)}.evidence-card figure{margin:0}.evidence-card video,.evidence-card img{display:block;width:100%;height:330px;object-fit:contain;background:#192322}.evidence-card figcaption{padding:14px 28px;font-size:11px;line-height:1.7;color:var(--muted);min-height:82px;border-bottom:1px solid var(--line)}.evidence-copy{padding:18px 28px 28px}.evidence-copy>p,.evidence-copy details p{font-size:14px;line-height:1.8;color:var(--muted)}.evidence-copy details{border-block:1px solid var(--line);margin:22px 0}.evidence-copy summary{cursor:pointer;padding:16px 0;font-size:13px}.evidence-copy summary span{float:right}.evidence-copy details p{padding:0 0 18px}.drive-workflow{height:330px;padding:26px 28px;background:#e6edef;display:flex;flex-direction:column;justify-content:center}.drive-workflow ol{padding:0;margin:20px 0 0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:22px}.drive-workflow li{border-top:1px solid #a8b5bd;padding-top:12px}.drive-workflow li>span{font-size:11px;color:#5b6f77;display:block;margin-bottom:6px}.drive-workflow strong{font-size:20px;display:block}.drive-workflow small{font-size:11px;color:#5b6f77}.single-evidence .evidence-grid{grid-template-columns:1fr}.single-evidence .evidence-card video,.single-evidence .evidence-card img{height:auto;max-height:650px}.single-evidence .evidence-card figcaption{min-height:0}.single-evidence .drive-workflow{height:300px}.single-evidence .drive-workflow ol{grid-template-columns:repeat(4,1fr)}@media(max-width:850px){.evidence-grid{grid-template-columns:1fr}}@media(max-width:540px){.evidence-top,.evidence-copy{padding-inline:20px}.evidence-card figcaption{padding-inline:20px;min-height:0}.evidence-card video,.evidence-card img{height:auto;min-height:180px}.drive-workflow{padding:20px;height:320px}.single-evidence .drive-workflow ol{grid-template-columns:1fr 1fr}.single-evidence .drive-workflow{height:320px}}
</style>
