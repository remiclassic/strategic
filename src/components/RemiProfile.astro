---
// About Rémi Couture, shared by /remi-couture/ and /fr/remi-couture/. Copy lives in data/remi-profile.ts.
import '../styles/boutique.css';
import FounderPortrait from './FounderPortrait.astro';
import { remiCopy, type RemiLang } from '../data/remi-profile';
import { quotes } from '../data/services-credits';
const { lang = 'en' } = Astro.props as { lang?: RemiLang };
const t = remiCopy[lang];
const quote = quotes.find(q => q.lead)!;
const other = lang === 'en' ? 'fr' : 'en';
---
<section class="rp-hero container">
  <div>
    <div class="rp-top"><p class="eyebrow"><span class="live-dot"></span> {t.eyebrow.toUpperCase()}</p><a class="rp-lang" href={t.switchHref} hreflang={other} lang={other}>{t.switchLabel}</a></div>
    <h1>Rémi Couture <span class="rp-h1-role">{t.h1Role}</span></h1>
    <p class="lede" set:html={t.lede}/>
    <div class="rp-actions"><a class="button" href="/contact/">{t.ctaPrimary} <span>↗</span></a><a class="text-link" href="https://remiclassic.github.io/remiresume/">{t.resume} <span>↗</span></a><a class="text-link" href="https://www.linkedin.com/in/remicouture/">LinkedIn <span>↗</span></a></div>
    <p class="rp-note">{t.disambiguation}</p>
  </div>
  <figure class="rp-portrait">
    <div class="rp-portrait-label"><span>{t.portraitTop[0]}</span><span>{t.portraitTop[1]}</span></div>
    <FounderPortrait alt={t.portraitAlt} lazy={false}/>
    <figcaption><span>Guillaume “Rémi” Couture</span><span aria-hidden="true">✳</span></figcaption>
  </figure>
</section>

<div class="container"><dl class="rp-facts">{t.facts.map(([n, label]) => <div><dt>{n}</dt><dd>{label}</dd></div>)}</dl></div>

<section class="b-section container rp-origin" id="club-penguin">
  <figure id="club-penguin-art">
    <img src="/media/services/credits/full/club-penguin-1.webp" alt={t.originAlt} width="1280" height="768" loading="lazy"/>
    <figcaption>{t.originCaption}</figcaption>
  </figure>
  <div>
    <p class="eyebrow">{t.originEyebrow.toUpperCase()}</p>
    <h2>{t.originTitle[0]} <em>({t.originTitle[1]})</em></h2>
    <p>{t.origin}</p>
    <ol class="rp-path">{t.path.map(([step, label]) => <li><span>{step.toUpperCase()}</span>{label}</li>)}</ol>
    <p class="b-note">{t.disclaimer}</p>
  </div>
</section>

<section class="b-night b-section" id="career"><div class="container">
  <div class="b-head"><div><p class="eyebrow">{t.careerEyebrow.toUpperCase()}</p><h2>{t.careerTitle[0]}<br><em>{t.careerTitle[1]}</em></h2></div><p>{t.careerIntro}</p></div>
  <ol class="rp-timeline">
    {t.career.map(job => <li id={job.id}>
      <span class="rp-years">{job.years}</span>
      <span class="rp-studio"><strong>{job.studio}</strong><span>{job.role}</span></span>
      <span class="rp-detail">{job.work && <b>{job.work}</b>}{job.note}</span>
    </li>)}
    <li class="rp-now"><span class="rp-years">{t.now.years}</span><span class="rp-studio"><strong>{t.now.studio}</strong><span>{t.now.role}</span></span><a class="rp-detail" href="#strategic-sloth">{t.now.note} <span aria-hidden="true">↓</span></a></li>
  </ol>
  <div class="rp-proof">
    <div><p class="eyebrow">{t.clientsLabel.toUpperCase()}</p><p class="rp-clients">{t.clients.map(name => <span>{name}</span>)}</p></div>
    <figure class="rp-quote"><blockquote lang="en">“{quote.text}”</blockquote><figcaption><a href={quote.url}>{quote.name} <span aria-hidden="true">↗</span></a>{t.quoteRelation} · {quote.date}</figcaption></figure>
  </div>
</div></section>

<section class="b-section container" id="strategic-sloth">
  <div class="b-head"><div><p class="eyebrow">{t.studioEyebrow.toUpperCase()}</p><h2>{t.studioTitle[0]}<br><em>{t.studioTitle[1]}</em></h2></div><div class="rp-head-copy"><p>{t.studioIntro}</p><a class="text-link" href="/studio/">{t.studioLink} <span>→</span></a></div></div>
  <div class="rp-games">{t.games.map(game => <a class="rp-game" href={game.href}>
    <span class="rp-game-media"><img src={game.img} alt="" loading="lazy" style={`object-position:${game.pos}`}/><span class="b-badge">{game.tag}</span></span>
    <h3>{game.name} <span aria-hidden="true">↗</span></h3>
    <p>{game.body}</p>
  </a>)}</div>
</section>

<div class="b-sage b-section"><div class="container rp-two">
  <section id="press">
    <p class="eyebrow">{t.pressEyebrow.toUpperCase()}</p><h2>{t.pressTitle}</h2>
    <div class="rp-press-list">{t.press.map(item => <a class="rp-press" href={item.href}><small>{item.outlet} · {item.date}</small><strong lang="en">{item.title}</strong>{item.note && <em>{item.note}</em>}<span>{item.action} ↗</span></a>)}</div>
    <p class="rp-kit">{t.pressKit}: <a href="https://slothjam.com/share.html">slothjam.com/share.html</a></p>
  </section>
  <section id="elsewhere">
    <p class="eyebrow">{t.onlineEyebrow.toUpperCase()}</p><h2>{t.onlineTitle}</h2>
    <ul class="rp-links">{t.links.map(([name, handle, href]) => <li><a href={href} rel="me"><strong>{name}</strong><span>{handle}</span><b aria-hidden="true">↗</b></a></li>)}</ul>
  </section>
</div></div>

<section class="b-cta"><div class="container">
  <div><p class="eyebrow">{t.ctaEyebrow.toUpperCase()}</p><h2>{t.ctaTitle[0]}<br><em>{t.ctaTitle[1]}</em></h2></div>
  <div><p>{t.cta}</p>
  <div class="rp-actions" style="margin-top:0"><a class="button gold" href="/contact/" data-track="cta_click" data-track-location="cta_band">{t.ctaButton} <span>↗</span></a><a class="text-link" style="color:#fff" href="/studio/">{t.ctaSecondary} <span>→</span></a></div></div>
</div></section>

<style>
.rp-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);gap:80px;align-items:center;padding-block:64px 56px}
.rp-top{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:26px}
.rp-top .eyebrow{margin:0;display:flex;align-items:center;gap:8px}
.rp-lang{font-size:12px;font-weight:600;padding:6px 14px;border:1px solid var(--line);border-radius:30px}
.rp-lang:hover{background:var(--green)}
.rp-hero h1{font-size:clamp(56px,7.6vw,116px);line-height:.95;letter-spacing:-.065em;margin-bottom:30px}
.rp-hero h1 .rp-h1-role{display:block;margin-top:18px;font-size:clamp(16px,1.55vw,22px);font-weight:600;letter-spacing:-.02em;line-height:1.35;color:var(--muted);max-width:620px}
.rp-hero .lede{font-size:clamp(17px,1.5vw,20px);max-width:620px}
.rp-hero .lede :global(strong){color:var(--ink);font-weight:600}
.rp-hero .lede :global(a){color:var(--ink);text-decoration:underline;text-decoration-color:#9fb085;text-underline-offset:4px}
.rp-actions{display:flex;flex-wrap:wrap;align-items:center;gap:12px 28px;margin-top:34px}
.rp-note{margin-top:34px;padding-top:16px;border-top:1px solid var(--line);font-size:13px;max-width:620px}
.rp-portrait{margin:0;padding:14px;border-radius:20px;background:#e9edde;border:1px solid #d9dfcb;max-width:440px;justify-self:end;width:100%}
.rp-portrait-label,.rp-portrait figcaption{display:flex;justify-content:space-between;gap:12px;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#56664a}
.rp-portrait-label{padding:4px 6px 14px}
.rp-portrait figcaption{padding:14px 6px 4px;letter-spacing:.04em;text-transform:none;font-size:13px;font-weight:600;color:var(--ink)}
.rp-portrait figcaption span:last-child{color:#6b8053;font-size:16px;line-height:1}
.rp-portrait :global(img){width:100%;aspect-ratio:1;object-fit:cover;border-radius:12px;background:#dfe4d4}

.rp-facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0;border-block:1px solid var(--line)}
.rp-facts div{padding:26px 24px}
.rp-facts div:first-child{padding-left:0}
.rp-facts div+div{border-left:1px solid var(--line)}
.rp-facts dt{font-family:Manrope,sans-serif;font-size:clamp(26px,2.6vw,38px);font-weight:500;letter-spacing:-.05em;line-height:1.1}
.rp-facts dd{margin:6px 0 0;font-size:13px;color:var(--muted)}

.rp-origin{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
.rp-origin figure{margin:0}
.rp-origin img{width:100%;aspect-ratio:5/3;object-fit:cover;border-radius:var(--b-radius);background:#1d2b3a}
.rp-origin figcaption{font-size:12px;color:var(--muted);margin-top:10px}
.rp-origin h2{font-size:clamp(36px,4.2vw,60px);line-height:1.04;margin-bottom:24px}
.rp-origin h2 em{display:block;font-style:normal;color:#6b8053}
.rp-origin p{font-size:16px;line-height:1.8}
.rp-path{list-style:none;padding:0;margin:30px 0 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border:1px solid var(--line);border-radius:12px;overflow:hidden}
.rp-path li{padding:14px 16px;background:#fbfaf5;font-size:14px;font-weight:600;line-height:1.35}
.rp-path li+li{border-left:1px solid var(--line)}
.rp-path li:last-child{background:#e9edde}
.rp-path span{display:block;font-size:10px;font-weight:700;letter-spacing:.12em;color:#6b8053;margin-bottom:6px}

.rp-timeline{list-style:none;padding:0;margin:0;border-top:1px solid var(--night-line)}
.rp-timeline li{display:grid;grid-template-columns:190px minmax(0,1fr) minmax(0,1fr);gap:28px;align-items:baseline;padding:16px 0;border-bottom:1px solid var(--night-line);scroll-margin-top:110px}
.rp-years{font-size:13px;font-weight:600;color:var(--gold);font-variant-numeric:tabular-nums}
.rp-studio strong{display:block;font-family:Manrope,sans-serif;font-size:22px;font-weight:500;letter-spacing:-.03em;color:#fff}
.rp-studio span{display:block;font-size:13px;color:var(--night-muted);margin-top:2px}
.rp-detail{font-size:14px;line-height:1.65;color:#d3d8cb}
.rp-detail b{display:inline-block;padding:3px 11px;border:1px solid #c9a45c80;border-radius:30px;color:#fff;font-weight:600;font-size:13px}
.rp-timeline li:target{background:linear-gradient(90deg,#c9a45c1f,transparent 70%)}
.rp-now .rp-studio strong{color:var(--gold)}
a.rp-detail:hover{color:#fff;text-decoration:underline;text-underline-offset:4px}
.rp-proof{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:64px;align-items:start}
.rp-proof .eyebrow{margin-bottom:16px}
.rp-clients{display:flex;flex-wrap:wrap;gap:8px 28px}
.rp-clients span{font-family:Manrope,sans-serif;font-size:clamp(20px,2vw,26px);font-weight:600;letter-spacing:-.03em;color:#cfd5c7}
.rp-quote{margin:0;padding:28px;border-radius:var(--b-radius);background:var(--night-2);border:1px solid var(--night-line)}
.rp-quote blockquote{margin:0 0 20px;font-family:Manrope,sans-serif;font-size:clamp(19px,1.7vw,23px);line-height:1.4;letter-spacing:-.025em;color:#fff}
.rp-quote figcaption{font-size:12px;color:var(--night-muted)}
.rp-quote figcaption a{display:block;color:#fff;font-size:14px;font-weight:600;margin-bottom:2px}
.rp-quote figcaption a:hover{text-decoration:underline;text-underline-offset:4px}

.rp-head-copy{justify-self:end;max-width:430px}
.rp-head-copy p{justify-self:normal}
.rp-head-copy .text-link{margin-top:10px}
.rp-games{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}
.rp-game{display:flex;flex-direction:column;gap:12px}
.rp-game-media{position:relative;display:block;aspect-ratio:4/3;border-radius:12px;overflow:hidden;background:var(--night-2)}
.rp-game-media img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.rp-game:hover .rp-game-media img{transform:scale(1.04)}
.rp-game h3{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-size:24px;margin-top:6px}
.rp-game h3 span{font-size:18px;font-weight:400;transition:transform .2s}
.rp-game:hover h3 span{transform:translate(3px,-2px)}
.rp-game p{font-size:14px;line-height:1.7}

.rp-two{display:grid;grid-template-columns:1fr 1fr;gap:80px}
.rp-two h2{font-size:clamp(32px,3.4vw,48px);margin-bottom:30px}
.rp-two .eyebrow{margin-bottom:16px}
.rp-press-list{display:grid;gap:14px}
.rp-press em{display:block;margin:-10px 0 18px;font-style:normal;font-size:13px;color:var(--muted)}
.rp-press{display:block;padding:30px;border-radius:var(--b-radius);background:#fbfaf5;border:1px solid var(--line);transition:transform .2s,box-shadow .2s}
.rp-press:hover{transform:translateY(-2px);box-shadow:0 14px 30px #1c241a12}
.rp-press small{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#6b8053}
.rp-press strong{display:block;margin:14px 0 22px;font-family:Manrope,sans-serif;font-size:clamp(22px,2.2vw,28px);font-weight:500;line-height:1.25;letter-spacing:-.035em}
.rp-press span{font-size:13px;font-weight:600}
.rp-kit{margin-top:18px;font-size:14px}
.rp-kit a{color:var(--ink);font-weight:600;text-decoration:underline;text-underline-offset:4px;text-decoration-color:#9fb085}
.rp-links{list-style:none;padding:0;margin:0;border-top:1px solid #cdd4c0}
.rp-links a{display:grid;grid-template-columns:minmax(0,1fr) auto 24px;gap:18px;align-items:baseline;padding:15px 0;border-bottom:1px solid #cdd4c0}
.rp-links strong{font-size:16px;font-weight:600}
.rp-links span{font-size:13px;color:var(--muted)}
.rp-links b{font-weight:400;font-size:18px;text-align:right;transition:transform .2s}
.rp-links a:hover strong{text-decoration:underline;text-underline-offset:4px}
.rp-links a:hover b{transform:translate(3px,-2px)}

@media(max-width:1100px){.rp-hero{gap:48px}.rp-games{grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 24px}.rp-timeline li{grid-template-columns:150px minmax(0,1fr) minmax(0,1fr)}}
@media(max-width:800px){
 .rp-hero{grid-template-columns:1fr;padding-block:36px 44px;gap:40px}
 .rp-portrait{justify-self:start;max-width:400px}
 .rp-facts{grid-template-columns:1fr 1fr}.rp-facts div{padding:20px 16px 20px 0}.rp-facts div+div{padding-left:16px}
 .rp-facts div+div:nth-child(3){border-left:0;padding-left:0}.rp-facts div:nth-child(n+3){border-top:1px solid var(--line)}
 .rp-origin,.rp-proof,.rp-two{grid-template-columns:1fr;gap:40px}
 .rp-head-copy{justify-self:start}
 .rp-timeline li{grid-template-columns:1fr;gap:6px;padding:18px 0}
 .rp-detail:empty{display:none}
}
@media(max-width:600px){
 .rp-games{grid-template-columns:1fr}
 .rp-path{grid-template-columns:1fr}.rp-path li+li{border-left:0;border-top:1px solid var(--line)}
 .rp-links a{grid-template-columns:minmax(0,1fr) 24px;gap:2px 12px}.rp-links span{grid-row:2}
 .rp-press{padding:24px}
}
@media(prefers-reduced-motion:reduce){.rp-game-media img,.rp-press,.rp-links b,.rp-game h3 span{transition:none}}
</style>
