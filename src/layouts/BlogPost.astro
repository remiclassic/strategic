---
import Layout from './Layout.astro';
import ArticleCTA from '../components/ArticleCTA.astro';
const { title, description, publishDate, reviewDate, readTime, category } = Astro.props;
const international = /bank|tax|citizen|residen|offshore|passport|wyoming|uae|estonia|flags|asset-protection|nevis|incorporate|wise-vs/i.test(Astro.url.pathname);
---
<Layout title={`${title} — Learn by Strategic Sloth`} description={description}>
<article class="reading-article"><header><a class="text-link" href="/blog/">← All articles</a><p class="eyebrow">{international ? 'INTERNATIONAL BUSINESS' : 'CREATING & INDEPENDENT WORK'} · {readTime} MIN READ</p><h1>{title}</h1><p class="lede">{description}</p><p class="article-date">Published <time datetime={publishDate.toISOString()}>{publishDate.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p></header>
{reviewDate && <p class="article-date">Editorial update <time datetime={reviewDate.toISOString()}>{reviewDate.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p>}
{international && <aside class="reading-notice">{reviewDate ? 'Updated with links to official sources. ' : 'From the learning archive. '}Use this article to prepare questions for a qualified adviser. Eligibility, tax treatment, costs, and reporting depend on your circumstances and current rules.</aside>}
<div class="prose prose-lg reading-prose"><slot/></div><ArticleCTA category={category}/><footer class="reading-next"><p class="eyebrow">KEEP EXPLORING</p><h2>A next step, at your pace.</h2><p>Read another article, try a free planning tool, or explore a book on the topic.</p><div class="hero-actions"><a class="button" href="/blog/">More free articles →</a><a class="text-link" href={international ? '/reading-guide/' : '/books/'}>Explore related books →</a></div></footer></article>
</Layout>
