<script is:inline>
(() => {
	document.querySelectorAll('[data-preview-detail]').forEach((button) => {
		button.addEventListener('click', () => {
			document.querySelectorAll('[data-preview-detail]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
			document.querySelector('.tr-preview-detail').textContent = button.dataset.previewDetail;
		});
	});
	// Gameplay clips: load and play only while a card is on screen.
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const loadVideo = (video) => {
		const source = video.querySelector('source[data-src]');
		if (!source) return;
		source.src = source.dataset.src;
		source.removeAttribute('data-src');
		video.load();
	};
	if ('IntersectionObserver' in window && !reduceMotion) {
		const watcher = new IntersectionObserver((entries) => {
			entries.forEach(({ target, isIntersecting }) => {
				if (isIntersecting) {
					loadVideo(target);
					target.play().then(() => target.classList.add('is-playing')).catch(() => {});
				} else {
					target.pause();
				}
			});
		}, { threshold: 0.55 });
		document.querySelectorAll('.tr-gcard-video').forEach((video) => {
			video.addEventListener('error', () => video.remove(), true);
			watcher.observe(video);
		});
	}
	document.querySelectorAll('[data-case]').forEach((opener) => {
		opener.addEventListener('click', () => {
			const dialog = document.getElementById(`case-${opener.dataset.case}`);
			if (!dialog?.showModal) return;
			const video = dialog.querySelector('video');
			loadVideo(video);
			dialog.showModal();
			if (!reduceMotion) video.play().catch(() => {});
		});
	});
	document.querySelectorAll('.tr-case').forEach((dialog) => {
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog || event.target.closest('[data-case-close]')) dialog.close();
		});
		dialog.addEventListener('close', () => dialog.querySelector('video').pause());
	});
	const game = document.getElementById('network-defense-game');
	const startDemo = (frame, source, cover) => {
		const holder = frame.parentElement;
		const status = holder.querySelector('.tr-demo-loading');
		cover.hidden = true;
		status.hidden = false;
		frame.hidden = false;
		frame.addEventListener('load', () => {
			const started = Date.now();
			const check = () => {
				const globe = frame.contentDocument?.getElementById('globe');
				const ready = !globe || globe.contentDocument?.getElementById('app')?.dataset.ready === 'true';
				if (ready) { status.hidden = true; holder.classList.add('demo-ready'); return; }
				if (Date.now() - started > 120000) { status.textContent = 'Still loading imagery. You can also open the demo full screen below.'; return; }
				setTimeout(check, 250);
			};
			check();
		}, { once: true });
		frame.src = source;
		frame.removeAttribute('data-src');
	};
	document.getElementById('play-network-defense').addEventListener('click', () => {
		startDemo(game, game.dataset.gameSrc, document.getElementById('game-intro'));
		game.focus();
	});
	document.querySelectorAll('.tr-demo-start').forEach((button) => {
		button.addEventListener('click', () => {
			const holder = button.closest('.tr-proto-frame');
			const frame = holder.querySelector('iframe');
			startDemo(frame, frame.dataset.src, button.parentElement);
		}, { once: true });
	});
	// 60-second film: custom play button, chapter seeking, and an end card.
	// The prototype delegates course navigation to its embedding host.
	window.addEventListener('message', (event) => {
		if (event.origin !== window.location.origin || event.source !== game.contentWindow) return;
		if (event.data?.type !== 'range:practice:navigate') return;
		if (event.data.payload?.target === 'study') game.src = game.dataset.gameSrc;
		if (event.data.payload?.target === 'mission') game.contentDocument?.getElementById('go-mission')?.click();
	});
	document.querySelectorAll('.tr-tabs').forEach((list) => {
		const tabs = [...list.querySelectorAll('[role=tab]')];
		const show = (tab, focus) => {
			tabs.forEach((t) => {
				const on = t === tab;
				const panel = document.getElementById(t.getAttribute('aria-controls'));
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				panel.hidden = !on;
			});
			if (focus) tab.focus();
		};
		list.setAttribute('data-ready', '');
		tabs.forEach((t, i) => {
			t.addEventListener('click', () => show(t, false));
			t.addEventListener('keydown', (e) => {
				const n = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
				if (n) { e.preventDefault(); show(tabs[(i + n + tabs.length) % tabs.length], true); }
			});
		});
		const first = tabs[0];
		show(first, false);
	});
})();
</script>


