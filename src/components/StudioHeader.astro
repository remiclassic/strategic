---
const currentPath = Astro.url.pathname;
const codev = currentPath.startsWith('/services/co-development/') || currentPath.startsWith('/services/co-developpement/');
---
<header class="site-header"><div class="container nav-wrap"><a class="brand" href="/" aria-label="Strategic Sloth home"><img src="/studio-images/slothlogo.png" alt="" width="38" height="38"><span>strategic sloth<span class="brand-dot" aria-hidden="true">✳</span></span></a><button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" type="button">Menu <span aria-hidden="true">＋</span></button><nav id="primary-nav" aria-label="Primary"><a href="/services/" aria-current={currentPath.startsWith("/services/") && !codev ? "page" : undefined}>Services</a><a href="/services/co-development/" aria-current={codev ? "page" : undefined}><span class="nav-full">Co-development</span><span class="nav-short" aria-hidden="true">Co-dev</span></a><a href="/work/" aria-current={currentPath.startsWith("/work/") ? "page" : undefined}>Work</a><a href="/pricing/" aria-current={currentPath.startsWith("/pricing/") ? "page" : undefined}>Pricing</a><a href="/studio/" aria-current={currentPath.startsWith("/studio/") ? "page" : undefined}>Studio</a><a href="/games/" aria-current={currentPath.startsWith("/games/") ? "page" : undefined}>Our games</a><a class="nav-contact" href="/contact/">Start a project <span aria-hidden="true">↗</span></a></nav></div></header>
<style is:global>.site-header .nav-short{display:none}@media(min-width:801px) and (max-width:1180px){.site-header .nav-full{display:none}.site-header .nav-short{display:inline}}</style>