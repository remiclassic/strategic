---
import StarterOffer from '../../components/StarterOffer.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a,b) => b.data.publishDate.valueOf()-a.data.publishDate.valueOf());
const topic = (slug: string) => /bank|tax|citizen|residen|offshore|passport|wyoming|uae|estonia|flags|asset-protection|nevis|incorporate|wise-vs/i.test(slug) ? 'international' : 'creator';
---
<Layout title="Articles — Learn by Strategic Sloth" description="Free reading on digital products, independent work, and international business. Browse the Strategic Sloth article library.">
<section class="page-intro container"><p class="eyebrow">LEARN / FREE ARTICLES</p><h1>Follow your curiosity.</h1><p class="lede">Notes, guides, and ideas for independent work.<br/>Find a question worth exploring.</p></section>
<section class="section container"><div class="article-controls"><label for="article-search">Find an article<input id="article-search" type="search" placeholder="Search titles and topics…"/></label><div class="filters" role="group" aria-label="Article topics"><button type="button" data-topic="all" aria-pressed="true">All articles</button><button type="button" data-topic="creator" aria-pressed="false">Creating & independent work</button><button type="button" data-topic="international" aria-pressed="false">International business</button></div></div><p class="results-count" id="article-count" aria-live="polite">{posts.length} articles</p><div class="learning-grid">{posts.map(post => <a class="learning-card article-card" href={`/blog/${post.slug}/`} data-article-topic={topic(post.slug)} data-search={`${post.data.title} ${post.data.description}`.toLowerCase()}><span class="card-number">{topic(post.slug)==='international'?'INTERNATIONAL BUSINESS':'CREATING & INDEPENDENT WORK'} · {post.data.readTime} MIN</span><h2>{post.data.title}</h2><p>{post.data.description}</p><time datetime={post.data.publishDate.toISOString()}>{post.data.publishDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><span class="text-link">Read article →</span></a>)}</div><p id="article-empty" class="learning-note" hidden>No articles match that search. Try a shorter phrase or another topic.</p></section>
<StarterOffer location="article-index"/></Layout>
<script>
let currentTopic = 'all';
const search = document.querySelector<HTMLInputElement>('#article-search')!;
const buttons = document.querySelectorAll<HTMLButtonElement>('[data-topic]');
const articles = document.querySelectorAll<HTMLElement>('[data-article-topic]');
function filterArticles(){let count=0; articles.forEach(article => {article.hidden = (currentTopic!=='all' && article.dataset.articleTopic!==currentTopic) || !article.dataset.search!.includes(search.value.trim().toLowerCase());if(!article.hidden)count++;});document.querySelector('#article-count')!.textContent=`${count} ${count === 1 ? "article" : "articles"}`;document.querySelector<HTMLElement>('#article-empty')!.hidden=count!==0;}
search.addEventListener('input',filterArticles); buttons.forEach(button => button.addEventListener('click',()=>{currentTopic=button.dataset.topic!;buttons.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));filterArticles();}));
</script>
