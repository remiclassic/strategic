---
import StudioLayout from '../layouts/StudioLayout.astro';
import '../styles/training.css';
import {
	bookHref, isCalendar, CONTACT_EMAIL, PORTFOLIO_URL, LINKEDIN_URL,
	proof, offers, showcase, steps, workFacts, workLead, workShots, prototypes, forList, notForList, capabilities, faqs,
} from '../data/training';

const external = isCalendar() ? { target: '_blank', rel: 'noopener' } : {};
const demo = bookHref('Training demo');
const artClass: Record<string, string> = { range: '', minigames: 'lilac', tools: 'peach' };
---
<StudioLayout
	title="Training & simulation UX | Strategic Sloth"
	description="Training UX for cyber ranges and serious games, from onboarding to mission flow, plus our own range and minigames to pilot. Book a 20-minute demo."
>
<div class="tr">

<section class="container tr-hero" aria-labelledby="tr-title">
	<div>
		<p class="eyebrow">TRAINING &amp; SIMULATION</p>
		<h1 id="tr-title">Cyber training your trainees finish.</h1>
		<p class="lede">We design and build UX for cyber ranges, serious games, and Unreal training products. Commercial cyber range experience, plus our own range and minigames you can pilot with your learners.</p>
		<div class="hero-actions">
			<a class="button" href={demo} {...external}>Book a 20-min demo <span aria-hidden="true">↗</span></a>
			<a class="text-link" href="#selected-work">See the work <span aria-hidden="true">↓</span></a>
		</div>
		<p class="tr-hero-note">Founder-led by Rémi Couture. Nearly 20 years in game UI and UX.</p>
	</div>
	<div class="tr-canvas" role="img" aria-label="Illustration of a trainer console. Four trainees are on objective 3 of 5, and one is flagged as needing a hint.">
		<div class="tr-console" aria-hidden="true">
			<div class="tr-console-bar"><strong>Contain the beacon</strong><span>Cohort B · 42 min</span></div>
			<div class="tr-objectives"><i class="done"></i><i class="done"></i><i class="now"></i><i></i><i></i></div>
			<p class="tr-objective-label">Objective 3 of 5: isolate the infected host</p>
			<ul class="tr-roster">
				<li><span class="tr-avatar">JM</span><span><b>J. Moreno</b><small>Firewall rule applied</small></span><span class="tr-meter"><i style="width:72%"></i></span><em>On track</em></li>
				<li class="stuck"><span class="tr-avatar">AK</span><span><b>A. Kim</b><small>No progress for 9 min</small></span><span class="tr-meter"><i style="width:38%"></i></span><em>Needs a hint</em></li>
				<li><span class="tr-avatar">SP</span><span><b>S. Patel</b><small>Reviewing logs</small></span><span class="tr-meter"><i style="width:60%"></i></span><em>On track</em></li>
				<li><span class="tr-avatar">LT</span><span><b>L. Tran</b><small>Objective 4 unlocked</small></span><span class="tr-meter"><i style="width:84%"></i></span><em>Ahead</em></li>
			</ul>
		</div>
		<p class="tr-callout" aria-hidden="true"><strong>Send hint 2 of 3</strong>Points to the DNS logs without giving the answer.</p>
		<span class="image-label" aria-hidden="true">TRAINER VIEW · ILLUSTRATION</span>
	</div>
</section>

<section class="container" aria-label="Experience">
	<div class="tr-proof">
		{proof.map((p) => <div><strong>{p.title}</strong><span>{p.detail}</span></div>)}
	</div>
</section>

<section class="section container" id="offers" aria-labelledby="offers-title">
	<div class="section-heading">
		<div><p class="eyebrow">WAYS TO START</p><h2 id="offers-title">Start small. Keep what works.</h2></div>
		<p>Every engagement starts with a fixed scope and a clear end point.</p>
	</div>
	<div class="tr-offers">
		{offers.map((o) => (
			<article class:list={['tr-offer', o.id === 'pilot' && 'pilot']}>
				<div class="tr-offer-head"><h3>{o.title}</h3><span class="tr-offer-length">{o.length}</span></div>
				<p class="tr-offer-price">{o.price}</p>
				<p class="tr-offer-outcome">{o.outcome}</p>
				<ul>{o.includes.map((i) => <li>{i}</li>)}</ul>
				<a class="button" href={bookHref(o.title)} {...external}>{o.cta} <span aria-hidden="true">↗</span></a>
			</article>
		))}
	</div>
</section>

<section class="section container compact" id="showcase" aria-labelledby="showcase-title">
	<div class="section-heading">
		<div><p class="eyebrow">OUR PLATFORM</p><h2 id="showcase-title">Built, running, and ready to demo.</h2></div>
		<p>Our own training products, available to pilot or license.</p>
	</div>
	<div class="tr-tabs" role="tablist" aria-label="Products">
		{showcase.map((s, i) => (
			<button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.tab}</button>
		))}
	</div>
	{showcase.map((s) => (
		<article class="tr-panel" id={`panel-${s.id}`} role="tabpanel" aria-labelledby={`tab-${s.id}`}>
			<div class:list={['tr-panel-art', artClass[s.id]]}>
				{s.shots.length > 0 ? (
					<div class="tr-shots">{s.shots.map((shot) => <img src={shot.src} alt={shot.alt} loading="lazy" width="1600" height="900" />)}</div>
				) : s.id === 'range' ? (
					<div class="tr-mission" aria-hidden="true">
						<div class="tr-mission-top"><span>Mission 3</span><span>Blue team · 30 min</span></div>
						<h4>Contain the beacon</h4>
						<p>A workstation is calling out to an unknown host. Find it and cut it off.</p>
						<ol><li class="done"><span></span>Find the beaconing host</li><li class="done"><span></span>Confirm the domain</li><li class="now"><span></span>Isolate the infected host</li><li><span></span>Write the incident note</li></ol>
					</div>
				) : s.id === 'minigames' ? (
					<div class="tr-games" aria-hidden="true">
						<div class="tr-game"><b>Spot the phish</b><small>8 min · Awareness</small><i style="--w:80%"></i></div>
						<div class="tr-game"><b>Passphrase lab</b><small>6 min · Awareness</small><i style="--w:55%"></i></div>
						<div class="tr-game"><b>Triage desk</b><small>10 min · Analyst</small><i style="--w:40%"></i></div>
						<div class="tr-game"><b>Log hunt</b><small>12 min · Analyst</small><i style="--w:65%"></i></div>
					</div>
				) : (
					<div class="focus-demo" aria-hidden="true"><div class="demo-top"><span>FOCUSRAIL / UMG</span><span>FOCUS MEMORY</span></div><div class="demo-menu"><span>Mission briefing</span><span class="selected">Network map <b>← Focus restored</b></span><span>Submit report</span></div><div class="demo-bottom">Keyboard and controller, one focus model.</div></div>
				)}
			</div>
			<div class="tr-panel-copy">
				<span class:list={['status', s.id !== 'tools' && 'launch']}>{s.status}</span>
				<h3>{s.name}</h3>
				<p>{s.body}</p>
				{s.link ? (
					<a class="text-link" href={s.link} target="_blank" rel="noopener">View on Fab <span aria-hidden="true">↗</span></a>
				) : (
					<a class="text-link" href={bookHref(`${s.name} demo`)} {...external}>Book a demo <span aria-hidden="true">↗</span></a>
				)}
			</div>
		</article>
	))}
</section>

<section class="section container compact" id="selected-work" aria-labelledby="work-title">
	<div class="section-heading">
		<div><p class="eyebrow">SELECTED WORK</p><h2 id="work-title">A first-time experience for a gamified cyber range.</h2></div>
		<p>From first login to first activity. Client branding removed.</p>
	</div>
	<figure class="tr-work-lead">
		<a href={workLead.src} target="_blank" rel="noopener"><img src={workLead.src} alt={workLead.alt} width="1600" height="900" loading="lazy" /></a>
		<figcaption>{workLead.caption}</figcaption>
	</figure>
	<div class="tr-work-facts">
		{workFacts.map((f) => <div><strong>{f.title}</strong><span>{f.body}</span></div>)}
	</div>
	<div class="tr-work-grid">
		{workShots.map((s) => (
			<figure>
				<a href={s.src} target="_blank" rel="noopener" aria-label={`Open full size: ${s.caption}`}><img src={s.src} alt={s.alt} width="1600" height="900" loading="lazy" /></a>
				<figcaption>{s.caption}</figcaption>
			</figure>
		))}
	</div>
</section>

<section class="section container compact" id="prototypes" aria-labelledby="proto-title">
	<div class="section-heading">
		<div><p class="eyebrow">CLICK-THROUGH PROTOTYPES</p><h2 id="proto-title">Try the flows yourself.</h2></div>
		<p>Working HTML prototypes with sample content. Click the buttons inside the frame to move through each flow.</p>
	</div>
	<div class="tr-tabs tr-proto-tabs" role="tablist" aria-label="Prototypes">
		{prototypes.map((p, i) => (
			<button type="button" role="tab" id={`ptab-${p.id}`} aria-controls={`proto-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{p.tab}</button>
		))}
	</div>
	{prototypes.map((p, i) => (
		<article class="tr-proto" id={`proto-${p.id}`} role="tabpanel" aria-labelledby={`ptab-${p.id}`}>
			<div class="tr-proto-frame">
				<iframe data-src={p.src} title={`${p.tab} prototype`} loading="lazy" allow="fullscreen"></iframe>
				<img src={p.poster} alt="" width="1600" height="900" loading="lazy" />
			</div>
			<div class="tr-proto-meta">
				<div><strong>{p.title}</strong><span>{p.note}</span></div>
				<a class="text-link" href={p.src} target="_blank" rel="noopener">Open full screen <span aria-hidden="true">↗</span></a>
			</div>
		</article>
	))}
</section>

<section class="section container compact" aria-labelledby="how-title">
	<div class="engagement-process">
		<p class="eyebrow">HOW IT WORKS</p>
		<h2 id="how-title">From first call to pilot in weeks.</h2>
		<ol>{steps.map((s) => <li><strong>{s.title}</strong><p>{s.body}</p></li>)}</ol>
	</div>
</section>

<section class="section container compact" aria-labelledby="fit-title">
	<h2 id="fit-title" class="sr-only">Who this is for</h2>
	<div class="tr-fit">
		<div class="yes"><h3>A good fit</h3><ul>{forList.map((i) => <li>{i}</li>)}</ul></div>
		<div class="no"><h3>Not a fit</h3><ul>{notForList.map((i) => <li>{i}</li>)}</ul></div>
	</div>
</section>

<section class="studio-section" aria-labelledby="cap-title">
	<div class="container tr-capability">
		<div>
			<p class="eyebrow">CAPABILITY</p>
			<h2 id="cap-title">What cyber training UX actually needs.</h2>
			<p>Training platforms serve two people at once: the trainee working through a hard problem, and the instructor keeping a whole cohort moving. Most of the work is making both feel in control.</p>
			<div class="tr-capability-links">
				<a class="text-link" href={PORTFOLIO_URL} target="_blank" rel="noopener">Portfolio <span aria-hidden="true">↗</span></a>
				<a class="text-link" href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
			</div>
		</div>
		<dl>{capabilities.map((c) => <div><dt>{c.title}</dt><dd>{c.body}</dd></div>)}</dl>
	</div>
</section>

<section class="section container" aria-labelledby="faq-title">
	<div class="project-faq">
		<p class="eyebrow">QUESTIONS</p>
		<h2 id="faq-title">Before you book.</h2>
		{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
	</div>
</section>

<section class="container" style="padding-bottom:100px" aria-labelledby="final-title">
	<div class="contact-panel tr-final">
		<div>
			<p class="eyebrow">BOOK A DEMO</p>
			<h2 id="final-title">See it running in 20 minutes.</h2>
			<p>We’ll walk through the range and minigames, look at what you’re building, and tell you honestly whether a sprint or pilot makes sense. Prefer email? Send your company name and what you want to improve.</p>
		</div>
		<div class="tr-final-actions">
			<a class="button" href={demo} {...external}>Book a 20-min demo <span aria-hidden="true">↗</span></a>
			<a class="contact-address" href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('[StrategicSloth] Training')}`}>{CONTACT_EMAIL}</a>
		</div>
	</div>
</section>

</div>
</StudioLayout>

<script is:inline>
(() => {
	const load = (panel) => {
		const f = panel && panel.querySelector('iframe[data-src]');
		if (f && window.matchMedia('(min-width: 801px)').matches) { f.src = f.dataset.src; f.removeAttribute('data-src'); }
	};
	document.querySelectorAll('.tr-tabs').forEach((list) => {
		const tabs = [...list.querySelectorAll('[role=tab]')];
		const show = (tab, focus) => {
			tabs.forEach((t) => {
				const on = t === tab;
				const panel = document.getElementById(t.getAttribute('aria-controls'));
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				panel.hidden = !on;
				if (on) load(panel);
			});
			if (focus) tab.focus();
		};
		list.setAttribute('data-ready', '');
		tabs.forEach((t, i) => {
			t.addEventListener('click', () => show(t, false));
			t.addEventListener('keydown', (e) => {
				const n = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
				if (n) { e.preventDefault(); show(tabs[(i + n + tabs.length) % tabs.length], true); }
			});
		});
		const first = tabs[0];
		const panel = document.getElementById(first.getAttribute('aria-controls'));
		if (panel.querySelector('iframe[data-src]') && 'IntersectionObserver' in window) {
			tabs.forEach((t) => { document.getElementById(t.getAttribute('aria-controls')).hidden = t !== first; });
			const io = new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting)) { show(tabs.find((t) => t.getAttribute('aria-selected') === 'true') || first, false); io.disconnect(); } }, { rootMargin: '300px' });
			io.observe(list);
		} else {
			show(first, false);
		}
	});
})();
</script>
