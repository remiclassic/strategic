---
import ProductEvidence from '../components/ProductEvidence.astro';
import StudioReel from '../components/StudioReel.astro';
import CaseStudyIndex from '../components/CaseStudyIndex.astro';
import CraftDetails from '../components/CraftDetails.astro';
import FounderInvite from '../components/FounderInvite.astro';
import StudioLayout from '../layouts/StudioLayout.astro';
const steps = [
  ['Understand the task', 'Start with the person, their goal, and the constraints: platform, input method, content, and engine.', 'A brief, a user journey, and the moments that need attention.'],
  ['Find the visual direction', 'Explore hierarchy, composition, and visual language on representative screens before expanding the system.', 'A focused direction with screen studies and reusable patterns.'],
  ['Make it behave', 'Connect the flow. Work through navigation, selected states, feedback, and how someone gets back when they take a wrong turn.', 'A prototype to review through actual interaction.'],
  ['Prepare the handoff', 'Bring layouts, components, assets, and behavior notes together so the next step is clear for implementation.', 'An organized interface system and implementation guidance.'],
];
---
<StudioLayout title="Work & process — Strategic Sloth" description="See Strategic Sloth’s interface work through project screens, a training film, interactive prototypes, and the design process behind them.">
  <section class="page-intro container"><p class="eyebrow">SELECTED WORK / INSIDE THE PROCESS</p><h1>Work you can inspect.<br>Craft you can feel.</h1><p class="lede">Interfaces you can inspect. Flows you can try. A closer look at how a visual idea becomes something people can use.</p><div class="hero-actions"><a class="button" href="#studio-reel">Watch the studio reel <span>↓</span></a><a class="text-link" href="#process">See the process →</a></div></section>
  <nav class="container work-index" aria-label="Work on this page"><a href="#sliceforge">01 / SliceForge</a><a href="#evidence-drivedeck">DriveDeck</a><a href="#evidence-narriaflow">NarriaFlow</a><a href="#evidence-focusrail">Focusrail</a><a href="#evidence-world-editor">World Editor</a><a href="/work/real-estate/">Real Estate 3D</a><a href="#training">02 / Training UX</a><a href="#directions">03 / Game UI studies</a><a href="#process">04 / Process</a></nav>
  <StudioReel /><CaseStudyIndex />
  <section class="section container work-case" id="sliceforge"><div class="section-heading"><div><p class="eyebrow">01 / STUDIO PRODUCT · AVAILABLE</p><h2>SliceForge.<br>Beyond the flat mockup.</h2></div><p>Game UI production / Editable layouts / Component states</p></div><figure class="work-wide"><img src="/studio-images/sf-compose.webp" alt="Fantasy alchemy game interface arranged in the SliceForge Compose editor" width="1536" height="1024" loading="lazy"><figcaption>SliceForge Compose — an interface arranged in the editor.</figcaption></figure><div class="work-details"><div><h3>The problem</h3><p>A promising reference still needs layout structure, reusable elements, and interaction states before it becomes a buildable interface.</p></div><div><h3>The design decision</h3><p>Keep the screen and its parts in one workflow, so composition, component refinement, and export stay connected.</p></div><div><h3>Look closer</h3><p>Notice the screen hierarchy, the surrounding editor controls, and how repeated interface elements form a system.</p><a class="text-link" href="https://www.sliceforge.io/" target="_blank" rel="noopener">Try SliceForge ↗</a></div></div><details class="work-closeup"><summary>Inspect another workspace view <span>＋</span></summary><figure><img src="/studio-images/sf-workspace.webp" alt="Science-fiction game UI shown inside the SliceForge workspace" width="1536" height="1024" loading="lazy"><figcaption>A second visual direction in the workspace. Compare the layout and repeated components.</figcaption></figure></details></section>
  <ProductEvidence /><CraftDetails />
  <section class="section container work-case" id="training"><div class="section-heading"><div><p class="eyebrow">02 / TRAINING &amp; SIMULATION · PROTOTYPE WORK</p><h2>A clear path<br>to the first activity.</h2></div><p>Onboarding / Learning paths / Mission briefings</p></div><figure class="work-wide work-film"><video controls playsinline preload="none" poster="/training/video/training-film-poster.jpg" aria-label="Training interface showcase, one minute"><source src="/training/video/training-film-60s.mp4" type="video/mp4">Your browser cannot play this video. <a href="/training/video/training-film-60s.mp4">Open the training film</a>.</video><figcaption>Training interface film · 60 seconds · Press play to load. Explore the screens and clickable flow below.</figcaption></figure><div class="work-details"><div><h3>The problem</h3><p>A learner needs to understand what to choose, what a path requires, and how to begin without getting lost in the platform.</p></div><div><h3>The design decision</h3><p>Show commitment before selection, keep module order visible, and give the briefing its own clear place before the activity.</p></div><div><h3>Try the flow</h3><p>Choose a learning path, inspect its modules, and follow the route toward an activity in the SOC prototype.</p><a class="text-link" href="/training/proto/soc-direct/01-paths.html" target="_blank" rel="noopener">Open interactive prototype ↗</a></div></div><div class="work-screen-pair"><figure><img src="/training/work/range-01-path-picker.webp" alt="Learning path picker showing three paths with module count and time" loading="lazy"><figcaption>01 / Choose a path — show the commitment before the click.</figcaption></figure><figure><img src="/training/work/range-02-path-detail.webp" alt="Path detail showing module order and the selected module" loading="lazy"><figcaption>02 / Inspect the modules — keep the next step in context.</figcaption></figure></div><a class="text-link" href="/training/">Explore more training screens &amp; demos →</a></section>
  <section class="section container work-case" id="directions"><div class="section-heading"><div><p class="eyebrow">03 / GAME UI · VISUAL DIRECTION STUDIES</p><h2>One system.<br>A world of character.</h2></div><p>These collection mockups explore visual direction. They are concept studies, not footage from released games.</p></div><div class="work-screen-pair"><a href="/game-ui/modern-essentials/"><img src="/images/game-ui/modern-essentials/02-main-menu.webp" alt="Modern Essentials game interface direction" loading="lazy"><h3>Modern Essentials →</h3><p>Explore menus, gameplay, inventory, and settings as a consistent collection.</p></a><a href="/game-ui/havenworks/"><img src="/images/game-ui/havenworks/10-workforce.webp" alt="Havenworks workforce management interface study" loading="lazy"><h3>Havenworks →</h3><p>Inspect hierarchy and information density in a strategy and simulation direction.</p></a></div></section>
  <section class="section container" id="process"><div class="section-heading"><div><p class="eyebrow">04 / HOW WE APPROACH THE WORK</p><h2>From the first question<br>to the last detail.</h2></div><p>The process connects visual craft with the task a person is trying to complete. Scope and deliverables depend on the project.</p></div><ol class="work-process">{steps.map(([title, body, output], i) => <li><span class="eyebrow">0{i + 1}</span><h3>{title}</h3><p>{body}</p><p class="work-output"><strong>What takes shape</strong>{output}</p></li>)}</ol></section>
  <FounderInvite />
</StudioLayout>
<style>
  .work-index{display:flex;gap:24px;flex-wrap:wrap;border-block:1px solid var(--line);padding-block:22px;font-size:12px}.work-index a{color:inherit}.work-case{border-bottom:1px solid var(--line);scroll-margin-top:100px}.work-wide{margin:0}.work-wide img,.work-wide video{width:100%;display:block;border:1px solid var(--line);border-radius:12px}.work-film video{aspect-ratio:16/9;background:#141b1c}.work-case figcaption{font-size:12px;color:var(--muted);padding:14px 0;line-height:1.6}.work-details{display:grid;grid-template-columns:repeat(3,1fr);gap:36px;margin:30px 0}.work-details h3,.work-process h3{font-size:22px;margin-bottom:15px}.work-details p,.work-process p,.work-screen-pair p{font-size:14px;line-height:1.8;color:var(--muted)}.work-closeup{border-block:1px solid var(--line);margin-top:35px}.work-closeup summary{cursor:pointer;padding:22px 0;font-size:14px}.work-closeup summary span{float:right}.work-closeup img{width:100%;border-radius:8px}.work-screen-pair{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin:35px 0}.work-screen-pair figure{margin:0}.work-screen-pair img{width:100%;aspect-ratio:16/10;object-fit:contain;background:#182125;border-radius:10px;display:block}.work-screen-pair>a{color:inherit;text-decoration:none}.work-screen-pair h3{font-size:24px;margin:20px 0 10px}.work-process{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:28px}.work-process li{border-top:2px solid var(--ink);padding-top:22px}.work-process h3{margin-top:22px}.work-output{border-top:1px solid var(--line);padding-top:18px;margin-top:24px}.work-output strong{display:block;color:var(--ink);font-size:11px;margin-bottom:8px}@media(max-width:850px){.work-details{grid-template-columns:1fr;gap:22px}.work-process{grid-template-columns:1fr 1fr}}@media(max-width:600px){.work-screen-pair,.work-process{grid-template-columns:1fr}.work-index{gap:16px}.work-screen-pair img{aspect-ratio:auto}.work-process{gap:30px}}
</style>
