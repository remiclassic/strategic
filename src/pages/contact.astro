---
import StudioLayout from "../layouts/StudioLayout.astro";
import { packages, RESPONSE_TIME, DAY_RATE } from '../data/studio';
import '../styles/boutique.css';
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || "";
---
<StudioLayout title="Hire a Game UI/UX Designer: Start a Project | Strategic Sloth" description="Send a screen, a flow or a build. Get a reply with where to start, a written scope and a fixed price. NDA on request.">
<section class="b-intro container"><p class="eyebrow">START A PROJECT</p><h1>Tell us what <em>you’re building.</em></h1><p class="lede">Send a screen, a build or an idea. Remi replies personally {RESPONSE_TIME} with a suggested first step and a price. Every project starts with a written scope.</p>
<div class="b-facts" style="margin-top:40px"><div><span>Reply</span><strong>{RESPONSE_TIME}</strong></div><div><span>Smallest step</span><strong>$490 screen review</strong></div><div><span>Day rate</span><strong>{DAY_RATE.price} {DAY_RATE.unit}</strong></div><div><span>Time zone</span><strong>Eastern Time · Montreal</strong></div></div></section>
<section class="section container compact"><div class="contact-panel enquiry-panel" id="enquiry"><div><p class="eyebrow">YOUR PROJECT</p><h2>A few details.</h2><p>Pick the package you have in mind, or “Not sure yet”. A budget range helps us suggest the right scope. <a class="text-link" href="/pricing/">See all prices <span>→</span></a></p></div><form class="enquiry-form" data-studio-enquiry data-endpoint={contactEndpoint} aria-label="Project enquiry">
<div class="enquiry-fields">
<label>Your name<input name="name" autocomplete="name" required maxlength="120"></label>
<label>Email address<input name="email" type="email" autocomplete="email" required maxlength="254"></label>
<label>What you need<select name="projectType" required><option value="">Choose a package</option>{packages.map(p => <option value={p.name} data-pkg={p.id}>{p.name} · {p.from ? 'from ' : ''}{p.price}{p.unit ? ' ' + p.unit : ''}</option>)}<option value="Local business website or app" data-pkg="local">Local business website or app</option><option value="Not sure yet">Not sure yet</option><option value="Other">Something else</option></select></label>
<label>Budget range <span>(optional)</span><select name="budget"><option value="">Prefer to discuss</option><option>Under $3,000</option><option>$3,000–$10,000</option><option>$10,000–$25,000</option><option>$25,000–$50,000</option><option>$50,000+</option></select></label>
<label class="enquiry-wide">Timeline<input name="timeline" maxlength="160" placeholder="When would you like to start?" required></label>
<label class="form-trap" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"></label>
<label class="enquiry-wide">Project details<textarea name="message" rows="7" required maxlength="6000" placeholder="What are you building? Engine or stack, platform, what exists today, and links to a build, screenshots or a video."></textarea></label>
</div>
<p class="enquiry-help">Project details are used to respond to your enquiry. <a href="/legal/privacy/">Privacy policy</a>.</p>
<div class="enquiry-actions"><button class="button" type="submit">{contactEndpoint ? 'Send project enquiry' : 'Open email draft'} <span aria-hidden="true">↗</span></button></div>
<p class="enquiry-help" data-send-status role="status" aria-live="polite">{contactEndpoint ? 'Send your enquiry directly. We’ll confirm receipt here.' : 'Direct submission is not available yet. Review and send this enquiry in your email app, or use the email address below.'}</p>
<noscript><p>Email <a href="mailto:privacy@strategicsloth.com">privacy@strategicsloth.com</a> to discuss your project.</p></noscript>
</form><p class="contact-address">privacy@strategicsloth.com</p></div><section class="project-faq" aria-labelledby="faq-title"><p class="eyebrow">BEFORE WE TALK</p><h2 id="faq-title">A few useful details.</h2><details><summary>Who will I work with?</summary><p>Remi Couture leads every project personally. Trusted engineers, artists and producers join under the same lead when the scope needs them.</p></details><details><summary>Can we start with a focused piece of work?</summary><p>Yes. A UI review, a menu flow, or a component system can be a useful starting point. We’ll agree on a scope that fits the problem.</p></details><details><summary>What should I include in my enquiry?</summary><p>A short project overview, your engine or platform, the help you need, and your target timing. A budget range also helps shape a realistic scope.</p></details></section></section>
</StudioLayout>
<script>
 // Pre-select the package from ?engagement=<package id>; older links used review / prototype / partner.
 const form = document.querySelector<HTMLFormElement>('[data-studio-enquiry]');
 const legacy: Record<string, string> = { prototype: 'slice' };
 const id = new URLSearchParams(location.search).get('engagement');
 if (form && id) {
   const select = form.elements.namedItem('projectType') as HTMLSelectElement;
   const option = [...select.options].find(o => o.dataset.pkg === (legacy[id] || id));
   if (option) select.value = option.value;
 }
</script>

<script>
import { trackStudioEvent } from '../utils/studio-tracking';
const enquiry = document.querySelector<HTMLFormElement>('[data-studio-enquiry]');
if (enquiry) {
 const status = enquiry.querySelector<HTMLElement>('[data-send-status]')!;
 const submit = enquiry.querySelector<HTMLButtonElement>('button[type=submit]')!;
 let started = false;
 enquiry.addEventListener('input', () => { if (!started) { started = true; trackStudioEvent('enquiry_start', { location: 'contact' }); } });
 enquiry.addEventListener('submit', async event => {
  event.preventDefault(); if (!enquiry.reportValidity() || submit.disabled) return;
  const data = Object.fromEntries(new FormData(enquiry));
  if (data.website) return;
  const endpoint = enquiry.dataset.endpoint;
  if (!endpoint) {
   const body = ['Name: '+data.name, 'Email: '+data.email, 'Project: '+data.projectType, 'Budget: '+(data.budget || 'To discuss'), 'Timeline: '+data.timeline, '', data.message].join('\n');
   location.href = 'mailto:privacy@strategicsloth.com?subject='+encodeURIComponent('[StrategicSloth] '+data.projectType)+'&body='+encodeURIComponent(body);
   status.textContent = 'Your email draft is ready. Please review and send it in your email app. If no app opens, copy your details and email privacy@strategicsloth.com.';
   trackStudioEvent('enquiry_email_handoff', { location: 'contact' }); return;
  }
  submit.disabled = true; status.textContent = 'Sending your enquiry…';
  try {
   const response = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ ...data, subject: '[StrategicSloth] '+data.projectType }) });
   if (!response.ok) throw new Error('Delivery failed');
   status.textContent = 'Thank you. Your enquiry has been received. We’ll reply to the email address you provided.';
   trackStudioEvent('enquiry_submit', { location: 'contact', project_type: String(data.projectType) });
   enquiry.reset(); started = false;
  } catch { status.textContent = 'Your enquiry could not be sent. Your details are still here. Please try again or email privacy@strategicsloth.com.'; }
  finally { submit.disabled = false; }
 });
}
</script>
