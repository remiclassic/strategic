.military-gallery .featured{background:#20221d}.military-gallery dialog{background:#20221d;color:#e5e2d4;border-color:#7e8267}.military-gallery .enlarge-label{background:#20221ded;color:#e5e2d4;border-color:#aaa58e}.military-gallery .thumbnails button[aria-pressed=true]{border-color:#717955;box-shadow:0 0 0 1px #717955;background:#e8e9de}
