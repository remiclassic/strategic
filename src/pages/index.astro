---
import ProfessionalWorkPreview from '../components/ProfessionalWorkPreview.astro';
import StudioLayout from '../layouts/StudioLayout.astro';
import StudioReel from '../components/StudioReel.astro';
import FounderInvite from '../components/FounderInvite.astro';
import EngagementOptions from '../components/EngagementOptions.astro';

// The three things clients hire us for. Same split as Remi's portfolio, each with its own sped-up screen-share.
const services = [
 { id:'ux', anchor:'ux', num:'01', name:'UX design', tagline:'How it works.', body:'We work out what the player or user needs, the path they take, and what happens when something goes wrong, before anyone draws a final screen.', gets:['User flows & journey maps','Wireframes & prototypes','UX audits of a live build'], roles:'For teams who need: a UX designer, a UX lead, or a second opinion on a flow' },
 { id:'ui', anchor:'ui', num:'02', name:'UI design', tagline:'How it looks.', body:'We turn the wireframe into finished screens: a visual language, a component library with every state, and menus and HUDs that read at a glance.', gets:['Look development on real screens','Component libraries & UI kits','Menus, HUD, store & settings'], roles:'For teams who need: a UI designer, a UI artist, or a design system' },
 { id:'build', anchor:'motion', num:'03', name:'Motion + implementation', tagline:'How it moves and ships.', body:'We animate the interface and build it where it runs: Unreal UMG and CommonUI, Unity, Godot and the web, with controller navigation that works.', gets:['UI animation & feedback','Unreal, Unity & web implementation','Controller & keyboard navigation'], roles:'For teams who need: a technical UI designer or a UI engineer' },
];
---
<StudioLayout title="Game UI & UX studio — Strategic Sloth" description="Strategic Sloth designs game and product interfaces and builds them in your engine: UX design, UI design, and motion and implementation in Unreal, Unity and the web. Founder-led by Remi Couture.">
<section class="studio-hero container">
 <div class="studio-hero-top"><p class="eyebrow"><span class="live-dot"></span> GAME UI &amp; UX STUDIO · FOUNDER-LED</p><span class="hero-coordinate">UX · UI · MOTION + IMPLEMENTATION</span></div>
 <div class="studio-hero-copy"><h1>Game UI and UX,<br>designed and built<br><span>in your engine.</span></h1><div><p class="lede">We design how your game or app works, how it looks, and build it in Unreal, Unity or the web. Led by Remi Couture, twenty years in game UI.</p><div class="hero-actions"><a class="button" href="/contact/" data-track="service_cta" data-track-location="hero">Start a project <span>↗</span></a><a class="text-link" href="#what-we-do" data-track="service_cta" data-track-location="hero-services">What we do <span>↓</span></a></div><p class="hero-footnote">Hire us for one discipline or the whole pipeline. Every project starts with a written scope.</p></div></div>
 <a class="hero-showcase" href="#studio-reel" aria-label="Watch the Strategic Sloth studio reel"><img src="/studio-images/sf-compose.webp" alt="An editable fantasy game interface inside the SliceForge editor" width="1536" height="1024" fetchpriority="high"/><div class="showcase-overlay"><span>FROM CONCEPT TO SOMETHING YOU CAN USE</span><span class="showcase-play">▶ <b>Watch the studio reel</b> <small>45 SEC</small></span></div><span class="showcase-caption">SLICEFORGE / ORIGINAL STUDIO SOFTWARE</span></a>
</section>
<div class="discipline-strip"><div class="container"><span>What you can hire us for</span><p><a href="#svc-ux">UX design</a> <b>✳</b> <a href="#svc-ui">UI design</a> <b>✳</b> <a href="#svc-build">Motion + implementation</a></p></div></div>

<section class="section container home-services" id="what-we-do" aria-labelledby="what-we-do-title">
 <div class="section-heading"><div><p class="eyebrow">01 / WHAT WE DO</p><h2 id="what-we-do-title">Three things we do.<br>Hire one, or all three.</h2></div><p>Each card has a 35-second sped-up screen share of the work, so you can see how it is done before we talk.</p></div>
 <div class="hs-grid">{services.map(s => <article class={`hs-card hs-${s.id}`} id={`svc-${s.id}`}>
  <video controls playsinline preload="none" poster={`/media/disciplines/${s.id}-trailer-poster.jpg`} aria-label={`${s.name}: a sped-up screen share of the process`}><source src={`/media/disciplines/${s.id}-trailer.mp4`} type="video/mp4"/></video>
  <p class="eyebrow">{s.num} / {s.name.toUpperCase()}</p><h3>{s.tagline}</h3><p>{s.body}</p>
  <ul>{s.gets.map(g => <li>{g}</li>)}</ul>
  <p class="hs-roles">{s.roles}</p>
  <a class="text-link" href={`/services/#${s.anchor}`} data-track="service_cta" data-track-location={`home-service-${s.id}`}>See {s.name.toLowerCase()} in detail <span>→</span></a>
 </article>)}</div>
 <p class="hs-note">Want to try it first? <a href="/services/#lab">Play the live interface demo ↗</a> · menus, controller navigation, skins and motion, running in the browser.</p>
</section>

<EngagementOptions />

<section class="container home-fit" aria-labelledby="fit-title"><div><p class="eyebrow">WHO IT IS FOR</p><h2 id="fit-title">One senior lead.<br>A team when you need one.</h2><p>Remi owns the interface from the first flow to the last widget. Engineers, artists and production join under the same lead when the scope grows.</p><a class="text-link" href="/services/#fit">More about how we work <span>→</span></a></div>
 <ul><li><strong>Indie and mid-size studios</strong><span>with no dedicated UI designer or UI engineer</span></li><li><strong>Larger teams</strong><span>with a feature, a redesign or a platform port that needs an owner</span></li><li><strong>Product teams</strong><span>apps, tools, sites and training that need design and front end together</span></li></ul></section>

<ProfessionalWorkPreview />
<section class="container career-proof"><p class="eyebrow">EXPERIENCE BEHIND THE STUDIO</p><div><h2>Independent studio.<br>Seasoned perspective.</h2><div><p>Remi Couture’s career spans game interfaces and interactive products, with past client and partner experience including:</p><p class="career-names">Disney · Sony · Riot Games · Tencent · AppLovin</p><small>Founder career and agency experience; these are not presented as direct Strategic Sloth clients.</small><a class="text-link" href="/services/#credits">Meet the founder →</a></div></div></section>
<StudioReel />

<section class="originals-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">PROOF WE SHIP / OUR OWN GAMES &amp; TOOLS</p><h2>We build for ourselves, too.</h2></div><p>The same design and development practice, on our own releases. Developed and published by Strategic Sloth LLC.</p></div><div class="originals-grid"><a href="/tropic-tumble/" data-track="product_click" data-track-product="tropic-tumble"><img src="/media/tropic-tumble/shot-2-scene.webp" alt="Tropic Tumble tropical sticker scene" loading="lazy"/><span class="status">Released · Google Play</span><h3>Tropic Tumble</h3><p>Merge stickers. Collect shiny surprises. Bring your island to life.</p><span class="text-link">Play our latest release →</span></a><a href="https://www.sliceforge.io/" target="_blank" rel="noopener" data-track="product_click" data-track-product="sliceforge"><img src="/studio-images/sf-workspace.webp" alt="SliceForge interface editor" loading="lazy"/><span class="status">Available · Free to start</span><h3>SliceForge</h3><p>Game interfaces you can actually build.</p><span class="text-link">Explore the software ↗</span></a><a href="/products/#focusrail" data-track="product_click" data-track-product="focusrail"><img src="/media/work/focusrail-runtime.webp" alt="Actual Focusrail controller navigation diagnostics in a running menu" loading="lazy"/><span class="status">Available on Fab</span><h3>Focusrail</h3><p>Reliable controller navigation for Unreal Engine.</p><span class="text-link">Discover the plugin →</span></a><a href="/norman-ascension/" class="original-game" data-track="product_click" data-track-product="norman-ascension"><img src="/media/unrevealed-game/world-01-960.webp" alt="Norman Ascension in-engine landscape with wheat fields and hedgerows" loading="lazy"/><span class="status neutral">Original game · In development</span><h3>Norman Ascension</h3><p>An online medieval life and dynasty RPG. Coming to Steam.</p><span class="text-link">Discover the game →</span></a></div><a class="text-link" href="/products/">All software & developer tools →</a></div></section>
<FounderInvite /><section class="container collaborator-home"><div><p class="eyebrow">PEOPLE BEHIND THE WORK</p><h2>Founder-led.<br>Supported by trusted collaborators.</h2><p>Remi leads the project. Engineering, art, design, and delivery specialists join as the scope requires.</p></div><a class="text-link" href="/studio/#collaborators">Meet the people we build with →</a></section>
<section class="contact-band"><div class="container"><div><p class="eyebrow">START A PROJECT</p><h2>Send a screen, a flow or a build.<br>We’ll suggest where to start.</h2></div><a class="button light" href="/contact/" data-track="service_cta" data-track-location="home-footer">Tell us about your project <span>↗</span></a></div></section>
</StudioLayout>
<style>
.discipline-strip a{color:var(--ink);text-decoration:underline;text-decoration-color:#b8c0ad;text-underline-offset:5px}.discipline-strip a:hover{text-decoration-color:var(--ink)}
.home-services .hs-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
.hs-card{--acc:#6b4fd8;--acc-bg:#eeeaf8;display:flex;flex-direction:column;padding:16px 16px 26px;border-radius:12px;background:var(--acc-bg);border:1px solid color-mix(in srgb,var(--acc) 22%,transparent);border-top:5px solid var(--acc);scroll-margin-top:110px}
.hs-ui{--acc:#c2413a;--acc-bg:#f7e9e5}.hs-build{--acc:#1f6f8b;--acc-bg:#e3eef1}
.hs-card video{display:block;width:100%;aspect-ratio:16/9;border-radius:8px;background:#111a16;margin-bottom:22px}
.hs-card .eyebrow,.hs-card h3,.hs-card>p,.hs-card ul,.hs-card .text-link{margin-inline:10px}
.hs-card .eyebrow{color:var(--acc);font-size:10px;margin-bottom:10px}
.hs-card h3{font-size:30px;margin-bottom:12px}
.hs-card>p{font-size:14px;line-height:1.75}
.hs-card ul{list-style:none;padding:0;margin-block:18px;display:grid;gap:8px}
.hs-card li{font-size:13px;color:var(--ink);padding-left:22px;position:relative}
.hs-card li::before{content:'✳';position:absolute;left:0;color:var(--acc)}
.hs-card .hs-roles{font-size:12px;color:var(--ink);border-top:1px solid color-mix(in srgb,var(--acc) 22%,transparent);padding-top:14px;margin-top:auto}
.hs-card .text-link{color:var(--acc);margin-top:6px;font-size:13px}
.hs-note{font-size:13px;margin-top:26px}.hs-note a{color:var(--ink);font-weight:600;text-decoration:underline;text-underline-offset:4px}
.home-fit{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;padding-block:60px;border-top:1px solid var(--line)}
.home-fit h2{font-size:38px;margin-bottom:18px}.home-fit p:not(.eyebrow){font-size:14px;margin-bottom:14px}
.home-fit ul{list-style:none;padding:0;margin:0;display:grid;gap:0}
.home-fit li{display:grid;gap:4px;padding:18px 0;border-top:1px solid var(--line)}.home-fit li:last-child{border-bottom:1px solid var(--line)}
.home-fit strong{font-family:Manrope,sans-serif;font-size:19px;font-weight:600;letter-spacing:-.02em}.home-fit span{font-size:13px;color:var(--muted)}
@media(max-width:1000px){.home-services .hs-grid{grid-template-columns:1fr;max-width:640px}}
@media(max-width:800px){.home-fit{grid-template-columns:1fr;gap:28px;padding-block:45px}.home-fit h2{font-size:32px}}
</style>
