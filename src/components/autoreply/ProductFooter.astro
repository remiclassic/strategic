---
import { autoCopy, autoPaths, type AutoLocale } from '../../data/whatsapp-autoreply';
import { localeChoices, siteCopy } from '../../data/whatsapp-autoreply-site';

const { loc } = Astro.props as { loc: AutoLocale };
const s = siteCopy[loc];
const t = autoCopy[loc];
const paths = autoPaths(loc);
const studio = { es: 'El estudio', en: 'The studio', fr: 'Le studio', 'en-CA': 'The studio' }[loc];
const privacyChoices = { es: 'Opciones de privacidad', en: 'Privacy choices', fr: 'Choix de confidentialité', 'en-CA': 'Privacy choices' }[loc];
---
<footer class="p-footer">
  <div class="p-wrap">
    <div class="p-footer-grid">
      <div>
        <a class="p-brand" href={paths.page}>
          <span class="p-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M5 4h14a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-7.6L7 21.4V18H5a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3Zm6.2 3.2-3 5.1h2.6l-.8 3.5 3.9-5.6h-2.7l1.4-3Z"/></svg></span>
          <span><b>{s.product}</b><small>{s.by}</small></span>
        </a>
        <p>{s.footerTag}</p>
      </div>
      <nav aria-label={s.product}>
        <h2>{s.product}</h2>
        <ul>
          <li><a href="#how">{s.nav.how}</a></li>
          <li><a href="#video">{s.nav.demo}</a></li>
          <li><a href="#plans">{s.nav.pricing}</a></li>
          <li><a href="#faq">{s.nav.faq}</a></li>
        </ul>
      </nav>
      <nav aria-label={s.otherRegion}>
        <h2>{s.otherRegion}</h2>
        <ul>
          {localeChoices.map(c => <li><a href={autoPaths(c.loc).page} lang={c.lang} aria-current={c.loc === loc ? 'page' : undefined}>{c.label} · {c.region}</a></li>)}
        </ul>
      </nav>
      <nav aria-label={studio}>
        <h2>{studio}</h2>
        <ul>
          <li><a href={paths.terms}>{t.legalTerms}</a></li>
          <li><a href={paths.privacy}>{t.legalPrivacy}</a></li>
          <li><a href="/">strategicsloth.com</a></li>
          <li><a href="/remi-couture/">Rémi Couture</a></li>
        </ul>
      </nav>
    </div>
    <div class="p-footer-bottom">
      <span>© {new Date().getFullYear()} Strategic Sloth LLC</span>
      <button type="button" data-privacy-settings>{privacyChoices}</button>
    </div>
  </div>
</footer>
