	{
		icon: '🔓',
		title: 'Advanced Banking Strategies',
		subtitle: 'When traditional banks say no',
		desc: 'Learn what to do when you get deplatformed, rejected, or flagged. The alternative pathways exist. Most people just never look for them.'
	},
	{
		icon: '🛡️',
		title: 'Asset Protection Playbook',
		subtitle: 'Protect wealth across jurisdictions',
