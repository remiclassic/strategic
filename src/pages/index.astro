---
import ProfessionalWorkPreview from '../components/ProfessionalWorkPreview.astro';
import StudioLayout from '../layouts/StudioLayout.astro';
import WorkPreview from '../components/WorkPreview.astro';
import StudioReel from '../components/StudioReel.astro';
import FounderInvite from '../components/FounderInvite.astro';
import EngagementOptions from '../components/EngagementOptions.astro';
---
<StudioLayout title="Design, development & publishing — Strategic Sloth" description="An independent creative development studio. Hire Strategic Sloth for game UI, digital products, and interactive experiences, or explore our original software and games.">
<section class="studio-hero container">
 <div class="studio-hero-top"><p class="eyebrow"><span class="live-dot"></span> INDEPENDENT DESIGN, DEVELOPMENT & PUBLISHING</p><span class="hero-coordinate">FOUNDER-LED / BUILT WITH INTENTION</span></div>
 <div class="studio-hero-copy"><h1>We design it.<br>We build it.<br><span>We bring it to life.</span></h1><div><p class="lede">Game UI, digital products, and interactive experiences. From the first idea to working software.</p><div class="hero-actions"><a class="button" href="/contact/" data-track="service_cta" data-track-location="hero">Hire the studio <span>↗</span></a><a class="text-link" href="/work/" data-track="project_view">Explore our work <span>→</span></a></div><p class="hero-footnote">Nearly 20 years of experience. One connected creative practice.</p></div></div>
 <a class="hero-showcase" href="#studio-reel" aria-label="Watch the Strategic Sloth studio reel"><img src="/studio-images/sf-compose.webp" alt="An editable fantasy game interface inside the SliceForge editor" width="1536" height="1024" fetchpriority="high"/><div class="showcase-overlay"><span>FROM CONCEPT TO SOMETHING YOU CAN USE</span><span class="showcase-play">▶ <b>Watch the studio reel</b> <small>45 SEC</small></span></div><span class="showcase-caption">SLICEFORGE / ORIGINAL STUDIO SOFTWARE</span></a>
</section>
<div class="discipline-strip"><div class="container"><span>Small studio. Full-picture thinking.</span><p>Game UI & UX <b>✳</b> Product design <b>✳</b> Creative development</p></div></div>
<section class="container studio-paths" aria-label="Explore Strategic Sloth"><a href="/services/" data-track="service_cta" data-track-location="home-path"><span class="eyebrow">01 / HIRE US</span><h2>Your next idea.<br>Our kind of challenge.</h2><p>Design, prototype, and develop your next product.</p><span class="text-link">Explore services ↗</span></a><a href="/products/" data-track="product_click" data-track-location="home-path"><span class="eyebrow">02 / MADE BY US</span><h2>Tools for makers.<br>Worlds for players.</h2><p>Original software, developer tools, and games.</p><span class="text-link">Discover our creations ↗</span></a></section>
<ProfessionalWorkPreview />
<section class="container services-invite"><div><p class="eyebrow">DESIGN THROUGH IMPLEMENTATION</p><h2>Try the interface.<br>See how it is built.</h2><p>The live lab demonstrates menu flow, controller navigation, skins, and motion. Explore the studio’s services and the engineering behind the experience.</p><a class="button" href="/services/#lab" data-track="service_cta" data-track-location="home-demo">Play the live demo ↗</a></div><a href="/services/#lab" aria-label="Play the interactive Services demo"><img src="/media/services/reel-poster.jpg" alt="Preview of the Services showreel; follow the link to try the live interface" loading="lazy"/></a></section>
<WorkPreview />
<section class="container career-proof"><p class="eyebrow">EXPERIENCE BEHIND THE STUDIO</p><div><h2>Independent studio.<br>Seasoned perspective.</h2><div><p>Remi Couture’s career spans game interfaces and interactive products, with past client and partner experience including:</p><p class="career-names">Disney · Sony · Riot Games · Tencent · AppLovin</p><small>Founder career and agency experience; these are not presented as direct Strategic Sloth clients.</small><a class="text-link" href="/services/#credits">Meet the founder →</a></div></div></section>
<StudioReel />
<EngagementOptions />
<section class="originals-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">ORIGINALS / DEVELOPED BY STRATEGIC SLOTH</p><h2>We build for ourselves, too.</h2></div><p>Our own releases put the same design and development practice to work. Developed and published by Strategic Sloth LLC.</p></div><div class="originals-trailers"><figure><video controls playsinline preload="none" poster="/media/tropic-tumble/trailer-poster.webp" aria-label="Tropic Tumble trailer"><source src="/media/tropic-tumble/trailer.mp4" type="video/mp4"/><a href="/media/tropic-tumble/trailer.mp4">Watch the Tropic Tumble trailer</a></video><figcaption><a class="text-link" href="/tropic-tumble/" data-track="product_click" data-track-product="tropic-tumble">Tropic Tumble · Released on Google Play →</a></figcaption></figure><figure><video controls playsinline preload="none" poster="/media/runefjord/trailer-poster.webp" aria-label="Runefjord trailer"><source src="/media/runefjord/trailer.mp4" type="video/mp4"/><a href="/media/runefjord/trailer.mp4">Watch the Runefjord trailer</a></video><figcaption><a class="text-link" href="/runefjord/" data-track="product_click" data-track-product="runefjord">Runefjord · In testing, coming to Google Play →</a></figcaption></figure></div><div class="originals-grid"><a href="/tropic-tumble/" data-track="product_click" data-track-product="tropic-tumble"><img src="/media/tropic-tumble/shot-2-scene.webp" alt="Tropic Tumble tropical sticker scene" loading="lazy"/><span class="status">Released · Google Play</span><h3>Tropic Tumble</h3><p>Merge stickers. Collect shiny surprises. Bring your island to life.</p><span class="text-link">Play our latest release →</span></a><a href="https://www.sliceforge.io/" target="_blank" rel="noopener" data-track="product_click" data-track-product="sliceforge"><img src="/studio-images/sf-workspace.webp" alt="SliceForge interface editor" loading="lazy"/><span class="status">Available · Free to start</span><h3>SliceForge</h3><p>Game interfaces you can actually build.</p><span class="text-link">Explore the software ↗</span></a><a href="/products/#focusrail" data-track="product_click" data-track-product="focusrail"><img src="/media/work/focusrail-runtime.webp" alt="Actual Focusrail controller navigation diagnostics in a running menu" loading="lazy"/><span class="status">Available on Fab</span><h3>Focusrail</h3><p>Reliable controller navigation for Unreal Engine.</p><span class="text-link">Discover the plugin →</span></a><a href="/norman-ascension/" class="original-game" data-track="product_click" data-track-product="norman-ascension"><img src="/media/unrevealed-game/world-01-960.webp" alt="Norman Ascension in-engine landscape with wheat fields and hedgerows" loading="lazy"/><span class="status neutral">Original game · In development</span><h3>Norman Ascension</h3><p>An online medieval life and dynasty RPG. Coming to Steam.</p><span class="text-link">Discover the game →</span></a></div><a class="text-link" href="/products/">All software & developer tools →</a></div></section>
<FounderInvite /><section class="container collaborator-home"><div><p class="eyebrow">PEOPLE BEHIND THE WORK</p><h2>Founder-led.<br>Supported by trusted collaborators.</h2><p>Remi leads the project. Engineering, art, design, and delivery specialists join as the scope requires.</p></div><a class="text-link" href="/studio/#collaborators">Meet the people we build with →</a></section>
<section class="contact-band"><div class="container"><div><p class="eyebrow">LET’S MAKE SOMETHING THAT WORKS</p><h2>Bring the idea.<br>Let’s find the next step.</h2></div><a class="button light" href="/contact/" data-track="service_cta" data-track-location="home-footer">Tell us about your project <span>↗</span></a></div></section>
</StudioLayout>
<style>.originals-trailers{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:34px}.originals-trailers figure{margin:0}.originals-trailers video{display:block;width:100%;aspect-ratio:16/9;border-radius:14px;border:1px solid var(--line);background:#111}.originals-trailers figcaption{margin-top:12px;font-size:13px}@media(max-width:800px){.originals-trailers{grid-template-columns:1fr}}</style>
