---
import '../../styles/services.css';
import StudioLayout from '../../layouts/StudioLayout.astro';
import UILab from '../../components/services/UILab.astro';
import CodeBlock from '../../components/services/CodeBlock.astro';
import WorkCard from '../../components/services/WorkCard.astro';
import ServicesScripts from '../../components/services/ServicesScripts.astro';
import Insights from '../../components/services/Insights.astro';
import Team from '../../components/services/Team.astro';
import Credits from '../../components/services/Credits.astro';
import PortfolioSections from '../../components/services/PortfolioSections.astro';
import { conceptRows, tracks, disciplines, codev, engines, healthBarNote, work, directions, process, offers, faqs } from '../../data/services';
---
<StudioLayout services title="UI/UX design and development for games, apps and the web — Strategic Sloth" description="UI/UX design, motion and implementation for games, apps, websites and training products, built in Unreal Engine, Unity, Godot, PlayCanvas and on the web. Led by Guillaume “Remi” Couture, with 20 years of shipped credits.">
  <section class="sv-hero2">
    <video class="sv-hero2-bg" muted loop playsinline autoplay preload="metadata" poster="/media/services/reel-poster.jpg" data-reel aria-hidden="true" tabindex="-1"><source src="/media/services/reel.mp4" type="video/mp4"/></video>
    <div class="sv-hero2-shade" aria-hidden="true"></div>
    <div class="sv-hero container">
      <p class="eyebrow"><span class="live-dot"></span> UI/UX design &amp; development · games, apps, sites, courses</p><h1>Interfaces, designed and<br><em>built where they run.</em></h1>
      <div class="sv-hero-top">
        <p class="lede">A design and development partner from the first wireframe to the code in your repository. UX, UI art, motion and the engineering behind it, for games, apps, websites and training products.</p><div class="hero-actions"><a class="button" href="/contact/?engagement=prototype#enquiry" data-track="cta_click" data-track-location="services_hero">Start a project <span>↗</span></a><a class="button ghost" href="#lab">Play the demo <span>↓</span></a></div>
      </div>
      <div class="sv-hero2-foot"><div class="sv-chips" aria-label="Engines">{engines.map(e => <a href={`/services/${e.slug}/`}>{e.name}</a>)}</div><p class="sv-reel-note"><button type="button" data-reel-toggle aria-pressed="false">Pause reel</button> Showreel · real footage from our games, tools and motion work</p></div>
    </div>
  </section>
  <div class="sv-marquee" aria-hidden="true"><div>{[0, 1].map(() => <span>UX strategy <b>✳</b> UI art <b>✳</b> Design systems <b>✳</b> Motion <b>✳</b> Technical UI <b>✳</b> Unreal Engine <b>✳</b> Unity <b>✳</b> Godot <b>✳</b> PlayCanvas <b>✳</b> Web &amp; custom engines <b>✳</b> Apps &amp; tools <b>✳</b> Websites <b>✳</b> Courses &amp; training <b>✳</b> </span>)}</div></div>

  <section class="sv-stage container" id="lab" aria-labelledby="lab-title">
    <div class="sv-stage-label"><h2 id="lab-title">This is not a reel. It is the interface, running.</h2><p>Switch screens, change the skin, use a keyboard or plug in a gamepad. This one is a game HUD; apps and sites get the same care.</p></div>
    <UILab />
  </section>

  <section class="section container" id="build"><div class="section-heading"><div><p class="eyebrow">What we build</p><h2>Four kinds of product.<br>One way of working.</h2></div><p>Games are where the craft was learned. The same team designs and builds apps, sites and courses.</p></div>
    <div class="sv-codev sv-tracks sv-reveal">{tracks.map((t, i) => <article><span class="num">0{i + 1}</span><h3>{t.title}</h3><p>{t.body}</p><ul>{t.links.map(([label, href]) => <li><a class="pf-link" href={href}>{label} →</a></li>)}</ul></article>)}</div>
  </section>

  <Credits part="top" />

  <section class="section container sv-fit" id="fit">
    <div class="sv-fit-copy sv-reveal"><p class="eyebrow">Who this is for</p><h2>A senior lead.<br>A team when you need one.</h2>
      <p class="big">Every project is led by one senior person who owns the interface from the first flow to the last widget. When the work grows past that, engineers, artists and production join under the same lead, so the scope can scale without you managing a new vendor.</p>
      <ul><li><strong>Indie and mid-size teams</strong><span>with no dedicated UI designer or UI engineer</span></li><li><strong>Larger teams</strong><span>with a feature, a redesign or a platform port that needs an owner</span></li><li><strong>Complete products</strong><span>games, apps, sites and courses that need design, front end and back end delivered together</span></li></ul>
      <p class="fine">Founder-led. Team size follows the scope, from a solo UI pass to a full product team.</p></div>
    <figure class="sv-founder sv-reveal"><img src="/studio-images/remi-founder.png" alt="Guillaume “Remi” Couture, founder of Strategic Sloth, in his studio" loading="lazy" width="1051" height="1497"/><figcaption><strong>Guillaume “Remi” Couture</strong><span>Founder · UX/UI director · technical UI</span><span>Formerly UX Director at AppLovin, Art Director at Sprung Studios, UX/UI at Piranha Games, Phoenix Labs and Offworld</span><a href="https://www.linkedin.com/in/remicouture/" target="_blank" rel="noopener">LinkedIn ↗</a></figcaption></figure>
  </section>

  <Team />

  <section class="section container" id="services"><div class="section-heading"><div><p class="eyebrow">01 / What we do</p><h2>Four disciplines.<br>One accountable studio.</h2></div><p>Take the whole pipeline or the part you are missing. Each piece is built to hand over cleanly to the next.</p></div>
    <div class="sv-svc">{disciplines.map((d, i) => <article class:list={['sv-svc-row', 'sv-reveal', i % 2 === 1 && 'flip']} id={d.id}>
      <div class="sv-svc-copy"><span class="num">{d.index}</span><h3>{d.title}</h3><p class="lead">{d.lead}</p><p>{d.body}</p><ul>{d.items.map(([title, note]) => <li><strong>{title}</strong><span>{note}</span></li>)}</ul></div>
      <figure class="sv-svc-media sv-slides" data-slides aria-roledescription="carousel" aria-label={`${d.title} examples`}>
        {d.slides.map((slide, n) => <div class:list={['sv-slide', n === 0 && 'is-on']} data-caption={slide.caption}>{'video' in slide ? <video muted loop playsinline preload="none" poster={slide.poster} aria-label={slide.alt}><source src={slide.video} type="video/mp4"/></video> : <img src={n === 0 ? slide.image : undefined} data-src={n === 0 ? undefined : slide.image} alt={slide.alt} loading="lazy"/>}</div>)}
        <div class="sv-slide-bar" aria-hidden="true">{d.slides.map(() => <i></i>)}</div>
        <figcaption><span data-slide-caption>{d.slides[0].caption}</span><b data-slide-count>01 / {String(d.slides.length).padStart(2, '0')}</b></figcaption>
        <div class="sv-slide-nav"><button type="button" data-slide-prev aria-label="Previous example">←</button><button type="button" data-slide-next aria-label="Next example">→</button></div>
      </figure>
    </article>)}</div>
  </section>

  <section class="section container" id="codev"><div class="section-heading"><div><p class="eyebrow">Co-development</p><h2>Part of your team,<br>not a vendor queue.</h2></div><p>Embedded for a sprint or for a whole production. The work lands where your team already works.</p></div>
    <div class="sv-codev sv-reveal">{codev.map(([title, body], i) => <article><span class="num">0{i + 1}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
  </section>

  <section class="section container" id="engines"><div class="section-heading"><div><p class="eyebrow">02 / Implementation</p><h2>One design system.<br>Five runtimes.</h2></div><p>{healthBarNote}</p></div>
    <div class="sv-engines sv-reveal">
      <div class="sv-engine-list" role="tablist" aria-label="Engine">{engines.map((e, i) => <button type="button" role="tab" id={`tab-${e.slug}`} aria-controls={`panel-${e.slug}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}><strong>{e.name}</strong><small>{e.stack.slice(0, 3).join(' · ')}</small><i>{e.proofLabel}</i></button>)}</div>
      <div>{engines.map((e, i) => <div class="sv-engine-panel" role="tabpanel" id={`panel-${e.slug}`} aria-labelledby={`tab-${e.slug}`} hidden={i !== 0}><CodeBlock engine={e}/><p>{e.summary}</p><a class="text-link" href={`/services/${e.slug}/`}>How we work in {e.name} <span aria-hidden="true">→</span></a></div>)}</div>
    </div>
  </section>

  <section class="section container" id="work"><div class="section-heading"><div><p class="eyebrow">03 / Real builds</p><h2>Footage from things<br>that actually run.</h2></div><p>Every tile is labelled with what it is: recorded gameplay, an app recording, an editor capture, or a product screenshot. No mock-ups dressed as shipped products.</p></div>
    <div class="sv-work">{work.map(item => <WorkCard item={item}/>)}</div>
    <p class="sv-work-foot">These are our own games, apps, tools and plugins, and training simulations we designed and built. Studio credits and concept work follow.</p>
  </section>

  <section class="section container" id="case-study"><a class="sv-case sv-reveal" href="/services/case/vanguard/"><div class="sv-case-copy"><p class="eyebrow">Featured case study</p><h2>From an unclear screen<br>to a working flow.</h2><p>Vanguard: a design critique, four-step flow, three screens and a React prototype you can play, with the test plan we would run before implementation.</p><span class="button">Read the case study <span>→</span></span></div><div class="sv-case-media"><img src="/media/services/portfolio/vanguard-loadout.webp" alt="Loadout comparison screen from the Vanguard study" loading="lazy"/><img src="/media/services/portfolio/vanguard-class.webp" alt="Class selection screen from the Vanguard study" loading="lazy"/></div></a></section>

  <Credits part="credits" />

  <PortfolioSections start={4} />

  <section class="section container" id="directions"><div class="section-heading"><div><p class="eyebrow">09 / Visual range</p><h2>Any genre.<br>Any art direction.</h2></div><p>Ten complete UI directions designed in 2026, from tactical shooter to cosy farm. Concept studies from our UI collections, not footage of released games.</p></div>
  </section>
  <div class="sv-film" aria-label="Screens from our UI concept collections">{conceptRows.map((row, r) => <div class:list={['sv-film-row', r === 1 && 'reverse']}><div>{[0, 1].map(copy => row.map(item => <a href={`/game-ui/${item.slug}/`} tabindex={copy === 1 ? -1 : undefined} aria-hidden={copy === 1 ? 'true' : undefined}><img src={item.src} alt={copy === 0 ? `${item.label} concept screen` : ''} loading="lazy" width="1600" height="1000"/><span>{item.label}</span></a>))}</div></div>)}</div>
  <section class="container sv-film-foot"><p class="sv-work-foot">Twenty screens from ten complete UI collections, each a full set of menus, HUD, inventory and settings. <a class="pf-link" href="/#game-ui-packs">Browse the collections →</a></p>
  </section>

  <section class="section container" id="process"><div class="section-heading"><div><p class="eyebrow">10 / Process</p><h2>From a rough build<br>to a shipped screen.</h2></div><p>Each step ends with something you can review. Skip the ones you have already done.</p></div>
    <ol class="sv-process sv-reveal">{process.map(([title, body, output]) => <li><h3>{title}</h3><p>{body}</p><small>→ {output}</small></li>)}</ol>
  </section>

  <Insights part="audit" />

  <Insights part="talks" />

  <Credits part="quotes" />

  <section class="section container" id="engage"><div class="section-heading"><div><p class="eyebrow">11 / Ways to start</p><h2>Start small.<br>Scale when it works.</h2></div><p>Durations are typical, not fixed. Every engagement begins with a written scope and a price.</p></div>
    <div class="sv-offers sv-reveal">{offers.map((o, i) => <article><div class="top"><span>0{i + 1} / {o.title}</span><span>{o.span}</span></div><h3>{o.lead}</h3><p>{o.body}</p><ul>{o.outputs.map(t => <li>{t}</li>)}</ul><a class:list={['button', i !== 1 && 'ghost']} href={`/contact/?engagement=${o.id}#enquiry`} data-track="cta_click" data-track-location={`services_offer_${o.id}`}>Discuss this <span>↗</span></a></article>)}</div>
  </section>

  <section class="section container" id="faq"><div class="sv-faq"><div><p class="eyebrow">12 / Questions</p><h2>Before we talk.</h2></div><div>{faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>

  <section class="sv-cta"><div class="container"><p class="eyebrow">Next opening on request</p><h2>Show us the build.</h2><p>Send a screenshot, a recording or a build, with your engine or stack and your dates. You will get a straight answer on fit and scope.</p><div class="hero-actions"><a class="button" href="/contact/?engagement=review#enquiry" data-track="cta_click" data-track-location="services_footer">Start a conversation <span>↗</span></a><a class="button ghost" href="/work/">More work &amp; process <span>→</span></a></div></div></section>
  <ServicesScripts />
</StudioLayout>

<script>
  const tabs = [...document.querySelectorAll<HTMLElement>('.sv-engine-list [role=tab]')];
  const select = (tab: HTMLElement, focus = false) => {
    tabs.forEach(t => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    });
    if (focus) tab.focus();
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', e => {
      const step = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
      if (step) { e.preventDefault(); select(tabs[(i + step + tabs.length) % tabs.length], true); }
    });
  });
  const reel = document.querySelector<HTMLVideoElement>('[data-reel]');
  const reelToggle = document.querySelector<HTMLButtonElement>('[data-reel-toggle]');
  if (reel && reelToggle) {
    const setPaused = (paused: boolean) => {
      if (paused) reel.pause(); else reel.play().catch(() => {});
      reelToggle.setAttribute('aria-pressed', String(paused));
      reelToggle.textContent = paused ? 'Play reel' : 'Pause reel';
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) setPaused(true);
    reelToggle.addEventListener('click', () => setPaused(!reel.paused));
  }
</script>
