---
import { cases } from '../data/services-portfolio';
const selected = ['mechwarrior', 'cards', 'tactical'].map(id => cases.find(item => item.id === id)!);
---
<section class="section container professional-work" aria-labelledby="professional-work-title">
 <div class="section-heading"><div><p class="eyebrow">SELECTED PROFESSIONAL WORK / FOUNDER CAREER</p><h2 id="professional-work-title">Experience you can see.<br>Work you can inspect.</h2></div><a class="text-link" href="/services/#portfolio" data-track="project_view">Explore the career portfolio →</a></div>
 <div class="work-preview-grid">{selected.map(item => <a href={`/services/#case-${item.id}`} data-track="project_view" data-track-location="professional-work"><img src={item.shots[0].src} alt={item.shots[0].alt} loading="lazy"/><span>{item.origin}</span><h3>{item.title}</h3><p>{item.body}</p><span class="text-link">Inspect the screens & contribution →</span></a>)}</div>
 <p class="filter-note">Remi Couture’s career and agency work. These credits do not imply direct Strategic Sloth client relationships or endorsement.</p>
</section>
<style>.work-preview-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.work-preview-grid>a{display:block}.work-preview-grid img{width:100%;aspect-ratio:16/10;object-fit:cover;border:1px solid var(--line);border-radius:12px;margin-bottom:22px}.work-preview-grid span:not(.text-link){font-size:10px;letter-spacing:.05em;color:var(--muted);line-height:1.7;display:block}.work-preview-grid h3{font-size:25px;margin:10px 0}.work-preview-grid p{font-size:14px}.work-preview-grid .text-link{font-size:12px;margin-top:18px}.work-preview-grid a:hover h3{text-decoration:underline;text-underline-offset:5px}@media(max-width:800px){.work-preview-grid{grid-template-columns:1fr;gap:35px}}</style>
