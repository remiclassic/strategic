---
import StudioLayout from '../layouts/StudioLayout.astro';
import '../styles/training.css';
import {
	bookHref, isCalendar, CONTACT_EMAIL, PORTFOLIO_URL, LINKEDIN_URL,
	proof, showcase, workFacts, workLead, workShots, prototypes, capabilities,
} from '../data/training';

const external = isCalendar() ? { target: '_blank', rel: 'noopener' } : {};
const demo = bookHref('Training and simulation project');
const portfolioShowcase = showcase.filter((item) => item.id === 'tools');
const artClass: Record<string, string> = { range: '', minigames: 'lilac', tools: 'peach' };
---
<StudioLayout
	title="Training & simulation interfaces | Strategic Sloth"
	description="Strategic Sloth designs and builds training interfaces, interactive simulations, and security minigames. Explore the demos and discuss your project."
>
<div class="tr">

<section class="container tr-hero" aria-labelledby="tr-title">
	<div>
		<p class="eyebrow">STRATEGIC SLOTH · TRAINING &amp; SIMULATION</p>
		<h1 id="tr-title">Make the next step clear.<br />Make practice playable.</h1>
		<p class="lede">Strategic Sloth brings game interface craft to cyber training and simulation. We build learner journeys, mission interfaces, and playable practice that turn complex tasks into clear decisions.</p>
		<div class="hero-actions">
			<a class="button" href={demo} {...external}>Discuss your project <span aria-hidden="true">↗</span></a>
			<a class="text-link" href="#selected-work">Explore the demos ↓</a>
		</div>
		<p class="tr-hero-note">UI / UX design · Interactive prototyping · Unreal UMG &amp; CommonUI</p>

	</div>
<div class="tr-studio-intro"><p class="eyebrow">FROM FIRST LOGIN TO FIRST ACTIVITY</p><ol><li><b>01 / Find your path</b><span>Onboarding and learning journeys</span></li><li><b>02 / Understand the mission</b><span>Briefings, objectives, and feedback</span></li><li><b>03 / Learn by doing</b><span>Playable practice and simulation</span></li></ol><a class="text-link" href="#minigame-example">Try a playable example ↓</a></div>
</section>

<section class="container" aria-label="Experience">
	<div class="tr-proof">
		{proof.map((p) => <div><strong>{p.title}</strong><span>{p.detail}</span></div>)}
	</div>
</section>

<section class="section container compact" id="selected-work" aria-labelledby="work-title">
	<div class="section-heading">
		<div><p class="eyebrow">SELECTED WORK</p><h2 id="work-title">A first-time experience for a gamified cyber range.</h2></div>
		<p>Onboarding, learning paths, and mission entry. Portfolio examples use sample content and neutral branding.</p>
	</div>
	<div class="tr-case-context">
        <div><p class="eyebrow">THE PROBLEM</p><p>How does a new learner get from choosing a training path to understanding—and starting—the next activity?</p></div>
        <div><p class="eyebrow">DESIGN APPROACH</p><p>Learner flow, interface design, and interactive prototyping: compare onboarding directions, make module status clear, and connect the map to the briefing.</p></div>
        <div><p class="eyebrow">WHAT TO EXPLORE</p><p>Try the animated globe and location zoom, then compare the path selection and onboarding flows below. These are design prototypes with sample progress.</p></div>
    </div>
	<figure class="tr-work-lead">
		<div class="tr-proto-frame tr-work-interactive">
			<iframe data-src="/training/live-globe/demo.html" title="Cyber range — live animated globe and location demo" allow="fullscreen"></iframe>
			<img src={workLead.src} alt={workLead.alt} width="1600" height="900" loading="lazy" />
			<div class="tr-demo-cover"><button class="button tr-demo-start" type="button">Load and play the globe <span aria-hidden="true">→</span></button></div>
			<p class="tr-demo-loading" role="status" hidden>Loading the animated globe…</p>
		</div>
		<figcaption>
			<p>{workLead.caption} Explore the spinning globe, select a module, and zoom into its location.</p>
			<div class="tr-work-actions">
				<a href="/training/live-globe/demo.html" target="_blank" rel="noopener">Open full screen ↗</a>
				<a href="/training/proto/globe/01-choose.html" target="_blank" rel="noopener">Start the walkthrough ↗</a>
			</div>
		</figcaption>
	</figure>
	<div class="tr-work-facts">
		{workFacts.map((f) => <div><strong>{f.title}</strong><span>{f.body}</span></div>)}
	</div>

</section>

<section class="section container compact" id="showcase" aria-labelledby="showcase-title">
	<div class="section-heading">
		<div><p class="eyebrow">INTERFACE TOOLING</p><h2 id="showcase-title">From interface design to working tools.</h2></div>
		<p>Playable practice and Unreal tooling you can explore yourself.</p>
	</div>
	<div class="tr-tabs" role="tablist" aria-label="Products">
		{portfolioShowcase.map((s, i) => (
			<button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.tab}</button>
		))}
	</div>
	{portfolioShowcase.map((s) => (
		<article class="tr-panel" id={`panel-${s.id}`} role="tabpanel" aria-labelledby={`tab-${s.id}`}>
			<div class:list={['tr-panel-art', artClass[s.id]]}>
				{s.shots.length > 0 ? (
					<div class="tr-shots">{s.shots.map((shot) => <img src={shot.src} alt={shot.alt} loading="lazy" width="1600" height="900" />)}</div>
				) : s.id === 'range' ? (
					<div class="tr-mission" aria-hidden="true">
						<div class="tr-mission-top"><span>Mission 3</span><span>Blue team · 30 min</span></div>
						<h4>Contain the beacon</h4>
						<p>A workstation is calling out to an unknown host. Find it and cut it off.</p>
						<ol><li class="done"><span></span>Find the beaconing host</li><li class="done"><span></span>Confirm the domain</li><li class="now"><span></span>Isolate the infected host</li><li><span></span>Write the incident note</li></ol>
					</div>
				) : s.id === 'minigames' ? (
					<div class="tr-games" aria-hidden="true">
						<div class="tr-game"><b>Inspect traffic</b><small>Review the evidence</small><i style="--w:80%"></i></div>
						<div class="tr-game"><b>Apply access rules</b><small>Keep services available</small><i style="--w:55%"></i></div>
						<div class="tr-game"><b>Add a backup route</b><small>Recover the connection</small><i style="--w:40%"></i></div>
						<div class="tr-game"><b>Review decisions</b><small>Replay and debrief</small><i style="--w:65%"></i></div>
					</div>
				) : (
					<div class="focus-demo" aria-hidden="true"><div class="demo-top"><span>FOCUSRAIL / UMG</span><span>FOCUS MEMORY</span></div><div class="demo-menu"><span>Mission briefing</span><span class="selected">Network map <b>← Focus restored</b></span><span>Submit report</span></div><div class="demo-bottom">Keyboard and controller, one focus model.</div></div>
				)}
			</div>
			<div class="tr-panel-copy">
				<span class:list={['status', s.id !== 'tools' && 'launch']}>{s.status}</span>
				<h3>{s.name}</h3>
				<p>{s.body}</p>
				{s.id === 'minigames' ? (
					<a class="text-link" href="#minigame-example">Play the example <span aria-hidden="true">↓</span></a>
				) : s.link ? (
					<a class="text-link" href={s.link} target="_blank" rel="noopener">View on Fab <span aria-hidden="true">↗</span></a>
				) : (
					<a class="text-link" href={bookHref(`${s.name} demo`)} {...external}>Discuss this work <span aria-hidden="true">↗</span></a>
				)}
			</div>
		</article>
	))}
</section>

<section class="section container compact" id="minigame-example" aria-labelledby="minigame-title">
	<div class="section-heading">
		<div><p class="eyebrow">PLAYABLE MINIGAME</p><h2 id="minigame-title">Keep Finance Online</h2></div>
		<p>Protect the network while keeping essential services available.</p>
	</div>
	<div class="tr-playable">
		<div class="tr-playable-intro" id="game-intro">
			<div class="tr-game-preview">
				<img src="/training/work/network-defense-game.webp" alt="Network Defense gameplay: an isometric network with a gateway, inspection point, core server, and Finance connection to restore." width="1600" height="1000" loading="lazy" />
				<span class="tr-preview-badge">ACTUAL GAMEPLAY</span>
				<div class="tr-preview-signal" aria-hidden="true"><span>●</span> FINANCE OFFLINE · YOUR MOVE</div>
			</div>
			<div class="tr-game-invitation">
			<span class="status launch">Playable prototype · About 5 minutes</span>
			<h3>The network is yours.<br />Keep it online.</h3>
			<p>Finance is offline. Traffic is coming in. Can you restore the connection without letting a threat through?</p>
			<button class="button" type="button" id="play-network-defense"><span class="tr-play-icon" aria-hidden="true">▶</span> Play the example</button>
			<small class="tr-game-note">3 rounds · No sign-up · Play in your browser</small>
			<div class="tr-preview-actions" role="group" aria-label="Explore the game mechanics">
				<button type="button" aria-pressed="true" data-preview-detail="Inspect traffic to uncover evidence. You decide what belongs on the network.">01 Inspect</button>
				<button type="button" aria-pressed="false" data-preview-detail="Configure access rules to stop prohibited activity while keeping essential services available.">02 Protect</button>
				<button type="button" aria-pressed="false" data-preview-detail="Build a backup route when a link fails, then replay your decisions in the debrief.">03 Recover</button>
			</div>
			<p class="tr-preview-detail" aria-live="polite">Inspect traffic to uncover evidence. You decide what belongs on the network.</p>
			</div>
		</div>
		<iframe id="network-defense-game" title="Keep Finance Online playable example" data-game-src="/training/games/network-defense/index.html" allow="fullscreen" hidden></iframe>
		<p class="tr-demo-loading" role="status" hidden>Loading the game…</p>
	</div>
	<div class="tr-proto-meta">
		<div><strong>Keep Finance Online</strong><span>Beginner cybersecurity practice · Three rounds · Decision replay and debrief</span></div>
		<a class="text-link" href="/training/games/network-defense/index.html" target="_blank" rel="noopener">Open full screen <span aria-hidden="true">↗</span></a>
	</div>
</section>



<section class="section container compact" id="prototypes" aria-labelledby="proto-title">
	<div class="section-heading">
		<div><p class="eyebrow">CLICK-THROUGH PROTOTYPES</p><h2 id="proto-title">Try the flows yourself.</h2></div>
		<p>Working HTML prototypes with sample content. Click the buttons inside the frame to move through each flow.</p>
	</div>
	<div class="tr-tabs tr-proto-tabs" role="tablist" aria-label="Prototypes">
		{prototypes.filter((item) => item.id !== 'globe').map((p, i) => (
			<button type="button" role="tab" id={`ptab-${p.id}`} aria-controls={`proto-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{p.tab}</button>
		))}
	</div>
	{prototypes.filter((item) => item.id !== 'globe').map((p, i) => (
		<article class="tr-proto" id={`proto-${p.id}`} role="tabpanel" aria-labelledby={`ptab-${p.id}`}>
			<div class="tr-proto-frame">
				<iframe data-src={p.src} title={`${p.tab} prototype`} loading="lazy" allow="fullscreen"></iframe>
				<img src={p.poster} alt="" width="1600" height="900" loading="lazy" />
				<div class="tr-demo-cover"><button class="button tr-demo-start" type="button">Load and play {p.tab} <span aria-hidden="true">→</span></button></div>
				<p class="tr-demo-loading" role="status" hidden>Loading {p.tab}…</p>
			</div>
			<div class="tr-proto-meta">
				<div><strong>{p.title}</strong><span>{p.note}</span></div>
				<a class="text-link" href={p.src} target="_blank" rel="noopener">Open full screen <span aria-hidden="true">↗</span></a>
			</div>
		</article>
	))}
</section>

<section class="studio-section" aria-labelledby="cap-title">
	<div class="container tr-capability">
		<div>
			<p class="eyebrow">CAPABILITY</p>
			<h2 id="cap-title">Interfaces built for training.</h2>
			<p>Training platforms serve two people at once: the trainee working through a hard problem, and the instructor keeping a whole cohort moving. Our design approach keeps both in control, from the first screen to the next decision.</p>

		</div>
		<dl>{capabilities.map((c) => <div><dt>{c.title}</dt><dd>{c.body}</dd></div>)}</dl>
	</div>
</section>

<section class="container" style="padding-bottom:100px" aria-labelledby="final-title">
	<div class="contact-panel tr-final">
		<div>
			<p class="eyebrow">LET’S TALK</p>
			<h2 id="final-title">Building a training experience? Let’s talk.</h2>
			<p>Tell us about your learners, platform, and the experience you want to improve. We can discuss interface design, interactive prototyping, or a playable training exercise for your project.</p>
		</div>
		<div class="tr-final-actions">
			<a class="button" href={demo} {...external}>Discuss your project <span aria-hidden="true">↗</span></a>
			<a class="text-link" href={PORTFOLIO_URL} target="_blank" rel="noopener">Meet the designer ↗</a>
			
			<a class="contact-address" href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('[StrategicSloth] Training')}`}>{CONTACT_EMAIL}</a>
		</div>
	</div>
</section>

</div>
</StudioLayout>

<script is:inline>
(() => {
	document.querySelectorAll('[data-preview-detail]').forEach((button) => {
		button.addEventListener('click', () => {
			document.querySelectorAll('[data-preview-detail]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
			document.querySelector('.tr-preview-detail').textContent = button.dataset.previewDetail;
		});
	});
	const game = document.getElementById('network-defense-game');
	const startDemo = (frame, source, cover) => {
		const holder = frame.parentElement;
		const status = holder.querySelector('.tr-demo-loading');
		cover.hidden = true;
		status.hidden = false;
		frame.hidden = false;
		frame.addEventListener('load', () => {
			const started = Date.now();
			const check = () => {
				const globe = frame.contentDocument?.getElementById('globe');
				const ready = !globe || globe.contentDocument?.getElementById('app')?.dataset.ready === 'true';
				if (ready) { status.hidden = true; holder.classList.add('demo-ready'); return; }
				if (Date.now() - started > 120000) { status.textContent = 'Still loading imagery. You can also open the demo full screen below.'; return; }
				setTimeout(check, 250);
			};
			check();
		}, { once: true });
		frame.src = source;
		frame.removeAttribute('data-src');
	};
	document.getElementById('play-network-defense').addEventListener('click', () => {
		startDemo(game, game.dataset.gameSrc, document.getElementById('game-intro'));
		game.focus();
	});
	document.querySelectorAll('.tr-demo-start').forEach((button) => {
		button.addEventListener('click', () => {
			const holder = button.closest('.tr-proto-frame');
			const frame = holder.querySelector('iframe');
			startDemo(frame, frame.dataset.src, button.parentElement);
		}, { once: true });
	});
	// 60-second film: custom play button, chapter seeking, and an end card.
	// The prototype delegates course navigation to its embedding host.
	window.addEventListener('message', (event) => {
		if (event.origin !== window.location.origin || event.source !== game.contentWindow) return;
		if (event.data?.type !== 'ares:practice:navigate') return;
		if (event.data.payload?.target === 'study') game.src = game.dataset.gameSrc;
		if (event.data.payload?.target === 'mission') game.contentDocument?.getElementById('go-mission')?.click();
	});
	document.querySelectorAll('.tr-tabs').forEach((list) => {
		const tabs = [...list.querySelectorAll('[role=tab]')];
		const show = (tab, focus) => {
			tabs.forEach((t) => {
				const on = t === tab;
				const panel = document.getElementById(t.getAttribute('aria-controls'));
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				panel.hidden = !on;
			});
			if (focus) tab.focus();
		};
		list.setAttribute('data-ready', '');
		tabs.forEach((t, i) => {
			t.addEventListener('click', () => show(t, false));
			t.addEventListener('keydown', (e) => {
				const n = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
				if (n) { e.preventDefault(); show(tabs[(i + n + tabs.length) % tabs.length], true); }
			});
		});
		const first = tabs[0];
		show(first, false);
	});
})();
</script>


