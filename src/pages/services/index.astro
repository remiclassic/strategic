---
import { breadcrumbSchema } from '../../utils/seo';
import StudioLayout from '../../layouts/StudioLayout.astro';
import PackageCard from '../../components/b/PackageCard.astro';
import CtaBand from '../../components/b/CtaBand.astro';
import { lines, packages, pkg } from '../../data/studio';
import '../../styles/boutique.css';
const lowest = (id: string) => packages.filter(p => p.lines.includes(id) && !p.unit).sort((a, b) => +a.price.replace(/\D/g, '') - +b.price.replace(/\D/g, ''))[0];
---
<StudioLayout title="Game UI, App & Game Development Services | Strategic Sloth" schema={[breadcrumbSchema([["Home", "/"], ["Services", "/services/"]])]} description="Game UI and UX, app development, game development, websites and training. A founder-led studio with published prices.">
<section class="b-intro container">
  <p class="eyebrow">SERVICES</p>
  <h1>Four services. <em>One senior lead.</em></h1>
  <p class="lede">Pick the part you are missing, or hand us the whole thing. Each service has its own page with the work, what you get and what it costs.</p>
</section>
<section class="container b-svc-list">
  {lines.map((l, i) => { const p = lowest(l.id); return (
  <article class:list={['b-split', i % 2 === 1 && 'flip']} style={`--acc:${l.accent}`}>
    <a href={l.slug} aria-label={l.name}><img class="b-media" src={l.media.poster} alt="" loading="lazy"/></a>
    <div>
      <p class="eyebrow" style={`color:${l.accent}`}>0{i + 1} / {l.name.toUpperCase()}</p>
      <h2>{l.tagline}</h2>
      <p class="b-svc-summary">{l.summary}</p>
      <ul class="b-list">{l.deliverables.slice(0, 4).map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}</ul>
      <div class="b-hero-actions"><a class="button" href={l.slug}>{l.name} <span>→</span></a><span class="b-svc-from">From <strong>{p.price}</strong> · {p.name.toLowerCase()}</span></div>
    </div>
  </article>); })}
</section>
<section class="container b-studios"><a href="/services/co-development/"><p class="eyebrow">FOR GAME STUDIOS</p><h2>Need a UI team inside your production?</h2><p>Embedded UI/UX and Unreal UI engineering for studios and co-development partners, in your pipeline and under your NDA. Also in French.</p><span>Co-development for studios →</span></a></section>
<section class="container b-studios b-local"><a href="/local-business/"><p class="eyebrow">FOR LOCAL BUSINESSES</p><h2>Need a site or app for a restaurant, shop or hotel?</h2><p>Custom websites and apps for restaurants, shops, tours, clinics, gyms and hotels. English, French and Spanish. Free quote. Fixed price.</p><span>Local business sites →</span></a></section>
<section class="b-sage b-section tight"><div class="container">
  <div class="b-head"><div><p class="eyebrow">NOT SURE WHERE TO START?</p><h2>Two first steps <em>for anything.</em></h2></div><p>Both work for a game, an app, a site or a course, and their findings carry into a bigger scope.</p></div>
  <div class="b-packages b-packages-2"><PackageCard p={pkg('review')} /><PackageCard p={pkg('audit')} /></div>
  <p style="margin-top:14px"><a class="text-link" href="/services/game-ux-audit/">About the Game UX audit <span>→</span></a></p>
</div></section>
<CtaBand />
<style>.b-studios{margin-block:10px 70px}.b-studios + .b-studios{margin-top:-50px}.b-studios a{display:grid;grid-template-columns:auto 1fr auto;gap:10px 34px;align-items:center;padding:30px 34px;border-radius:14px;background:#0d110e;color:#eef1e6;text-decoration:none}.b-studios .eyebrow{color:#c6f27a;grid-column:1/-1;margin:0}.b-studios h2{font:600 clamp(24px,2.6vw,34px)/1.1 Manrope,sans-serif;letter-spacing:-.04em;margin:0;grid-column:1/3}.b-studios p:not(.eyebrow){color:#a9b0a2;margin:0;grid-column:1/3;max-width:62ch}.b-studios span{grid-column:3;grid-row:2/4;color:#c6f27a;font-weight:600;white-space:nowrap}.b-studios a:hover span{text-decoration:underline}.b-local a{background:#e9edde;color:var(--ink)}.b-local .eyebrow{color:#6b8053}.b-local p:not(.eyebrow){color:#5d665a}.b-local span{color:#6b8053}@media(max-width:700px){.b-studios a{grid-template-columns:1fr}.b-studios h2,.b-studios p:not(.eyebrow),.b-studios span{grid-column:1;grid-row:auto}}</style>
</StudioLayout>
