---
import CheckoutLink from './CheckoutLink.astro';
import { BUNDLE_BONUS_TITLE, BUNDLE_BONUS_DESCRIPTION } from '../data/bundle-bonus';
const titles = ["Don't Do Anything", 'Design Your Exit', 'The Freedom Blueprint', 'Strategic Privacy & Tax Positioning', 'Residency Without Relocation', 'Global Business Jurisdictions Guide', 'Global Banking Systems for Entrepreneurs', 'Advanced Banking Strategies', 'Asset Protection Playbook', 'Ancestral & Birthright Citizenship', 'Investment Citizenship Handbook'];
const tiers = [
{ id: 'starter', name: 'Starter Package', count: 2, price: 17, description: 'Start with making a digital product and planning a transition toward independent work.', url: 'https://strategicsloth.lemonsqueezy.com/checkout/buy/35c6242c-4da1-40a6-8821-dae46243e1fd?embed=1'},
{ id: 'builder', name: 'Builder / Best Value Package', count: 6, price: 47, description: 'Connect the foundation to business structures and international living. Build a more informed list of questions for your plans.', url: 'https://strategicsloth.lemonsqueezy.com/checkout/buy/4a62f69a-6b5d-498c-828e-c9268291a0c5?embed=1'},
{ id: 'scale', name: 'Scale to Freedom', count: 11, price: 97, description: 'Keep all 11 books together, including banking, asset protection, and citizenship topics as your questions become more specialized.', url: 'https://strategicsloth.lemonsqueezy.com/checkout/buy/40c50565-f106-4797-855b-dadd083e3280?embed=1'}
];
---
<section class="page-intro container"><p class="eyebrow">LEARN / FREEDOM LIBRARY</p><h1>Plan your next move.<br/>See how the pieces fit.</h1><p class="lede">11 books on life design, business structures, and international living.<br/>Connect your product idea, business setup, and longer-term plans.</p><div class="hero-actions"><a class="button" href="#packages">Compare the three packages ↓</a><a class="text-link" href="/books/">Looking for creator books? →</a></div><p class="sample-route">See the writing before you choose. <a href="/samples/dont-do-anything/">Read a chapter from Don’t Do Anything</a>, included in every package.</p></section>
<section class="section container" id="packages"><div class="section-heading"><div><p class="eyebrow">CLEAR CONTENTS. ONE-TIME PURCHASES.</p><h2>Choose the questions you want to work through.</h2></div><p>Digital delivery · Self-paced reading<br/>30-day money-back guarantee<br/>Prices in USD · Tax calculated at checkout</p></div><div class="learning-grid">{tiers.map(tier => <article class="learning-card bundle-card" id={tier.id}><img class="library-package-art" src={`/studio-images/library-${tier.id}.webp`} width="720" height="720" alt="" loading="lazy" decoding="async"/><span class="card-number">{tier.count} BOOKS INCLUDED</span><h3>{tier.name}</h3><p>{tier.description}</p><ol>{titles.slice(0,tier.count).map(title => <li>{title}</li>)}</ol><CheckoutLink href={tier.url} price={tier.price} product={`freedom-${tier.id}`} label="Buy package" location={`library-${tier.id}`}/></article>)}</div><div class="learning-note"><strong>Every package includes {BUNDLE_BONUS_TITLE}</strong><p>{BUNDLE_BONUS_DESCRIPTION}</p></div></section>
<section class="learning-shelf"><div class="container section reading-context"><p class="eyebrow">BEFORE YOU READ</p><h2>Build understanding.<br/>Then ask better questions.</h2><p>Start with the foundation if you’re new to independent work. The later books introduce more specialized topics; you don’t need to buy every tier to begin.</p><p>The international material is educational background, not individual legal, tax, investment, or immigration advice. Requirements change by jurisdiction and circumstance. Check current official sources and speak with a qualified professional before making decisions.</p><a class="text-link" href="/blog/">Explore the free article library →</a></div></section>
